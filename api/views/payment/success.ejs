<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful | UPIExpress</title>
    <link rel="icon" href="/images/icon.png" type="image/png">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-777328699"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'AW-777328699');
    </script>

    <!-- Event snippet for Page view conversion page -->
    <script>
        gtag('event', 'conversion', {
            'send_to': 'AW-777328699/bC4-COaV_90ZELuw1PIC',
            'value': '<%= amount %>',
            'currency': 'INR',
            'transaction_id': '<%= txnid %>'
        });
    </script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fafc;
        }

        .success-animation {
            animation: successScale 0.6s ease-out;
        }

        .progress-bar {
            width: 100%;
            height: 4px;
            background-color: #e5e7eb;
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background-color: #10b981;
            width: 100%;
            animation: progressShrink 3s linear forwards;
        }

        @keyframes successScale {
            0% {

                opacity: 0;
            }

            100% {

                opacity: 1;
            }
        }

        @keyframes progressShrink {
            0% {
                width: 100%;
            }

            100% {
                width: 0%;
            }
        }

        .tick-animation {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: drawCheck 0.8s ease-in-out forwards;
            animation-delay: 0.3s;
        }

        @keyframes drawCheck {
            to {
                stroke-dashoffset: 0;
            }
        }
    </style>
</head>

<body class="min-h-screen flex flex-col items-center justify-center p-4">
    <!-- Success Card -->
    <div class="w-full max-w-md bg-white rounded-2xl border border-gray-200 p-8 success-animation">
        <!-- Header Logo -->
        <div class="flex justify-center mb-6">
            <div class="flex items-center space-x-2">
                <div class="flex items-center">
                    <img src="/images/icon.png" alt="UPIExpress" class="w-10 h-10">
                    <span class="font-bold text-xl mr-[2.2px] text-gray-800">UPI</span>
                    <span class="text-xl text-gray-700">Express</span>
                </div>
            </div>
        </div>

        <!-- Success Icon -->
        <div class="flex justify-center mb-8">
            <div class="relative">
                <div class="w-28 h-28 bg-green-50 rounded-full flex items-center justify-center">
                    <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-16 h-16 text-green-600" viewBox="0 0 52 52">
                            <circle cx="26" cy="26" r="25" fill="none" stroke="currentColor" stroke-width="2" />
                            <path class="tick-animation" fill="none" stroke="currentColor" stroke-width="3"
                                stroke-linecap="round" stroke-linejoin="round" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success Message -->
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Payment Successful!</h2>
            <p class="text-gray-600 mb-1">Your transaction has been completed successfully.</p>
            <p class="text-sm text-gray-500">Thank you for using UPIExpress</p>
        </div>

        <!-- Transaction Details -->
        <div class="bg-gray-50 rounded-xl p-5 mb-8">
            <h3 class="text-sm font-medium text-gray-700 mb-4">TRANSACTION DETAILS</h3>

            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-sm text-gray-600">Transaction ID</span>
                    <span class="text-sm font-medium text-gray-900" id="transaction-id">
                        <%= txnid %>
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-600">Amount</span>
                    <span class="text-sm font-medium text-gray-900" id="transaction-amount">₹<%= amount %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-600">Date & Time</span>
                    <span class="text-sm font-medium text-gray-900">
                        <%= date %>
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-600">Payment Method</span>
                    <span class="text-sm font-medium text-gray-900 flex items-center">
                        UPI Payment
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-600">Status</span>
                    <span class="text-sm font-medium text-green-600 flex items-center">
                        <i class="fas fa-circle text-xs mr-1"></i>
                        Completed
                    </span>
                </div>
            </div>
        </div>

        <!-- Redirect Timer -->
        <div class="mb-6">
            <p class="text-sm text-gray-600 text-center mb-3">Redirecting to merchant in <span id="countdown"
                    class="font-bold text-gray-900">3</span> seconds</p>
            <div class="progress-bar">
                <div class="progress-fill"></div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
            <button
                class="flex-1 py-3 px-4 bg-black hover:bg-gray-700 text-white font-medium rounded-lg transition duration-200 flex items-center justify-center"
                onclick="window.location.href='/user/dashboard'">
                <i class="fas fa-home mr-2"></i>
                Back to Home
            </button>
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center">
        <p class="text-xs text-gray-500 mb-1">
            <i class="fas fa-lock mr-1"></i> Secured by UPIExpress
        </p>
    </div>

    <script>
        // Google Ads Conversion Tracking - Dynamic value update
        function updateConversionTracking(transactionId, amount, currency) {
            gtag('event', 'conversion', {
                'send_to': 'AW-777328699/bC4-COaV_90ZELuw1PIC',
                'value': amount,
                'currency': currency,
                'transaction_id': transactionId
            });

            console.log('Conversion tracked:', {
                transactionId: transactionId,
                amount: amount,
                currency: currency
            });
        }

        // Initialize conversion tracking with actual transaction data
        document.addEventListener('DOMContentLoaded', function () {
            // Extract transaction data from page
            const transactionId = document.getElementById('transaction-id').textContent;
            const amountText = document.getElementById('transaction-amount').textContent;

            // Convert ₹1,499.00 to numeric value 1499.00
            const amountValue = parseFloat(amountText.replace(/[₹,]/g, ''));
            const currency = 'INR'; // Assuming Indian Rupees

            // Send conversion data
            updateConversionTracking(transactionId, amountValue, currency);

            // Countdown timer
            let countdown = 3;
            const countdownElement = document.getElementById('countdown');

            const countdownInterval = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;

                if (countdown <= 0) {
                    clearInterval(countdownInterval);

                    // Update progress bar
                    document.querySelector('.progress-fill').style.backgroundColor = '#10b981';
                    document.querySelector('.progress-fill').style.width = '0%';

                    // Show redirect message
                    setTimeout(() => {
                        document.querySelector('h2').textContent = 'Redirecting...';
                        document.querySelector('.text-gray-600').textContent = 'Taking you back to the merchant';

                        // Optional: Track redirect as another event
                        gtag('event', 'page_view', {
                            'page_title': 'Payment Success Redirect',
                            'send_to': 'AW-777328699'
                        });

                        // In a real app, uncomment this to redirect
                        window.location.href = "/user/dashboard";
                    }, 500);
                }
            }, 1000);
        });
    </script>
</body>

</html>