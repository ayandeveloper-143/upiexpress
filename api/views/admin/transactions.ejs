                            </div>
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            <span class="${transaction.status === 'active' ? 'status-active' : transaction.status === 'inactive' ? 'status-inactive' : 'status-suspend'} status-badge mr-2">
                                ${transaction.status.charAt(0).toUpperCase() + transaction.status.slice(1)}
                            </span>
                            <span class="${transaction.plan_status === 'active' ? 'status-active' : transaction.plan_status === 'expired' ? 'status-expired' : 'status-expiring'} status-badge">
                                ${transaction.plan_status.charAt(0).toUpperCase() + transaction.plan_status.slice(1)}
                            </span>
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label">Start Date</div>
                        <div class="detail-value">${formatDate(transaction.started_at)}</div>
                    </div>
                    <div class="detail-row">
