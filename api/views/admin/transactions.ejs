            const tableBody = document.getElementById('transactionsTableBody');
            const pagination = document.getElementById('pagination');

            // Calculate pagination
            const totalPages = Math.ceil(filteredTransactions.length / itemsPerPage);
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const pageTransactions = filteredTransactions.slice(startIndex, endIndex);

            // Clear table
            tableBody.innerHTML = '';

            // Populate table
            pageTransactions.forEach(transaction => {
                const row = document.createElement('tr');

                // Format date
                let date, formattedDate;
                if (transaction._type === 'subscription') {
                    date = new Date(transaction.started_at);
                } else {
                    date = new Date(transaction.createdAt);
                }
                formattedDate = date.toLocaleDateString('en-IN', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                if (transaction._type === 'subscription') {
                    // Subscription row
                    const statusClass = transaction.status === 'active' ? 'status-active' :
                        transaction.status === 'inactive' ? 'status-inactive' : 'status-suspend';
                    const statusText = transaction.status.charAt(0).toUpperCase() + transaction.status.slice(1);

                    const planStatusClass = transaction.plan_status === 'active' ? 'status-active' :
                        transaction.plan_status === 'expired' ? 'status-expired' : 'status-expiring';
                    const planStatusText = transaction.plan_status.charAt(0).toUpperCase() + transaction.plan_status.slice(1);

                    const usagePercentage = transaction.qr_code_requests_limit > 0 ?
                        Math.round((transaction.qr_code_requests_used / transaction.qr_code_requests_limit) * 100) : 0;

                    row.innerHTML = `
                        <td class="font-mono text-sm">${transaction.id}</td>
                        <td>
                            <div class="flex flex-col">
                                <span class="font-medium text-white">Plan: ${transaction.plan_id}</span>
                                <span class="text-sm text-gray-400">User: ${transaction.userid}</span>
                                <span class="text-sm text-gray-400">TXN: ${transaction.txnid}</span>
                                <span class="text-sm text-gray-400">Order: ${transaction.orderid}</span>
                                <div class="mt-1">
                                    <div class="qr-usage">
                                        <span>QR Usage: ${transaction.qr_code_requests_used}/${transaction.qr_code_requests_limit}</span>
                                        <div class="w-16 bg-[#21262d] h-1 rounded-full overflow-hidden">
                                            <div class="h-full ${usagePercentage > 80 ? 'bg-red-500' : usagePercentage > 50 ? 'bg-yellow-500' : 'bg-green-500'}" 
                                                 style="width: ${Math.min(usagePercentage, 100)}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="type-plan type-badge">Subscription</span>
                            <div class="mt-1 text-xs text-gray-400">Qty: ${transaction.quantity}</div>
                        </td>
                        <td>
                            <div class="flex flex-col gap-1">
                                <span class="${statusClass} status-badge">${statusText}</span>
                                <span class="${planStatusClass} status-badge">${planStatusText}</span>
                            </div>
                        </td>
                        <td class="font-bold text-lg">₹${transaction.amount.toFixed(2)}</td>
                        <td>
                            <div class="flex flex-col">
                                <span class="text-gray-300">${formattedDate}</span>
                                <span class="text-xs text-gray-400">Expires: ${new Date(transaction.expire_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                            </div>
                        </td>
                        <td>
                            <button class="action-btn action-btn-view" onclick="viewTransaction(${transaction.id}, 'subscription')">
                                View
                            </button>
                            <button class="action-btn action-btn-edit" onclick="editTransaction(${transaction.id}, 'subscription')">
                                Edit
                            </button>
                        </td>
                    `;
                } else {
                    // Wallet transaction row
                    const statusClass = transaction.status === 'completed' ? 'status-completed' :
                        transaction.status === 'pending' ? 'status-pending' : 'status-failed';
                    const statusText = transaction.status.charAt(0).toUpperCase() + transaction.status.slice(1);

                    const typeClass = transaction.type === 'deposit' ? 'type-deposit' : 'type-fee';
                    const typeText = transaction.type.charAt(0).toUpperCase() + transaction.type.slice(1);

                    const amountClass = transaction.type === 'deposit' ? 'amount-positive' : 'amount-negative';

                    row.innerHTML = `
                        <td class="font-mono text-sm">${transaction.id}</td>
                        <td>
                            <div class="flex flex-col">
                                <span class="font-medium text-white">${typeText} Transaction</span>
                                <span class="text-sm text-gray-400">User: ${transaction.userid}</span>
                                <span class="text-sm text-gray-400">TXN: ${transaction.txid}</span>
                                <span class="text-sm text-gray-400">Order: ${transaction.orderid}</span>
                            </div>
                        </td>
                        <td>
                            <span class="${typeClass} type-badge">${typeText}</span>
                        </td>
                        <td>
                            <span class="${statusClass} status-badge">${statusText}</span>
                        </td>
                        <td class="font-bold text-lg ${amountClass}">
                            ${transaction.type === 'deposit' ? '+' : '-'}₹${transaction.amount.toFixed(2)}
                        </td>
                        <td>
                            <span class="text-gray-300">${formattedDate}</span>
                        </td>
                        <td>
                            <button class="action-btn action-btn-view" onclick="viewTransaction(${transaction.id}, 'wallet')">
                                View
                            </button>
                            ${transaction.status === 'pending' ? `
                                <button class="action-btn action-btn-edit" onclick="processTransaction(${transaction.id})">
                                    Process
                                </button>
                            ` : ''}
                            ${transaction.status === 'completed' && transaction.type === 'deposit' ? `
                                <button class="action-btn action-btn-refund" onclick="refundTransaction(${transaction.id})">
                                    Refund
                                </button>
                            ` : ''}
                        </td>
                    `;
                }
                tableBody.appendChild(row);
            });

            // Render pagination
            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            // Previous button
            const prevButton = document.createElement('button');
            prevButton.textContent = 'Previous';
            prevButton.className = 'page-btn';
            prevButton.disabled = currentPage === 1;
            if (currentPage === 1) {
                prevButton.classList.add('disabled');
            }
            prevButton.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    renderTable();
                }
            });
            pagination.appendChild(prevButton);

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    const pageButton = document.createElement('button');
                    pageButton.textContent = i;
                    pageButton.className = 'page-btn';
                    if (i === currentPage) {
                        pageButton.classList.add('active');
                    }
                    pageButton.addEventListener('click', () => {
                        currentPage = i;
                        renderTable();
                    });
                    pagination.appendChild(pageButton);
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    const ellipsis = document.createElement('span');
                    ellipsis.textContent = '...';
                    ellipsis.className = 'text-gray-400 px-2';
                    pagination.appendChild(ellipsis);
                }
            }

            // Next button
            const nextButton = document.createElement('button');
            nextButton.textContent = 'Next';
            nextButton.className = 'page-btn';
            nextButton.disabled = currentPage === totalPages;
            if (currentPage === totalPages) {
                nextButton.classList.add('disabled');
            }
            nextButton.addEventListener('click', () => {
                if (currentPage < totalPages) {
                    currentPage++;
                    renderTable();
                }
            });
            pagination.appendChild(nextButton);
        }

        function setupEventListeners() {
            // Search input
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', debounce(filterTransactions, 300));

            // Date filters
            const dateFrom = document.getElementById('dateFrom');
            const dateTo = document.getElementById('dateTo');
            dateFrom.addEventListener('change', filterTransactions);
            dateTo.addEventListener('change', filterTransactions);

            // Amount filter
            const amountFilter = document.getElementById('amountFilter');
            amountFilter.addEventListener('change', filterTransactions);

            // Export button
            const exportBtn = document.getElementById('exportBtn');
            exportBtn.addEventListener('click', exportToCSV);
        }

        function setupTabNavigation() {
            const allBtn = document.getElementById('allTransactionsBtn');
            const subscriptionsBtn = document.getElementById('subscriptionsBtn');
            const walletBtn = document.getElementById('walletTransactionsBtn');
            const pendingBtn = document.getElementById('pendingBtn');
            const completedBtn = document.getElementById('completedBtn');

            allBtn.addEventListener('click', () => {
                setActiveTab('all');
                filterByTab('all');
            });

            subscriptionsBtn.addEventListener('click', () => {
                setActiveTab('subscriptions');
                filterByTab('subscriptions');
            });

            walletBtn.addEventListener('click', () => {
                setActiveTab('wallet');
                filterByTab('wallet');
            });

            pendingBtn.addEventListener('click', () => {
                setActiveTab('pending');
                filterByTab('pending');
            });

            completedBtn.addEventListener('click', () => {
                setActiveTab('completed');
                filterByTab('completed');
            });
        }

        function setActiveTab(tab) {
            activeTab = tab;
            const tabs = ['allTransactionsBtn', 'subscriptionsBtn', 'walletTransactionsBtn', 'pendingBtn', 'completedBtn'];
            tabs.forEach(tabId => {
                const btn = document.getElementById(tabId);
                if (tabId === `${tab}Btn`) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        function filterByTab(tab) {
            switch (tab) {
                case 'all':
                    filteredTransactions = [...allTransactions];
                    break;
                case 'subscriptions':
                    filteredTransactions = allTransactions.filter(t => t._type === 'subscription');
                    break;
                case 'wallet':
                    filteredTransactions = allTransactions.filter(t => t._type === 'wallet');
                    break;
                case 'pending':
                    filteredTransactions = allTransactions.filter(t =>
                        (t._type === 'subscription' && t.status === 'inactive') ||
                        (t._type === 'wallet' && t.status === 'pending')
                    );
                    break;
                case 'completed':
                    filteredTransactions = allTransactions.filter(t =>
                        (t._type === 'subscription' && t.status === 'active') ||
                        (t._type === 'wallet' && t.status === 'completed')
                    );
                    break;
            }
            currentPage = 1;
            applyFilters();
        }

        function filterTransactions() {
            applyFilters();
        }

        function applyFilters() {
            const searchInput = document.getElementById('searchInput');
            const dateFrom = document.getElementById('dateFrom');
            const dateTo = document.getElementById('dateTo');
            const amountFilter = document.getElementById('amountFilter');

            const searchTerm = searchInput.value.toLowerCase();
            const fromDate = dateFrom.value ? new Date(dateFrom.value) : null;
            const toDate = dateTo.value ? new Date(dateTo.value) : null;
            const amountRange = amountFilter.value;

            let tempTransactions = [...filteredTransactions];

            // Apply search filter
            if (searchTerm) {
                tempTransactions = tempTransactions.filter(transaction => {
                    if (transaction._type === 'subscription') {
                        return transaction.userid.toLowerCase().includes(searchTerm) ||
                            transaction.txnid?.toLowerCase().includes(searchTerm) ||
                            transaction.orderid?.toLowerCase().includes(searchTerm) ||
                            transaction.plan_id.toLowerCase().includes(searchTerm);
                    } else {
                        return transaction.userid.toLowerCase().includes(searchTerm) ||
                            transaction.txid?.toLowerCase().includes(searchTerm) ||
                            transaction.orderid?.toLowerCase().includes(searchTerm);
                    }
                });
            }

            // Apply date filter
            if (fromDate || toDate) {
                tempTransactions = tempTransactions.filter(transaction => {
                    let transactionDate;
                    if (transaction._type === 'subscription') {
                        transactionDate = new Date(transaction.started_at);
                    } else {
                        transactionDate = new Date(transaction.createdAt);
                    }

                    let valid = true;
                    if (fromDate) {
                        valid = valid && transactionDate >= fromDate;
                    }
                    if (toDate) {
                        // Set toDate to end of day
                        const toDateEnd = new Date(toDate);
                        toDateEnd.setHours(23, 59, 59, 999);
                        valid = valid && transactionDate <= toDateEnd;
                    }
                    return valid;
                });
            }

            // Apply amount filter
            if (amountRange) {
                tempTransactions = tempTransactions.filter(transaction => {
                    const amount = transaction._type === 'subscription' ? transaction.amount : transaction.amount;
                    switch (amountRange) {
                        case '0-500':
                            return amount >= 0 && amount <= 500;
                        case '500-1000':
                            return amount > 500 && amount <= 1000;
                        case '1000-5000':
                            return amount > 1000 && amount <= 5000;
                        case '5000+':
                            return amount > 5000;
                        default:
                            return true;
                    }
                });
            }

            filteredTransactions = tempTransactions;
            currentPage = 1;
            renderTable();
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

