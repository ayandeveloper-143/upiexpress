        function editTransaction(transactionId, type) {
            alert(`Edit ${type} transaction with ID: ${transactionId}\nThis would open an edit form in a real application.`);
        }

        function processTransaction(transactionId) {
            if (confirm('Are you sure you want to process this transaction?')) {
                const transaction = sampleWalletTransactions.find(t => t.id === transactionId);
                if (transaction && transaction.status === 'pending') {
                    transaction.status = 'completed';
                    applyFilters();
                    alert('Transaction processed successfully!');
                }
            }
        }

        function refundTransaction(transactionId) {
            if (confirm('Are you sure you want to refund this transaction?')) {
                alert('Refund initiated for transaction ID: ' + transactionId + '\nIn a real application, this would trigger a refund process.');
            }
        }

        function exportToCSV() {
            // Create CSV content
            const headers = [
                'Type', 'ID', 'Transaction ID', 'User ID', 'Order ID', 'Amount',
                'Status', 'Date', 'Details'
            ];

            const csvContent = [
                headers.join(','),
                ...filteredTransactions.map(transaction => {
                    if (transaction._type === 'subscription') {
                        return [
                            'Subscription',
                            transaction.id,
                            `"${transaction.txnid || ''}"`,
                            `"${transaction.userid}"`,
                            `"${transaction.orderid || ''}"`,
                            transaction.amount,
                            transaction.status,
                            `"${transaction.started_at}"`,
                            `"Plan: ${transaction.plan_id}, Usage: ${transaction.qr_code_requests_used}/${transaction.qr_code_requests_limit}"`
                        ].join(',');
                    } else {
                        return [
                            'Wallet',
                            transaction.id,
                            `"${transaction.txid || ''}"`,
                            `"${transaction.userid}"`,
                            `"${transaction.orderid || ''}"`,
                            transaction.amount,
                            transaction.status,
                            `"${transaction.createdAt}"`,
                            `"Type: ${transaction.type}"`
                        ].join(',');
                    }
                })
            ].join('\n');

            // Create and trigger download
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', `transactions_export_${new Date().toISOString().split('T')[0]}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function setupMobileNavigation() {
            const navWrappers = document.querySelectorAll('.nav-badge-wrapper');
            const materialSymbolsLink = document.getElementById('material-symbols-link');

            // Set initial active state for Transactions
            navWrappers[2].classList.add('active');
            navWrappers[2].querySelector('.nav-badge').classList.add('active');

            navWrappers.forEach((wrapper, index) => {
                wrapper.addEventListener('touchstart', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.add('touched');
                });

                wrapper.addEventListener('touchend', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('touchcancel', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('click', function () {
                    navWrappers.forEach((b, i) => {
                        b.classList.remove('active');
                        b.querySelector('.nav-badge').classList.remove('active', 'touched');
                    });

                    this.classList.add('active');
                    const currentBadge = this.querySelector('.nav-badge');
                    currentBadge.classList.add('active');

                    // Navigation logic
                    switch (index) {
                        case 0: // Dashboard
                            window.location.href = '/admin/dashboard';
                            break;
                        case 1: // Users
                            window.location.href = '/admin/users';
                            break;
                        case 2: // Transactions
                            // Already on transactions page
                            break;
                        case 3: // Settings
                            window.location.href = '/admin/settings';
                            break;
                    }
                });
            });
        }
    </script>

