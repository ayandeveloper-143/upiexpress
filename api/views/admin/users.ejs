            userModal.classList.add('active');
        }

        function editUser(userId) {
            alert(`Edit user with ID: ${userId}\nThis would open an edit form in a real application.`);
        }

        function deleteUser(userId) {
            if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                const index = sampleUsers.findIndex(u => u.id === userId);
                if (index !== -1) {
                    sampleUsers.splice(index, 1);
                    filterUsers();
                    alert('User deleted successfully!');
                }
            }
        }

        function exportToCSV() {
            // Create CSV content
            const headers = [
                'ID', 'Type', 'User ID', 'Name', 'Email', 'Phone', 'Status',
                'Register Date', 'Wallet Balance', 'Total Spent', 'Total Deposit',
                'Business Name', 'State', 'Last Login'
            ];

            const csvContent = [
                headers.join(','),
                ...filteredUsers.map(user => [
                    user.id,
                    user.type,
                    `"${user.userid}"`,
                    `"${user.name}"`,
                    `"${user.email || ''}"`,
                    `"${user.phone || ''}"`,
                    user.account_status,
                    `"${user.register_date}"`,
                    user.wallet_balance,
                    user.total_spent,
                    user.total_deposit,
                    `"${user.business_name || ''}"`,
                    `"${user.state || ''}"`,
                    `"${user.last_login || ''}"`
                ].join(','))
            ].join('\n');

            // Create and trigger download
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', `users_export_${new Date().toISOString().split('T')[0]}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function setupMobileNavigation() {
            const navWrappers = document.querySelectorAll('.nav-badge-wrapper');
            const materialSymbolsLink = document.getElementById('material-symbols-link');

            // Set initial active state for Users
            navWrappers[1].classList.add('active');
            navWrappers[1].querySelector('.nav-badge').classList.add('active');

            navWrappers.forEach((wrapper, index) => {
                wrapper.addEventListener('touchstart', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.add('touched');
                });

                wrapper.addEventListener('touchend', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('touchcancel', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('click', function () {
                    navWrappers.forEach((b, i) => {
                        b.classList.remove('active');
                        b.querySelector('.nav-badge').classList.remove('active', 'touched');
                    });

                    this.classList.add('active');
                    const currentBadge = this.querySelector('.nav-badge');
                    currentBadge.classList.add('active');

                    // Navigation logic
                    switch (index) {
                        case 0: // Dashboard
                            window.location.href = '/admin/dashboard';
                            break;
                        case 1: // Users
                            // Already on users page
                            break;
                        case 2: // Transactions
                            window.location.href = '/admin/transactions';
                            break;
                        case 3: // Settings
                            window.location.href = '/admin/settings';
                            break;
                    }
                });
            });
        }
    </script>

