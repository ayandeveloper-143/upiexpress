        <!-- Mobile Bottom Navigation -->
        <div class="mobile-bottom-nav">
            <div class="nav-badge-wrapper active">
                <div class="nav-badge active" id="navDashboard">
                    <span class="material-symbols-rounded">dashboard</span>
                </div>
                <div class="nav-text">Dashboard</div>
            </div>

            <div class="nav-badge-wrapper">
                <div class="nav-badge" id="navUsers">
                    <span class="material-symbols-rounded">people</span>
                </div>
                <div class="nav-text">Users</div>
            </div>

            <div class="nav-badge-wrapper">
                <div class="nav-badge" id="navTransactions">
                    <span class="material-symbols-rounded">sync_alt</span>
                </div>
                <div class="nav-text">Transactions</div>
            </div>

            <div class="nav-badge-wrapper">
                <div class="nav-badge" id="navSettings">
                    <span class="material-symbols-rounded">settings</span>
                </div>
                <div class="nav-text">Settings</div>
            </div>
        </div>

    </div>


    <script>
        // Get DOM elements
        const profileDropdown = document.getElementById('profileDropdown');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const sidebar = document.getElementById('sidebar');
        const toggleSidebar = document.getElementById('toggleSidebar');
        const mobileSidebar = document.getElementById('mobileSidebar');
        const mobileHamburger = document.getElementById('mobileHamburger');
        const mobileSidebarClose = document.getElementById('mobileSidebarClose');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        // Profile Dropdown Toggle
        if (profileDropdown && dropdownMenu) {
            profileDropdown.addEventListener('click', () => {
                dropdownMenu.classList.toggle('show');
            });

            document.addEventListener('click', (e) => {
                if (!profileDropdown.contains(e.target) && !dropdownMenu.contains(e.target)) {
                    dropdownMenu.classList.remove('show');
                }
            });
        }

        let hoverEnabled = false;
        let isCollapsed = false;

        // Desktop sidebar toggle
        if (toggleSidebar && sidebar) {
            toggleSidebar.addEventListener('click', function () {
                isCollapsed = !isCollapsed;

                if (isCollapsed) {
                    sidebar.classList.add('collapsed');
                    sidebar.classList.remove('hover-enabled');

                    setTimeout(() => {
                        sidebar.classList.add('hover-enabled');
                        hoverEnabled = true;
                    }, 1000);

                } else {
                    sidebar.classList.remove('collapsed');
                    sidebar.classList.remove('hover-enabled');
                    hoverEnabled = false;
                }
            });
        }

        // Mobile sidebar toggle
        if (mobileHamburger && mobileSidebar) {
            mobileHamburger.addEventListener('click', () => {
                mobileSidebar.classList.add('active');
                sidebarOverlay.classList.add('active');
            });
        }

        // Close mobile sidebar
        if (mobileSidebarClose && mobileSidebar) {
            mobileSidebarClose.addEventListener('click', () => {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking overlay
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', () => {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking menu items
        const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', () => {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        });

        // Revenue Chart (ApexCharts)
        if (document.getElementById('revenue_chart')) {
            const revenueChart = new ApexCharts(document.getElementById('revenue_chart'), {
                series: [{
                    name: 'Revenue',
                    data: [12000, 15000, 18000, 16000, 19000, 21000, 25000, 23000, 26000, 29000, 31000, 35000]
                }],
                chart: {
                    type: 'line',
                    height: 350,
                    toolbar: {
                        show: false
                    },
                    background: 'transparent'
                },
                colors: ['#58a6ff'],
                stroke: {
                    width: 3,
                    curve: 'smooth'
                },
                xaxis: {
                    categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    labels: {
                        style: {
                            colors: '#8b949e'
                        }
                    }
                },
                yaxis: {
                    labels: {
                        formatter: function (value) {
                            return '₹' + (value / 1000).toFixed(0) + 'k';
                        },
                        style: {
                            colors: '#8b949e'
                        }
                    }
                },
                tooltip: {
                    theme: 'dark',
                    y: {
                        formatter: function (value) {
                            return '₹' + value.toFixed(0);
                        }
                    }
                },
                grid: {
                    borderColor: '#30363d'
                }
            });
            revenueChart.render();
        }

        // User Growth Chart (Donut/Radial)
        if (document.getElementById('user_growth_chart')) {
            const userGrowthChart = new ApexCharts(document.getElementById('user_growth_chart'), {
                series: [65, 35],
                chart: {
                    type: 'donut',
                    height: 350,
                    background: 'transparent'
                },
                colors: ['#58a6ff', '#21262d'],
                labels: ['Active', 'Inactive'],
                legend: {
                    position: 'bottom',
                    labels: {
                        colors: '#8b949e'
                    }
                },
                tooltip: {
                    theme: 'dark'
                }
            });
            userGrowthChart.render();
        }

        // Mobile Bottom Navigation
        document.addEventListener('DOMContentLoaded', function () {
            const navWrappers = document.querySelectorAll('.nav-badge-wrapper');
            const materialSymbolsLink = document.getElementById('material-symbols-link');

            // Set initial active state for Dashboard
            navWrappers[0].classList.add('active');
            navWrappers[0].querySelector('.nav-badge').classList.add('active');
            materialSymbolsLink.href = "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0";

            navWrappers.forEach((wrapper, index) => {
                wrapper.addEventListener('touchstart', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.add('touched');
                });

                wrapper.addEventListener('touchend', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('touchcancel', function (e) {
                    const badge = this.querySelector('.nav-badge');
                    badge.classList.remove('touched');
                });

                wrapper.addEventListener('click', function () {
                    navWrappers.forEach((b, i) => {
                        b.classList.remove('active');
                        b.querySelector('.nav-badge').classList.remove('active', 'touched');
                    });

                    this.classList.add('active');
                    const currentBadge = this.querySelector('.nav-badge');
                    currentBadge.classList.add('active');

                    // Update font FILL axis based on active state
                    if (this.classList.contains('active')) {
                        materialSymbolsLink.href = "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0";
                    } else {
                        materialSymbolsLink.href = "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0";
                    }

                    // Handle navigation based on which item was clicked
                    switch (index) {
                        case 0: // Dashboard
                            window.location.href = '/admin/dashboard';
                            break;
                        case 1: // Users
                            window.location.href = '/admin/users';
                            break;
                        case 2: // Transactions
                            window.location.href = '/admin/transactions';
                            break;
                        case 3: // Settings
                            window.location.href = '/admin/settings';
                            break;
                    }
                });
            });
        });
    </script>

</body>

