<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/images/icon.png" type="image/png">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <link id="material-symbols-link" rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        :root {
            --primary: #ffffff;
            --primary-light: #f3f4f6;
            --primary-dark: #e5e7eb;
            --primary-transparent: rgba(255, 255, 255, 0.1);
            --dark-1: #0f1117;
            --dark-2: #161b22;
            --dark-3: #21262d;
            --light-1: #8b949e;
            --light-2: #6e7681;
            --light-3: #484f58;
            --background-primary: #161b22;
            --background-secondary: #21262d;
            --text-primary: #58a6ff;
            --text-secondary: #8b949e;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: sans-serif;
            background-color: #0f1117;
            color: #e6edf3;
            overflow-x: hidden;
            -webkit-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            overflow: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        body::-webkit-scrollbar {
            display: none;
        }

        .page-content {
            animation: feedPageFadeIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes feedPageFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Desktop Sidebar Styles */
        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #161b22;
            border-right: 1px solid #21262d;
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-x: hidden;
        }

        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0 !important;
                padding-bottom: 80px;
            }
        }

        .sidebar.collapsed {
            width: 70px;
        }

        .sidebar.collapsed .sidebar-text,
        .sidebar.collapsed .sidebar-section,
        .sidebar.collapsed .nav-header {
            display: none !important;
        }

        .sidebar.collapsed .sidebar-top {
            justify-content: center;
            padding: 1rem 0;
        }

        .sidebar.collapsed .sidebar-toggle {
            display: none;
        }

        .sidebar.collapsed .nav-link-text {
            width: 0;
            opacity: 0;
            visibility: hidden;
        }

        .sidebar.collapsed .menu-item {
            padding: 6px 0 !important;
            justify-content: center;
            height: 48px;
            display: flex;
            align-items: center;
        }

        .sidebar.collapsed .menu-gap {
            height: 0;
        }

        .sidebar.collapsed.hover-enabled:hover {
            width: 280px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-text,
        .sidebar.collapsed.hover-enabled:hover .sidebar-section,
        .sidebar.collapsed.hover-enabled:hover .nav-header {
            display: block !important;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-top {
            justify-content: space-between;
            padding: 1rem 1.5rem;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-item {
            justify-content: flex-start;
            padding: 12px 24px !important;
            height: 48px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-toggle {
            display: block;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-link-text {
            width: auto;
            opacity: 1;
            visibility: visible;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-gap {
            height: 1rem;
        }

        .main-content {
            margin-left: 280px;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
            padding: 20px;
            padding-bottom: 0px;
        }

        .sidebar.collapsed~.main-content {
            margin-left: 70px;
        }

        .sidebar.collapsed.hover-enabled:hover~.main-content {
            margin-left: 280px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            border-radius: 16px;
            margin-left: 8px;
            margin-bottom: 2px;
            margin-right: 8px;
            color: #8b949e;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .menu-item:hover {
            background-color: #21262d;
            color: #e6edf3;
        }

        .menu-item.active {
            background-color: #21262d;
            color: #58a6ff;
        }

        .nav-icon-wrap {
            width: 24px;
            text-align: center;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar.collapsed .nav-icon-wrap {
            margin-right: 0;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-icon-wrap {
            margin-right: 12px;
        }

        .nav-link-text {
            transition: all 0.3s ease;
        }

        .svg-icon {
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .icon {
            width: 100%;
            height: 100%;
        }

        /* Sidebar Top Styles */
        .sidebar-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #21262d;
        }

        .sidebar-text {
            transition: all 0.3s ease;
        }

        /* Menu Content Wrapper */
        .menu-content-wrap {
            padding: 0.5rem 0;
            overflow-y: auto;
            overflow-x: hidden;
            max-height: calc(100vh - 100px);
        }

        /* Menu Group Styles */
        .menu-group {
            margin: 0.5rem 0;
        }

        .menu-gap {
            height: 1rem;
            transition: height 0.2s ease;
        }

        /* Navigation Header */
        .nav-header {
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            color: #484f58;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Navigation List */
        .navbar-nav {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }

        .nav-item {
            list-style: none;
        }

        .nav-link {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: inherit;
        }

        /* Flex Column Utility */
        .flex-column {
            flex-direction: column;
        }

        .sidebar-toggle {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 600;
            color: #58a6ff;
        }

        .brand-subtext {
            font-size: 14px;
            color: #8b949e;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .header-item:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .header-text {
            font-size: 14px;
            font-weight: 500;
            color: #e6edf3;
        }

        .profile-dropdown {
            position: relative;
        }

        .profile-btn {
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .avatar {
            width: 36px;
            height: 36px;
            background: #21262d;
            color: #58a6ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid #30363d;
        }

        .dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            width: auto;
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            padding: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.3s ease;
            z-index: 101;
        }

        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-header {
            padding: 16px;
        }

        .user-info {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .user-details {
            flex: 1;
        }

        .user-name {
            font-weight: 600;
            color: #e6edf3;
            margin-bottom: 1px;
        }

        .user-email {
            font-size: 14px;
            color: #8b949e;
            margin-bottom: 2px;
        }

        .logout-link {
            font-size: 14px;
            color: #f85149;
            text-decoration: underline;
        }

        .dropdown-divider {
            height: 1px;
            background: #30363d;
            margin: 0;
        }

        .dropdown-item {
            display: block;
            padding: 8px 16px;
            color: #8b949e;
            text-decoration: none;
            transition: background-color 0.3s ease;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .dropdown-item:hover {
            background-color: #30363d;
            color: #e6edf3;
        }

        .mobile-hamburger {
            display: none;
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            color: #8b949e;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .mobile-hamburger:hover {
            background-color: #21262d;
            color: #e6edf3;
        }

        @media (max-width: 768px) {
            .mobile-hamburger {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .header-item {
                display: flex;
                padding: 6px;
            }

            .header-item .header-text {
                display: none;
            }

            .header-brand {
                display: none;
            }

            .brand-subtext {
                display: none;
            }

            .dropdown-menu {
                width: auto;
                right: -10px;
            }

            .header-left {
                gap: 0;
            }
        }

        @media (min-width: 769px) {

            .mobile-sidebar,
            .sidebar-overlay {
                display: none !important;
            }
        }

        @media (max-width: 1024px) {
            .header-item .header-text {
                display: none;
            }

            .header-item {
                padding: 8px;
            }
        }

        .card {
            border-color: #30363d;
            border-radius: .5rem;
            box-shadow: 0 2px 2px rgba(0, 0, 0, .3);
            margin-bottom: .875rem;
        }

        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #161b22;
            background-clip: border-box;
            border: 1px solid #30363d;
            border-radius: .25rem;
        }

        .footer {
            border-top: 1px solid #21262d;
            padding: 16px 20px;
            background-color: #161b22;
            margin-top: 20px;
        }

        .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .footer-left,
        .footer-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .footer-link {
            text-decoration: none;
            margin: 0 15px;
            color: #58a6ff;
            transition: color 0.3s ease;
        }

        .footer-link:hover {
            color: #79c0ff;
        }

        .footer-content p {
            color: #8b949e;
        }

        @media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                gap: 10px;
                align-items: center;
            }

            .footer-left,
            .footer-right {
                justify-content: center;
            }
        }

        /* Mobile Bottom Navigation Styles */
        .mobile-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 64px;
            background-color: var(--background-primary);
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 6px 0;
            z-index: 999;
            border-top: 1px solid #30363d;
            display: none;
        }

        @media (max-width: 768px) {
            .mobile-bottom-nav {
                display: flex;
            }
        }

        .nav-badge-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            flex: 1;
        }

        .nav-badge {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 60px;
            height: 32px;
            border-radius: 16px;
            background-color: var(--background-primary);
            color: var(--text-secondary);
            transition: all 0.2s ease;
            z-index: 2;
        }

        .material-symbols-rounded {
            position: relative;
            z-index: 3;
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24;
        }

        .nav-badge.active .material-symbols-rounded {
            font-variation-settings:
                'FILL' 1,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24;
        }

        .nav-badge::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: var(--background-secondary);
            border-radius: 16px;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
            left: 0;
            top: 0;
        }

        .nav-badge.touched::after {
            opacity: 0.2;
        }

        .nav-badge.active::after {
            opacity: 0.3;
        }

        .nav-badge::before {
            content: '';
            position: absolute;
            width: 0;
            height: 100%;
            background-color: var(--background-secondary);
            border-radius: 16px;
            opacity: 0;
            transition: width 0.5s ease, opacity 0.3s ease;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1;
        }

        .nav-badge.active::before {
            width: 100%;
            opacity: 1;
        }

        .nav-badge.active {
            color: var(--text-primary);
        }

        .nav-text {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .nav-badge-wrapper.active .nav-text {
            color: var(--text-primary);
        }

        /* Mobile Sidebar Styles */
        .mobile-sidebar {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100vh;
            background: #161b22;
            border-right: 1px solid #21262d;
            transition: all 0.3s ease;
            z-index: 1001;
            overflow-y: auto;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
        }

        .mobile-sidebar.active {
            left: 0;
        }

        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }
    </style>
</head>

<body>
    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Mobile Sidebar -->
    <div class="mobile-sidebar" id="mobileSidebar">
        <div class="sidebar-top flex items-center justify-between px-6 py-4">
            <div class="flex items-center">
                <img src="/images/icon.png" alt="UPIExpress" class="w-8 h-8">
                <span class="sidebar-text font-bold text-xl mr-[2.2px] text-gray-200">UPI</span>
                <span class="sidebar-text font-family text-xl text-gray-400">Express</span>
            </div>
            <button class="flex items-center justify-center text-gray-400 hover:text-gray-300" id="mobileSidebarClose">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Menu Content -->
        <div class="menu-content-wrap mt-3">
            <div class="menu-group">
                <ul class="navbar-nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link menu-item active" href="/admin/dashboard">
                            <span class="nav-icon-wrap">
                                <span class="svg-icon">
                                    <svg class="icon icon-tabler icon-tabler-layout-2"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <rect x="4" y="4" width="6" height="5" rx="2"></rect>
                                        <rect x="4" y="13" width="6" height="7" rx="2"></rect>
                                        <rect x="14" y="4" width="6" height="7" rx="2"></rect>
                                        <rect x="14" y="15" width="6" height="5" rx="2"></rect>
                                    </svg>
                                </span>
                            </span>
                            <span class="nav-link-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-item" href="/admin/users">
                            <span class="nav-icon-wrap">
                                <span class="svg-icon">
                                    <svg class="icon icon-tabler icon-tabler-users" xmlns="http://www.w3.org/2000/svg"
                                        width="24" height="24" viewBox="0 0 24 24" stroke-width="2"
                                        stroke="currentColor" fill="none" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                                        <circle cx="15" cy="11" r="2"></circle>
                                        <path d="M12 17h6"></path>
                                    </svg>
                                </span>
                            </span>
                            <span class="nav-link-text">Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-item" href="/admin/transactions">
                            <span class="nav-icon-wrap">
                                <span class="svg-icon">
                                    <svg class="icon icon-tabler icon-tabler-arrow-autofit-height"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M12 20h-6a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h6"></path>
                                        <path d="M18 14v7"></path>
                                        <path d="M18 3v7"></path>
                                        <path d="M15 18l3 3l3 -3"></path>
                                        <path d="M15 6l3 -3l3 3"></path>
                                    </svg>
                                </span>
                            </span>
                            <span class="nav-link-text">Transactions</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="menu-gap"></div>

            <div class="menu-group">
                <div class="nav-header"><span>Plans</span></div>
                <ul class="navbar-nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link menu-item" href="/admin/plans">
                            <span class="nav-icon-wrap">
                                <span class="svg-icon">
                                    <svg class="icon icon-tabler icon-tabler-shopping-cart"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <circle cx="6" cy="19" r="2"></circle>
                                        <circle cx="17" cy="19" r="2"></circle>
                                        <path d="M17 17h-11v-14h-2"></path>
                                        <path d="M6 5l14 1l-1 7h-13"></path>
                                    </svg>
                                </span>
                            </span>
                            <span class="nav-link-text">All Plans</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-item" href="/admin/subscriptions">
                            <span class="nav-icon-wrap">
                                <span class="svg-icon">
                                    <svg class="icon icon-tabler icon-tabler-toggle-right"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <circle cx="16" cy="12" r="2"></circle>
                                        <rect x="2" y="6" width="20" height="12" rx="6"></rect>
                                    </svg>
                                </span>
                            </span>
                            <span class="nav-link-text">Subscriptions</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="menu-gap"></div>

            <div class="menu-group">
                <div class="nav-header"><span>Settings</span></div>
                <ul class="navbar-nav flex-column">
                    <li class="nav-item">
