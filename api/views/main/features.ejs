    <style>
        :root {
            --primary: #181a20;
            --primary-light: #1e2329;
            --primary-dark: #2b3139;
            --primary-transparent: rgba(0, 0, 0, 0.1);
            --dark-1: #181a20;
            --dark-2: #1e2329;
            --dark-3: #2b3139;
            --light-1: #eaecef;
            --light-2: #b7bdc6;
            --light-3: #848e9c;
        }

        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden !important;
            width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: "Inter", sans-serif;
        }

        .btn-theme {
            background-color: var(--primary);
            color: var(--light-1);
            border: 1px solid var(--primary-dark);
        }

        .btn-theme:hover {
            background-color: var(--primary-light);
            color: var(--light-1);
        }

        .btn-outline-theme {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-outline-theme:hover {
            background-color: var(--primary-transparent);
            color: var(--primary-dark);
        }

        .link-theme {
            color: var(--primary);
        }

        .link-theme:hover {
            color: var(--primary-light);
            text-decoration: underline;
        }

        .hero-bg {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        }

        .section-padding {
            padding: 3rem 0;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Feature Cards */
        .feature-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 2rem;
            height: 100%;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            border-color: var(--primary);
        }

        .feature-card.premium::after {
            content: 'PREMIUM';
            position: absolute;
            top: 12px;
            right: -30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 4px 40px;
            font-size: 11px;
            font-weight: 600;
            transform: rotate(45deg);
            letter-spacing: 1px;
        }

        .feature-card.enterprise::after {
            content: 'ENTERPRISE';
            position: absolute;
            top: 12px;
            right: -35px;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 4px 40px;
            font-size: 11px;
            font-weight: 600;
            transform: rotate(45deg);
            letter-spacing: 1px;
        }

        .feature-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        }

        .feature-icon.zero-fees {
            background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        }

        .feature-icon.security {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        }

        .feature-icon.real-time {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        }

        .feature-icon.multi-merchant {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }

        .feature-icon.api {
            background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
        }

        .feature-icon.analytics {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        }

        .feature-icon.webhooks {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        }

        .feature-icon.plugins {
            background: linear-gradient(135deg, #84cc16 0%, #65a30d 100%);
        }

        .feature-badge {
            display: inline-block;
            padding: 4px 12px;
            background: var(--primary-transparent);
            color: var(--primary);
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-right: 8px;
            margin-bottom: 12px;
        }

        /* Comparison Table */
        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .comparison-table th,
        .comparison-table td {
            padding: 1.25rem;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }

        .comparison-table th {
            background: var(--primary);
            color: white;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .comparison-table tr:last-child td {
            border-bottom: none;
        }

        .comparison-table .plan-name {
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--primary);
        }

        .check-icon {
            color: #10b981;
            font-size: 1.2rem;
        }

        .cross-icon {
            color: #ef4444;
            font-size: 1.2rem;
        }

        /* Mobile Menu Styles */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: white;
            z-index: 1000;
            padding: 80px 20px 20px;
            transform: translateX(-100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.1);
        }

        .mobile-menu.active {
            transform: translateX(0);
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1001;
        }

        .close-menu {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1002;
        }

        /* Feature Highlight */
        .feature-highlight {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            border-radius: 16px;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }

        .feature-highlight::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23fff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.1;
        }

        /* Stats Cards */
        .stat-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* Tabs for Features */
        .feature-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .feature-tab {
            padding: 12px 24px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            color: var(--light-3);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .feature-tab:hover,
        .feature-tab.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* Feature Grid */
        .feature-grid-item {
            display: flex;
            align-items: flex-start;
            padding: 1.5rem;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .feature-grid-item:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* Responsive styles */
        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }

            .desktop-nav {
                display: none !important;
            }

            .header-buttons {
                display: none !important;
            }

            .section-padding {
                padding: 2rem 0;
            }

            h1 {
                font-size: 2rem !important;
            }

            h2 {
                font-size: 1.75rem !important;
            }

            .feature-card {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .feature-highlight {
                padding: 2rem;
            }

            .comparison-table {
                font-size: 14px;
            }

            .comparison-table th,
            .comparison-table td {
                padding: 1rem 0.75rem;
            }

            .feature-tabs {
                justify-content: center;
            }

            .feature-tab {
                padding: 10px 16px;
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 1.75rem !important;
            }

            h2 {
                font-size: 1.5rem !important;
            }

            .feature-card {
                padding: 1.25rem;
            }

            .feature-icon {
                width: 56px;
                height: 56px;
            }
        }

        /* Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-in {
            animation: fadeInUp 0.6s ease-out forwards;
        }

        /* Feature List */
        .feature-list {
            list-style: none;
            padding: 0;
        }

        .feature-list li {
            padding: 8px 0;
            display: flex;
            align-items: center;
        }

        .feature-list li::before {
            content: '✓';
            color: #10b981;
            font-weight: bold;
            margin-right: 12px;
        }

        /* Pricing Badge */
        .pricing-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 12px;
            background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
            color: white;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-left: 8px;
        }
    </style>
</head>

