    <meta name="description"
        content="Forgot your UPIExpress password? Reset it securely in minutes. Enter your email to receive password reset instructions.">
    <meta name="keywords" content="forgot password, password reset, account recovery">
    <link rel="canonical" href="https://upiexpress.com/forget-pass">
    <meta name="robots" content="noindex, nofollow">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter&amp;display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/icon.png" type="image/png">
    <!-- Google tag (gtag.js) -->
