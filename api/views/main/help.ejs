    <!-- Frequently Asked Questions -->
    <section class="section-padding bg-white">
        <div class="container mx-auto px-4 sm:px-6">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-2xl font-bold text-gray-800 mb-2 text-center fade-in">Frequently Asked Questions</h2>
                <p class="text-gray-600 text-center mb-10 fade-in">Quick answers to the most common questions</p>

                <div class="space-y-1 fade-in">
                    <!-- FAQ Item 1 -->
                    <div class="faq-item">
                        <div class="faq-question flex justify-between items-center" data-faq="1">
                            <h3 class="text-lg font-medium text-gray-800">How do I generate my first QR code?</h3>
                            <i class="fas fa-chevron-down faq-toggle text-[var(--primary)]"></i>
                        </div>
                        <div class="faq-answer" id="faq-1">
                            <p class="text-gray-600 mb-3">To generate your first QR code:</p>
                            <ol class="list-decimal pl-5 text-gray-600 space-y-2">
                                <li>Sign up for a UPIExpress account</li>
                                <li>Navigate to the QR Code Generator in your dashboard</li>
                                <li>Enter the payment amount and other details</li>
                                <li>Click "Generate QR Code"</li>
                                <li>Download or embed the QR code as needed</li>
                            </ol>
                            <p class="text-gray-600 mt-3">For detailed instructions, check our <a href="/doc/getting-started" class="text-[var(--primary)] hover:underline">Getting Started guide</a>.</p>
                        </div>
                    </div>

                    <!-- FAQ Item 2 -->
                    <div class="faq-item">
                        <div class="faq-question flex justify-between items-center" data-faq="2">
                            <h3 class="text-lg font-medium text-gray-800">How are payments verified?</h3>
                            <i class="fas fa-chevron-down faq-toggle text-[var(--primary)]"></i>
                        </div>
                        <div class="faq-answer" id="faq-2">
                            <p class="text-gray-600 mb-3">UPIExpress uses multiple methods to verify payments:</p>
                            <ul class="list-disc pl-5 text-gray-600 space-y-2">
                                <li><strong>Real-time UPI Verification:</strong> Instant verification through UPI network</li>
                                <li><strong>Webhook Notifications:</strong> Instant callback to your server</li>
                                <li><strong>Manual Verification:</strong> Check transaction status in dashboard</li>
                                <li><strong>Settlement Reports:</strong> Daily settlement confirmations</li>
                            </ul>
                            <p class="text-gray-600 mt-3">Payments typically verify within 2-5 seconds. If verification fails, check our <a href="/doc/troubleshooting" class="text-[var(--primary)] hover:underline">troubleshooting guide</a>.</p>
                        </div>
                    </div>

                    <!-- FAQ Item 3 -->
                    <div class="faq-item">
                        <div class="faq-question flex justify-between items-center" data-faq="3">
                            <h3 class="text-lg font-medium text-gray-800">What is the difference between static and dynamic QR codes?</h3>
                            <i class="fas fa-chevron-down faq-toggle text-[var(--primary)]"></i>
                        </div>
                        <div class="faq-answer" id="faq-3">
                            <p class="text-gray-600 mb-3">Here are the key differences:</p>
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead>
                                        <tr>
                                            <th class="px-4 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Feature</th>
                                            <th class="px-4 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Static QR</th>
                                            <th class="px-4 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dynamic QR</th>
