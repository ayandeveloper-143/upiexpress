    <style>
        :root {
            --primary: #181a20;
            --primary-light: #1e2329;
            --primary-dark: #2b3139;
            --primary-transparent: rgba(0, 0, 0, 0.1);
            --dark-1: #181a20;
            --dark-2: #1e2329;
            --dark-3: #2b3139;
            --light-1: #eaecef;
            --light-2: #b7bdc6;
            --light-3: #848e9c;
        }

        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden !important;
            width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: "Inter", sans-serif;
        }

        .btn-theme {
            background-color: var(--primary);
            color: var(--light-1);
            border: 1px solid var(--primary-dark);
        }

        .btn-theme:hover {
            background-color: var(--primary-light);
            color: var(--light-1);
        }

        .btn-outline-theme {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-outline-theme:hover {
            background-color: var(--primary-transparent);
            color: var(--primary-dark);
        }

        .section-padding {
            padding: 3rem 0;
        }

        /* Mobile Menu Styles */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: white;
            z-index: 1000;
            padding: 80px 20px 20px;
            transform: translateX(-100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.1);
        }

        .mobile-menu.active {
            transform: translateX(0);
        }

        .mobile-menu nav {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .mobile-menu a {
            font-size: 18px;
            padding: 16px 0;
            border-bottom: 1px solid #f0f0f0;
            display: block;
            transition: all 0.3s ease;
            transform: translateX(-20px);
            opacity: 0;
        }

        .mobile-menu.active a {
            transform: translateX(0);
            opacity: 1;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1001;
        }

        .close-menu {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1002;
        }

        .menu-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .menu-backdrop.active {
            display: block;
            opacity: 1;
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }

            .desktop-nav {
                display: none !important;
            }

            .header-buttons {
                display: none !important;
            }

            .header-logo {
                margin-right: auto;
            }

            .container {
                padding-left: 16px;
                padding-right: 16px;
            }

            .section-padding {
                padding: 2rem 0;
            }

            h1 {
                font-size: 2rem !important;
                line-height: 1.2 !important;
            }

            h2 {
                font-size: 1.75rem !important;
            }

            .btn-theme,
            .btn-outline-theme {
                padding: 14px 20px !important;
                font-size: 16px !important;
                width: 100%;
                text-align: center;
            }

            .flex-col {
                gap: 12px;
            }

            .section-padding {
                padding: 1.5rem 0;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 1.75rem !important;
            }

            h2 {
                font-size: 1.5rem !important;
            }

            .section-padding {
                padding: 1rem 0;
            }
        }

        /* Help Page Specific Styles */
        .help-card {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid rgb(226 232 240 / var(--tw-border-opacity, 1));
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }

        .help-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .faq-item {
            border-bottom: 1px solid #e5e7eb;
        }

        .faq-item:last-child {
            border-bottom: none;
        }

        .faq-question {
            cursor: pointer;
            padding: 1.5rem 0;
            position: relative;
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
            padding: 0 0;
        }

        .faq-answer.active {
            max-height: 500px;
            padding-bottom: 1.5rem;
        }

        .faq-toggle {
            transition: transform 0.3s ease;
        }

        .faq-toggle.active {
            transform: rotate(180deg);
        }

        .search-box {
            position: relative;
            max-width: 600px;
            margin: 0 auto;
        }

        .search-box input {
            padding-right: 3rem;
        }

        .search-icon {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--light-3);
        }

        .category-tab {
            padding: 0.75rem 1.5rem;
            border-radius: 9999px;
            transition: all 0.3s ease;
            cursor: pointer;
            white-space: nowrap;
        }

        .category-tab.active {
            background-color: var(--primary);
            color: white;
        }

        .resource-tag {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: #e0f2fe;
            color: #0369a1;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }

        /* Animation Classes */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .slide-in-left {
            opacity: 0;
            transform: translateX(-50px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .slide-in-left.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .slide-in-right {
            opacity: 0;
            transform: translateX(50px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .slide-in-right.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .scale-in {
            opacity: 0;
            transform: scale(0.8);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .scale-in.visible {
            opacity: 1;
            transform: scale(1);
        }

        .stagger-item {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .stagger-item.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Mobile Menu Login Button Fix */
        .mobile-menu .btn-outline-theme {
            border: 1px solid var(--primary) !important;
            background-color: transparent;
            color: var(--primary);
            display: block;
            text-align: center;
            margin-bottom: 12px;
        }

        footer {
            overflow-x: hidden !important;
            width: 100vw !important;
        }

        footer input[type="email"] {
            min-width: 0;
        }
    </style>
</head>

