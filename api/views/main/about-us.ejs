    <!-- Our Journey -->
    <section id="our-journey" class="section-padding bg-white">
        <div class="container mx-auto px-4 sm:px-6">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">Our Journey</h2>
                <p class="text-base md:text-lg text-gray-600">From a simple idea to India's fastest-growing payment
                    platform</p>
            </div>

            <div class="company-timeline">
                <!-- 2019 -->
                <div class="timeline-container left">
                    <div class="timeline-content">
                        <h3 class="text-xl font-bold text-gray-800 mb-2">2023</h3>
                        <div class="text-sm text-gray-500 mb-3">The Beginning</div>
                        <p class="text-gray-600">UPIExpress was founded by a team of payment industry veterans who saw
                            the need for affordable digital payment solutions for small businesses.</p>
                    </div>
                </div>

                <!-- 2020 -->
                <div class="timeline-container right">
                    <div class="timeline-content">
                        <h3 class="text-xl font-bold text-gray-800 mb-2">2023</h3>
                        <div class="text-sm text-gray-500 mb-3">First Breakthrough</div>
                        <p class="text-gray-600">Launched our MVP and onboarded our first 100 merchants. Processed ₹1
                            crore in transaction volume within the first year.</p>
