    <!-- Mission & Vision -->
    <section class="mission-section section-padding">
        <div class="container mx-auto px-4 sm:px-6 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Our Mission</h2>
                    <p class="text-white text-opacity-90 text-lg mb-6">
                        To democratize digital payments in India by making them accessible, affordable, and secure for
                        businesses of all sizes. We believe that every merchant, from street vendors to large
                        enterprises, should have access to modern payment solutions without the burden of high
                        transaction fees.
                    </p>
                    <p class="text-white text-opacity-90 text-lg">
