    <style>
        :root {
            --primary: #181a20;
            --primary-light: #1e2329;
            --primary-dark: #2b3139;
            --primary-transparent: rgba(0, 0, 0, 0.1);
            --dark-1: #181a20;
            --dark-2: #1e2329;
            --dark-3: #2b3139;
            --light-1: #eaecef;
            --light-2: #b7bdc6;
            --light-3: #848e9c;
        }

        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden !important;
            width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: "Inter", sans-serif;
        }

        .btn-theme {
            background-color: var(--primary);
            color: var(--light-1);
            border: 1px solid var(--primary-dark);
        }

        .btn-theme:hover {
            background-color: var(--primary-light);
            color: var(--light-1);
        }

        .btn-outline-theme {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-outline-theme:hover {
            background-color: var(--primary-transparent);
            color: var(--primary-dark);
        }

        .link-theme {
            color: var(--primary);
        }

        .link-theme:hover {
            color: var(--primary-light);
            text-decoration: underline;
        }

        .hero-bg {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        }

        .section-padding {
            padding: 3rem 0;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Use Cases Styles */
        .use-case-card {
            transition: all 0.3s ease;
            border: 1px solid #e5e7eb;
            background: white;
            overflow: hidden;
            border-radius: 12px;
            height: 100%;
        }

        .use-case-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            border-color: var(--primary);
        }

        .case-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .icon-ecommerce {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .icon-retail {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .icon-ott {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .icon-education {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        }

        .icon-healthcare {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        }

        .icon-saas {
            background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);
        }

        .icon-services {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        }

        .icon-travel {
            background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
        }

        .icon-b2b {
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
        }

        .industry-badge {
            display: inline-block;
            padding: 4px 12px;
            background: var(--primary-transparent);
            color: var(--primary);
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-right: 8px;
            margin-bottom: 8px;
        }

        /* Statistics Cards */
        .stat-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* Implementation Steps */
        .step-container {
            position: relative;
            padding-left: 50px;
        }

        .step-container::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, var(--primary), var(--primary-light));
        }

        .step-number {
            position: absolute;
            left: 0;
            top: 0;
            width: 40px;
            height: 40px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            z-index: 1;
        }

        /* Testimonial Styles */
        .testimonial-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 2rem;
            position: relative;
        }

        .testimonial-card::before {
            content: '"';
            position: absolute;
            top: 20px;
            left: 20px;
            font-size: 60px;
            color: var(--primary-transparent);
            font-family: serif;
            line-height: 1;
        }

        /* Mobile Menu Styles */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: white;
            z-index: 1000;
            padding: 80px 20px 20px;
            transform: translateX(-100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.1);
        }

        .mobile-menu.active {
            transform: translateX(0);
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1001;
        }

        .close-menu {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-dark);
            z-index: 1002;
        }

        /* Responsive styles */
        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }

            .desktop-nav {
                display: none !important;
            }

            .header-buttons {
                display: none !important;
            }

            .section-padding {
                padding: 2rem 0;
            }

            h1 {
                font-size: 2rem !important;
            }

            h2 {
                font-size: 1.75rem !important;
            }

            .use-case-card {
                margin-bottom: 1.5rem;
            }

            .stat-card {
                margin-bottom: 1rem;
            }

            .step-container {
                padding-left: 30px;
                margin-bottom: 2rem;
            }

            .step-container::before {
                left: 15px;
            }

            .step-number {
                width: 30px;
                height: 30px;
                left: 0;
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 1.75rem !important;
            }

            h2 {
                font-size: 1.5rem !important;
            }

            .testimonial-card {
                padding: 1.5rem;
            }
        }

        /* Animation for stats */
        @keyframes countUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stat-number {
            animation: countUp 1s ease-out;
        }

        /* Filter buttons */
        .filter-btn {
            padding: 8px 20px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 25px;
            color: var(--light-3);
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* Benefit icons */
        .benefit-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--primary-transparent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }

        /* Case study preview */
        .case-study-preview {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
        }

        .case-study-preview::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23000' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.1;
        }
    </style>
</head>

