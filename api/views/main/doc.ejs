            cursor: pointer;
            font-size: 12px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .code-block:hover .copy-btn {
            opacity: 1;
        }

        .copy-btn:hover {
            background: var(--primary-dark);
        }

        .copy-btn.copied {
            background: #10b981;
        }

        /* Additional responsive adjustments */
        @media (max-width: 1024px) {
            .docs-sidebar {
                position: static;
                max-height: none;
                margin-bottom: 2rem;
                padding-right: 0;
