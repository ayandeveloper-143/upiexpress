        <script>
            // Reset API Modal Functionality
            function openResetApiModal() {
                document.getElementById('resetApiModal').classList.remove('hidden');
            }

            // Show success message
            function showSuccess(message) {
                successMessageText.textContent = message;
                successMessage.classList.remove('hidden');
                setTimeout(() => {
                    successMessage.classList.add('hidden');
                }, 5000);
            }

            // Copy API Key Function
            function copyApiKey() {
                const apiKeyInput = document.getElementById('apikeyInput');
                const apiKey = apiKeyInput.value;

                // Copy to clipboard using the modern Clipboard API
                navigator.clipboard.writeText(apiKey).then(() => {
                    showSuccess('API key copied to clipboard!');
                }).catch(() => {
                    showSuccess('API key copied to clipboard!');
                });
            }
        </script>
        <script type="module">
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebar');
            const profileDropdown = document.getElementById('profileDropdown');
            const dropdownMenu = document.getElementById('dropdownMenu');
            const mobileHamburger = document.getElementById('mobileHamburger');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileSidebarClose = document.getElementById('mobileSidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            let hoverEnabled = false;
            let isCollapsed = false;

            // Desktop sidebar toggle
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }


            // Mobile sidebar toggle
            if (mobileHamburger) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            // Close mobile sidebar
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Profile dropdown functionality
            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            // Close mobile sidebar when clicking menu items
            const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });

            function openResetApiModal() {
                document.getElementById('resetApiModal').classList.remove('hidden');
            }

            // Loading, Error, and Success Message Elements
            const loadingElement = document.getElementById('loading');
            const errorMessages = document.getElementById('errorMessages');
            const errorMessageText = document.getElementById('errorMessageText');
            const errorClose = document.getElementById('errorClose');
            const successMessage = document.getElementById('successMessage');
            const successMessageText = document.getElementById('successMessageText');
            const successClose = document.getElementById('successClose');

            // Show/hide loading spinner
            function showLoading() {
                loadingElement.classList.remove('hidden');
            }

            function hideLoading() {
                loadingElement.classList.add('hidden');
            }

            // Show error message
            function showError(message) {
                errorMessageText.textContent = message;
                errorMessages.classList.remove('hidden');
                setTimeout(() => {
                    errorMessages.classList.add('hidden');
                }, 5000);
            }

            // Show success message
            function showSuccess(message) {
                successMessageText.textContent = message;
                successMessage.classList.remove('hidden');
                setTimeout(() => {
                    successMessage.classList.add('hidden');
                }, 5000);
            }

            // Close button event listeners
            if (errorClose) {
                errorClose.addEventListener('click', () => {
                    errorMessages.classList.add('hidden');
                });
            }

            if (successClose) {
                successClose.addEventListener('click', () => {
                    successMessage.classList.add('hidden');
                });
            }

            // Reset API Key Functionality
            document.getElementById('confirmResetBtn').addEventListener('click', async function () {
                const csrfToken = "<%= csrfToken %>";
                const modal = document.getElementById('resetApiModal');

                showLoading();

                try {
                    const response = await fetch('/api/user/settings/update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            type: 'reset_key'
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        modal.classList.add('hidden');
                        showSuccess('API key reset successfully!');
                        // Update the API key in the input field if needed
                        document.querySelector('input[value="<%= user.apikey %>"]').value = result.apikey;
                    } else {
                        showError(result.message || 'Failed to reset API key');
                    }
                } catch (error) {
                    showError('Network error: Failed to reset API key');
                    console.error('Error:', error);
                } finally {
                    hideLoading();
                }
            });

            // Update Webhook URL Functionality - SPECIFICALLY target the Update button
            document.querySelector('.bg-white.border.border-gray-200.rounded-xl.p-6.mt-6:last-child .button2').addEventListener('click', async function () {
                const csrfToken = "<%= csrfToken %>";
                const webhookInput = document.querySelector('input[placeholder="https://yourdomain.com/webhook"]');
                const webhookUrl = webhookInput.value.trim();

                // Basic URL validation
                if (!webhookUrl) {
                    showError('Please enter a webhook URL');
                    return;
                }

                if (!webhookUrl.startsWith('http://') && !webhookUrl.startsWith('https://')) {
                    showError('URL must include protocol (http:// or https://)');
                    return;
                }

                showLoading();

                try {
                    const response = await fetch('/api/user/settings/update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            type: 'update_webhook',
                            webhookUrl: webhookUrl
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showSuccess('Webhook URL updated successfully!');
                        // Update the webhook URL in the input field if needed
                        webhookInput.value = result.webhookUrl || webhookUrl;
                    } else {
                        showError(result.message || 'Failed to update webhook URL');
                    }
                } catch (error) {
                    showError('Network error: Failed to update webhook URL');
                    console.error('Error:', error);
                } finally {
                    hideLoading();
                }
            });
            // Close modal when clicking cancel
            document.getElementById('cancelResetBtn').addEventListener('click', function () {
                document.getElementById('resetApiModal').classList.add('hidden');
            });





        </script>



</body>

</html>