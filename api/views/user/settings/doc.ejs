        }

        .animate-spin {
            animation: spin 2s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Mobile Hamburger */
        .mobile-hamburger {
            display: none;
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            color: #374151;
            border-radius: 6px;
