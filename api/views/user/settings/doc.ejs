        }

        .header-item:hover {
            background: rgba(24, 26, 32, 0.1);
        }

        .header-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Mobile Responsive Styles */
        @media (max-width: 768px) {
            .flex.items-start {
                flex-direction: column;
            }

            .mr-9.ml-9 {
                margin: 0 auto 20px;
            }

