        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .mobile-hamburger {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .header-item {
                display: flex;
                padding: 6px;
            }

            .header-item .header-text {
                display: none;
            }

            .header-brand {
                display: none;
            }

            .brand-subtext {
                display: none;
            }

            .dropdown-menu {
                width: auto;
                right: -10px;
            }

            .header-left {
                gap: 0;
            }
        }

        @media (min-width: 769px) {

            .mobile-sidebar,
            .sidebar-overlay {
                display: none !important;
            }
        }

        /* Header Right Section - Responsive Behavior */
        @media (max-width: 1024px) {
            .header-item .header-text {
                display: none;
            }

            .header-item {
