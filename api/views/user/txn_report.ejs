                                <rect x="486" y="540" width="233.33" height="233.33" rx="61" fill="#848e9c"></rect>
                                <path
                                    d="M620.722 656.478L660.261 616.954C665.246 611.97 665.246 603.721 660.261 598.738C655.276 593.754 647.024 593.754 642.039 598.738L602.5 638.263L562.961 598.738C557.976 593.754 549.724 593.754 544.739 598.738C539.754 603.721 539.754 611.97 544.739 616.954L584.278 656.478L544.739 696.003C539.754 700.987 539.754 709.236 544.739 714.219C547.318 716.797 550.584 718 553.85 718C557.116 718 560.382 716.797 562.961 714.219L602.5 674.694L642.039 714.219C644.617 716.797 647.884 718 651.15 718C654.416 718 657.682 716.797 660.261 714.219C665.246 709.236 665.246 700.987 660.261 696.003L620.722 656.478Z"
                                    fill="white"></path>
                            </svg>
                            <div class="text-xl font-medium">No Transactions Found</div>
                            <div class="text-sm mt-2 text-gray-500">Try adjusting your search criteria to find what
                                you're looking for.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Legend -->
            <div class="border border-gray-200 rounded-xl p-5 mt-5 bg-white">
                <p class="text-sm text-gray-700">
                    <span class="text-yellow-600">Pending</span> :
                    Transaction is awaiting processing or user action
                </p>

                <p class="text-sm mt-1 text-gray-700">
                    <span class="text-green-600">Success</span> :
                    Transaction successfully completed
                </p>

                <p class="text-sm mt-1 text-gray-700">
                    <span class="text-red-600">Failed</span> :
                    Transaction incomplete or failed
                </p>

                <p class="text-sm mt-1 text-gray-700">
                    <span class="text-red-500">Cancel</span> :
                    User declined transaction or cancelled the request
                </p>

                <p class="text-sm mt-1 text-gray-700">
                    <span class="text-gray-600">Expired</span> :
                    Transaction request expired
                </p>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-content">
                <div class="footer-left">
                    <p class="text-gray-600">&copy; 2025 UPI Express. All rights reserved.</p>
                </div>
                <div class="footer-right">
                    <a href="/terms" class="footer-link text-[var(--primary)]">Terms of Service</a>
                    <a href="/privacy" class="footer-link text-[var(--primary)]">Privacy Policy</a>
                    <a href="/contact-us" class="footer-link text-[var(--primary)]">Contact Us</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Get CSRF Token
        const csrfToken = "<%= csrfToken %>";

        // Get form input elements using more reliable selectors
        const searchFilter = document.querySelector('.search-filter');
        const dateInputs = searchFilter.querySelectorAll('input[type="date"]');
        const textInputs = searchFilter.querySelectorAll('input[type="text"]');
        const statusSelect = searchFilter.querySelector('select');

        const fromDateInput = dateInputs[0];
        const toDateInput = dateInputs[1];
        const amountInput = textInputs[0];
        const clientTxnIdInput = textInputs[1];
        const customerPhoneInput = textInputs[2];
        const noteInput = textInputs[3];

        const searchBtn = document.getElementById('searchBtn');
        const resetBtn = document.getElementById('resetBtn');
        const exportBtn = document.getElementById('exportBtn');

        // Store last search results for export
        let lastSearchResults = null;

        // Set default dates (Last 7 days)
        function setDefaultDates() {
            const today = new Date();
            const sevenDaysAgo = new Date(today.getTime() - (7 * 24 * 60 * 60 * 1000));

            // Format dates as YYYY-MM-DD
            const formatDate = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            };

            fromDateInput.value = formatDate(sevenDaysAgo);
            toDateInput.value = formatDate(today);
        }

        // Call on page load
        setDefaultDates();

        // Function to fetch transactions without filters
        async function fetchTransactionsOnLoad() {
            try {
                const response = await fetch('/api/user/transactions/search', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        fromDate: null,
                        toDate: null,
                        status: null,
                        amount: null,
                        clientTxnId: null,
                        customerMobile: null,
                        note: null
                    })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    lastSearchResults = data.data;
                    // Display only first 50 transactions
                    const first50Transactions = data.data.slice(0, 50);
                    renderTransactionList(first50Transactions);
                } else {
                    console.error('API Error:', data.message);
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }

        // Call API on page load
        document.addEventListener('DOMContentLoaded', fetchTransactionsOnLoad);

        // Helper function to show error toast
        function showErrorToast(message) {
            const errorMessages = document.getElementById('errorMessages');
            const errorMessageText = document.getElementById('errorMessageText');
            const toastBox = errorMessages.querySelector('.error-animate');

            errorMessageText.textContent = message;
            errorMessages.classList.remove('hidden');
            toastBox.classList.add('show');

            setTimeout(() => {
                toastBox.classList.remove('show');
                setTimeout(() => errorMessages.classList.add('hidden'), 400);
            }, 3000);
        }

        // Helper function to show success toast
        function showSuccessToast(message) {
            const successMessage = document.getElementById('successMessage');
            const successMessageText = document.getElementById('successMessageText');
            const toastBox = successMessage.querySelector('.error-animate');

            successMessageText.textContent = message;
            successMessage.classList.remove('hidden');
            toastBox.classList.add('show');

            setTimeout(() => {
                toastBox.classList.remove('show');
                setTimeout(() => successMessage.classList.add('hidden'), 400);
            }, 3000);
        }

        // Search button click handler
        if (searchBtn) {
            searchBtn.addEventListener('click', async function () {
                // Prepare filter data
                const bodyData = {
                    fromDate: fromDateInput?.value || null,
                    toDate: toDateInput?.value || null,
                    status: statusSelect?.value !== 'Select Status' ? statusSelect?.value : null,
                    amount: amountInput?.value || null,
                    clientTxnId: clientTxnIdInput?.value || null,
                    customerMobile: customerPhoneInput?.value || null,
                    note: noteInput?.value || null
                };

                try {
                    const response = await fetch('/api/user/transactions/search', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify(bodyData)
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        console.log('API Response:', data);
                        lastSearchResults = data.data;
                        renderTransactionList(data.data);
                    } else {
                        console.error('Error:', data.message || 'Unknown error');
                        showErrorToast(data.message || 'Failed to fetch transactions');
                    }
                } catch (error) {
                    console.error('Fetch error:', error);
                    showErrorToast('Failed to search transactions');
                }
            });
        }

        // Export button click handler
        if (exportBtn) {
            exportBtn.addEventListener('click', function () {
                if (!lastSearchResults || lastSearchResults.length === 0) {
                    showErrorToast('No data to export. Please search first.');
                    return;
                }

                exportToCSV(lastSearchResults);
            });
        }

        // Function to export transactions to CSV (works without external libraries)
        function exportToCSV(transactions) {
            if (!transactions || transactions.length === 0) {
                showErrorToast('No transactions to export.');
                return;
            }

            try {
                // Define CSV headers
                const headers = [
                    'Order ID',
                    'Amount',
                    'Convenience Fee',
                    'Total',
                    'Client Txn ID',
                    'Customer Mobile',
                    'Status',
                    'Webhook Status',
                    'Note',
                    'Date'
                ];

                // Create CSV rows
                const rows = transactions.map(txn => [
                    escapeCSV(txn.orderid || txn.order_id || txn.txn_id || 'N/A'),
                    escapeCSV(txn.amount || 'N/A'),
                    escapeCSV(txn.convenience_fee || 'N/A'),
                    escapeCSV((parseFloat(txn.amount) + parseFloat(txn.convenience_fee)).toFixed(2) || 'N/A'),
                    escapeCSV(txn.client_txn_id || 'N/A'),
                    escapeCSV(txn.customer_mobile || 'N/A'),
                    escapeCSV(txn.status || 'N/A'),
                    escapeCSV(txn.webhook_status || 'N/A'),
                    escapeCSV(txn.note || 'N/A'),
                    escapeCSV(new Date(txn.created_at).toLocaleString('en-IN') || 'N/A')
                ]);

                // Combine headers and rows
                const csvContent = [
                    headers.join(','),
                    ...rows.map(row => row.join(','))
                ].join('\n');

                // Create blob and download
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                const url = URL.createObjectURL(blob);

                // Generate filename with date
                const now = new Date();
                const filename = `transactions_${now.toISOString().slice(0, 10)}_${now.getTime()}.csv`;

                link.setAttribute('href', url);
                link.setAttribute('download', filename);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                showSuccessToast('Export successful! File downloaded.');
            } catch (error) {
                console.error('Export error:', error);
                showErrorToast('Error exporting file: ' + error.message);
            }
        }

        // Helper function to escape CSV special characters
        function escapeCSV(value) {
            if (value === null || value === undefined) {
                return '';
            }
            const stringValue = String(value);
            if (stringValue.includes(',') || stringValue.includes('"') || stringValue.includes('\n')) {
                return `"${stringValue.replace(/"/g, '""')}"`;
            }
            return stringValue;
        }

        // Function to update stats based on transactions
        function updateStats(transactions) {
            let totalAmount = 0;
            let successCount = 0;
            let failedCount = 0;

            if (transactions && transactions.length > 0) {
                transactions.forEach((txn) => {
                    const status = txn.status ? txn.status.trim().toLowerCase() : '';
                    const amount = parseFloat(txn.amount) || 0;
                    const camount = parseFloat(txn.convenience_fee) || 0;

                    // Only add to total if status is Success
                    if (status === 'success') {
                        totalAmount += amount + camount;
                        successCount++;
                    } else if (status === 'failed' || status === 'cancel' || status === 'expired') {
                        failedCount++;
                    }
                });
            }

            // Update stats display
            document.getElementById('totalAmount').textContent = '₹' + totalAmount.toFixed(2);
            document.getElementById('successCount').textContent = successCount;
            document.getElementById('failedCount').textContent = failedCount;
        }

        // Function to render transaction list dynamically
        function renderTransactionList(transactions) {
            const transactionList = document.querySelector('.transaction-list');
            transactionList.innerHTML = '';

            if (!transactions || transactions.length === 0) {
                transactionList.innerHTML = `
                    <div class="p-6 flex items-center justify-center">
                        <div class="text-center">
                            <svg class="mb-3 mx-auto mb-4 " width="100" height="100" viewBox="0 0 800 800" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M541.305 121.663H258.637C176.303 121.663 109.637 188.663 109.637 270.663V584.33C109.637 666.33 176.637 733.33 258.637 733.33H540.971C623.305 733.33 689.971 666.33 689.971 584.33V270.663C690.305 188.33 623.305 121.663 541.305 121.663Z"
                                    fill="#b7bdc6"></path>
                                <path
                                    d="M478.328 66.6667H321.66C286.993 66.6667 258.66 94.6668 258.66 129.333V160.667C258.66 195.333 286.66 223.333 321.327 223.333H478.328C512.994 223.333 540.994 195.333 540.994 160.667V129.333C541.328 94.6668 512.994 66.6667 478.328 66.6667Z"
                                    fill="#848e9c"></path>
                                <path
                                    d="M500.001 431.673H266.668C253.001 431.673 241.668 420.34 241.668 406.673C241.668 393.007 253.001 381.673 266.668 381.673H500.001C513.668 381.673 525.001 393.007 525.001 406.673C525.001 420.34 513.668 431.673 500.001 431.673Z"
                                    fill="#848e9c"></path>
                                <path
                                    d="M412.668 565.007H266.668C253.001 565.007 241.668 553.673 241.668 540.007C241.668 526.34 253.001 515.007 266.668 515.007H412.668C426.335 515.007 437.668 526.34 437.668 540.007C437.668 553.673 426.335 565.007 412.668 565.007Z"
                                    fill="#848e9c"></path>
                                <rect x="486" y="540" width="233.33" height="233.33" rx="61" fill="#848e9c"></rect>
                                <path
                                    d="M620.722 656.478L660.261 616.954C665.246 611.97 665.246 603.721 660.261 598.738C655.276 593.754 647.024 593.754 642.039 598.738L602.5 638.263L562.961 598.738C557.976 593.754 549.724 593.754 544.739 598.738C539.754 603.721 539.754 611.97 544.739 616.954L584.278 656.478L544.739 696.003C539.754 700.987 539.754 709.236 544.739 714.219C547.318 716.797 550.584 718 553.85 718C557.116 718 560.382 716.797 562.961 714.219L602.5 674.694L642.039 714.219C644.617 716.797 647.884 718 651.15 718C654.416 718 657.682 716.797 660.261 714.219C665.246 709.236 665.246 700.987 660.261 696.003L620.722 656.478Z"
                                    fill="white"></path>
                            </svg>
                            <div class="text-xl font-medium">No Transactions Found</div>
                            <div class="text-sm mt-2 text-gray-500">Try adjusting your search criteria to find what you're looking for.</div>
                        </div>
                    </div>
                `;
                updateStats(null);
                return;
            }

            // Update stats based on transactions
            updateStats(transactions);

            transactions.forEach((txn, index) => {
                const statusClass = getStatusClass(txn.status);
                const webhookClass = getWebhookClass(txn.webhook_status);
                const formattedDate = new Date(txn.created_at).toLocaleString('en-IN');
                const formattedAmount = parseFloat(txn.amount).toFixed(2);

                const transactionRow = document.createElement('div');
                transactionRow.className = 'transaction-row';
                transactionRow.innerHTML = `
                    <div class="transaction-header flex justify-between items-center">
                        <div class="flex items-center space-x-4">
                            <div>
                                <p class="font-medium text-gray-900">₹${formattedAmount}</p>
                                <p class="text-sm text-gray-500">${txn.orderid || txn.order_id || txn.txn_id}</p>
                            </div>
                            <span class="status-badge ${statusClass}">${txn.status}</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-sm text-gray-500">${formattedDate}</span>
                            <button class="view-details-btn text-blue-600 hover:text-blue-800">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="transaction-details">
                        <div class="transaction-main">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="detail-row">
                                    <span class="detail-label">Client Txn ID:</span>
                                    <span class="detail-value">${txn.client_txn_id || 'N/A'}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Customer Mobile:</span>
                                    <span class="detail-value">${txn.customer_mobile || 'N/A'}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Total Amount:</span>
                                    <span class="detail-value">₹${formattedAmount}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Convenience Fee:</span>
                                    <span class="detail-value">₹${parseFloat(txn.convenience_fee).toFixed(2)}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Status:</span>
                                    <span class="detail-value">
                                        <span class="status-badge ${statusClass}">${txn.status}</span>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Webhook Status:</span>
                                    <span class="detail-value">
                                        <span class="status-badge ${webhookClass}">${txn.webhook_status}</span>
                                    </span>
                                </div>
                                <div class="detail-row md:col-span-2">
                                    <span class="detail-label">Note:</span>
                                    <span class="detail-value">${txn.note || 'N/A'}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                transactionList.appendChild(transactionRow);
            });

            // Re-attach click handlers to new view details buttons
            document.querySelectorAll('.view-details-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const transactionRow = this.closest('.transaction-row');
                    const isExpanded = transactionRow.classList.contains('expanded');

                    document.querySelectorAll('.transaction-row.expanded').forEach(row => {
                        if (row !== transactionRow) {
                            row.classList.remove('expanded');
                            const icon = row.querySelector('.view-details-btn svg');
                            icon.style.transform = 'rotate(0deg)';
                        }
                    });

                    transactionRow.classList.toggle('expanded');
                    const icon = this.querySelector('svg');

                    if (isExpanded) {
                        icon.style.transform = 'rotate(0deg)';
                    } else {
                        icon.style.transform = 'rotate(180deg)';
                    }
                });
            });
        }

        // Helper function to get status badge class
        function getStatusClass(status) {
            switch (status) {
                case 'Success':
                    return 'status-success';
                case 'Pending':
                case 'Scanning':
                    return 'status-pending';
                case 'Failed':
                    return 'status-failed';
                case 'Cancel':
                case 'Close':
                    return 'status-cancel';
                case 'Expired':
                    return 'status-expired';
                default:
                    return 'status-cancel';
            }
        }

        // Helper function to get webhook status badge class
        function getWebhookClass(webhookStatus) {
            switch (webhookStatus) {
                case 'Sent':
                    return 'webhook-sent';
                case 'Pending':
                    return 'webhook-pending';
                case 'Failed':
                    return 'webhook-failed';
                default:
                    return 'webhook-pending';
            }
        }

        // Reset button click handler
        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                setDefaultDates();
                statusSelect.value = 'Select Status';
                amountInput.value = '';
                clientTxnIdInput.value = '';
                customerPhoneInput.value = '';
                noteInput.value = '';
            });
        }

        // Toggle transaction details
        document.querySelectorAll('.view-details-btn').forEach(button => {
            button.addEventListener('click', function () {
                const transactionRow = this.closest('.transaction-row');
                const isExpanded = transactionRow.classList.contains('expanded');

                // Close all other expanded rows
                document.querySelectorAll('.transaction-row.expanded').forEach(row => {
                    if (row !== transactionRow) {
                        row.classList.remove('expanded');
                        const icon = row.querySelector('.view-details-btn svg');
                        icon.style.transform = 'rotate(0deg)';
                    }
                });

                // Toggle current row
                transactionRow.classList.toggle('expanded');
                const icon = this.querySelector('svg');

                if (isExpanded) {
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    icon.style.transform = 'rotate(180deg)';
                }
            });
        });

        // Profile dropdown functionality
        const profileDropdown = document.getElementById('profileDropdown');
        const dropdownMenu = document.getElementById('dropdownMenu');

        if (profileDropdown && dropdownMenu) {
            profileDropdown.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            document.addEventListener('click', function () {
                dropdownMenu.classList.remove('show');
            });

            dropdownMenu.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        // Sidebar functionality
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        const mobileHamburger = document.getElementById('mobileHamburger');
        const mobileSidebar = document.getElementById('mobileSidebar');
        const mobileSidebarClose = document.getElementById('mobileSidebarClose');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        let hoverEnabled = false;
        let isCollapsed = false;

        // Desktop sidebar toggle
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                isCollapsed = !isCollapsed;

                if (isCollapsed) {
                    sidebar.classList.add('collapsed');
                    sidebar.classList.remove('hover-enabled');

                    setTimeout(() => {
                        sidebar.classList.add('hover-enabled');
                        hoverEnabled = true;
                    }, 1000);

                } else {
                    sidebar.classList.remove('collapsed');
                    sidebar.classList.remove('hover-enabled');
                    hoverEnabled = false;
                }
            });
        }

        // Mobile sidebar toggle
        if (mobileHamburger) {
            mobileHamburger.addEventListener('click', function () {
                mobileSidebar.classList.add('active');
                sidebarOverlay.classList.add('active');
            });
        }

        // Close mobile sidebar
        if (mobileSidebarClose) {
            mobileSidebarClose.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking overlay
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking menu items
        const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        });

        // Close error toast
        document.getElementById('errorClose').addEventListener('click', () => {
            const errorMessages = document.getElementById('errorMessages');
            const toastBox = errorMessages.querySelector('.error-animate');
            toastBox.classList.remove('show');
            setTimeout(() => errorMessages.classList.add('hidden'), 400);
        });

        // Close success toast
        document.getElementById('successClose').addEventListener('click', () => {
            const successMessage = document.getElementById('successMessage');
            const toastBox = successMessage.querySelector('.error-animate');
            toastBox.classList.remove('show');
            setTimeout(() => successMessage.classList.add('hidden'), 400);
        });
    </script>
</body>

</html>