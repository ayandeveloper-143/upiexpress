    <script type="module">
        // Toast Helper Function
        window.showToast = function showToast(message, type = 'error', duration = 3000) {
            const containerId = type === 'error' ? 'errorMessages' : 'successMessage';
            const textElementId = type === 'error' ? 'errorMessageText' : 'successMessageText';

            const container = document.getElementById(containerId);
            const textElement = document.getElementById(textElementId);
            const toastBox = container.querySelector('.error-animate');

            // Set the message
            textElement.textContent = message;

            // Show the container
            container.classList.remove('hidden');

            // Reset animation by removing and re-adding the class
            toastBox.classList.remove('show');
            void toastBox.offsetWidth; // Trigger reflow to restart animation

            // Auto-hide after specified duration
            setTimeout(() => {
                toastBox.classList.add('show');
                setTimeout(() => {
                    container.classList.add('hidden');
                }, 300);
            }, duration);
        };

        // Error Toast Close Button
        document.addEventListener('DOMContentLoaded', function () {
            const errorClose = document.getElementById('errorClose');
            const successClose = document.getElementById('successClose');

            if (errorClose) {
                errorClose.addEventListener('click', function () {
                    const errorMessages = document.getElementById('errorMessages');
                    const toastBox = errorMessages.querySelector('.error-animate');
                    toastBox.classList.add('show');
                    setTimeout(() => {
                        errorMessages.classList.add('hidden');
                    }, 300);
                });
            }

            if (successClose) {
                successClose.addEventListener('click', function () {
                    const successMessage = document.getElementById('successMessage');
                    const toastBox = successMessage.querySelector('.error-animate');
                    toastBox.classList.add('show');
                    setTimeout(() => {
                        successMessage.classList.add('hidden');
                    }, 300);
                });
            }
        });

        // KYC Popup Functions
        let kycOtpTimerInterval = null;
        window.xRequestId = null;
        window.captchaTxnId = null;
        window.transactionId = null;
        window.openKYC = async function openKYC() {
            try {
                showLoading();
                const csrfToken = "<%= csrfToken %>";

                // Call API to send OTP
                const response = await fetch('/api/user/kyc/get_capture', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    }
                });
                hideLoading();
                const data = await response.json();
                if (data.success) {
                    // Store request ID and transaction ID from capture response
                    // data.requestId contains the x-request-id
                    // data.data.transactionId contains the captcha transaction ID
                    window.xRequestId = data.requestId;
                    window.captchaTxnId = data.data.transactionId;
                    window.transactionId = data.data.transactionId;

                    // Set capture image
                    const captureImage = document.getElementById('captureImage');
                    captureImage.src = 'data:image/jpeg;base64,' + data.data.imageBase64;

                    // Open KYC Popup
                    openKycPopup();
                } else {
                    throw new Error(data.message || 'Failed to get capture image');
                }
            } catch (error) {
                console.error('Open KYC error:', error);
            }
        }

        // Show Loading Function
        window.showLoading = function showLoading() {
            const loading = document.getElementById('loading');
            if (loading) {
                loading.classList.remove('hidden');
            }
        }

        // Hide Loading Function
        window.hideLoading = function hideLoading() {
            const loading = document.getElementById('loading');
            if (loading) {
                loading.classList.add('hidden');
            }
        }
        // Open KYC Popup
        window.openKycPopup = function openKycPopup() {
            const kycPopup = document.getElementById('kycPopup');
            kycPopup.classList.remove('hidden');
            document.body.classList.add('modal-open');

            // Reset form
            resetKycForm();
        }

        // Close KYC Popup
        window.closeKycPopup = function closeKycPopup() {
            const kycPopup = document.getElementById('kycPopup');
            kycPopup.classList.add('hidden');
            document.body.classList.remove('modal-open');
            resetKycForm();
        }

        // Close KYC OTP Popup
        window.closeKycOtpPopup = function closeKycOtpPopup() {
            const kycOtpPopup = document.getElementById('kycOtpPopup');
            kycOtpPopup.classList.add('hidden');
            document.body.classList.remove('modal-open');
            resetKycOtpForm();
            clearKycOtpTimer();
        }



        // Close KYC Success Popup
        window.closeKycSuccessPopup = function closeKycSuccessPopup() {
            const kycSuccessPopup = document.getElementById('kycSuccessPopup');
            kycSuccessPopup.classList.add('hidden');
            document.body.classList.remove('modal-open');

            // Refresh the page or update KYC status
            location.reload();
        }

        // Handle KYC Action (Send OTP)
        window.handleKycAction = async function handleKycAction() {
            const aadhaarNumber = document.getElementById('aadhaarNumber').value;
            const captureInput = document.getElementById('captureInput').value;
            const aadhaarError = document.getElementById('aadhaarError');
            const captureError = document.getElementById('captureError');

            // Reset errors
            aadhaarError.classList.add('hidden');
            captureError.classList.add('hidden');

            // Validation
            let isValid = true;

            if (!aadhaarNumber || aadhaarNumber.length !== 12) {
                aadhaarError.textContent = 'Please enter valid 12-digit Aadhaar number';
                aadhaarError.classList.remove('hidden');
                isValid = false;
            }

            if (!captureInput) {
                captureError.textContent = 'Please enter capture text';
                captureError.classList.remove('hidden');
                isValid = false;
            }

            if (!isValid) return;

            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";

                // Call API to send OTP
                const response = await fetch('/api/user/kyc/generate_otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        uidNumber: aadhaarNumber,
                        captchaTxnId: window.captchaTxnId,
                        captchaValue: captureInput,
                        xRequestId: window.xRequestId
                    })
                });

                const data = await response.json();
                console.log('Send OTP response:', data);
                hideLoading();

                if (data.success) {
                    // Store OTP transaction ID from response for verification
                    // The response contains otpTxnId which we need for verification
                    if (data.data && data.data.otpTxnId) {
                        window.otpTxnId = data.data.otpTxnId;
                    }
                    if (data.transactionId) {
                        window.otpTransactionId = data.transactionId;
                    }

                    // Close KYC popup and open OTP popup
                    closeKycPopup();
                    openKycOtpPopup('An OTP has been sent to the mobile number linked with your Aadhaar.');

                } else {
                    window.showToast(data.message || 'Failed to send OTP', 'error', 3000);
                    throw new Error(data.message || 'Failed to send OTP');
                }
            } catch (error) {
                hideLoading();
                console.error('Send OTP error:', error);
                showToast(error.message || 'Error sending OTP. Please try again.', 'error', 3000);
            }
        }

        // Open KYC OTP Popup
        window.openKycOtpPopup = function openKycOtpPopup(message) {
            const kycOtpPopup = document.getElementById('kycOtpPopup');
            const kycOtpMessage = document.getElementById('kycOtpMessage');

            // Clear existing timer
            clearKycOtpTimer();

            kycOtpMessage.textContent = message;
            kycOtpPopup.classList.remove('hidden');
            document.body.classList.add('modal-open');

            // Start OTP timer
            startKycOtpTimer();
        }

        // Verify KYC OTP
        window.verifyKycOtp = async function verifyKycOtp() {
            const otp = document.getElementById('kycOtpInput').value;
            const kycOtpError = document.getElementById('kycOtpError');

            // Validation
            if (!otp || otp.length !== 6) {
                kycOtpError.textContent = 'Please enter valid 6-digit OTP';
                kycOtpError.classList.remove('hidden');
                return;
            }

            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";

                // Call API to verify OTP
                const response = await fetch('/api/user/kyc/verify_otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        otp: otp
                    })
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    // Close OTP popup and show success popup
                    closeKycOtpPopup();
                    openKycSuccessPopup();
                } else {
                    throw new Error(data.message || 'Invalid OTP');
                }
            } catch (error) {
                hideLoading();
                console.error('KYC OTP verification error:', error);

                kycOtpError.textContent = error.message || 'Invalid OTP. Please try again.';
                kycOtpError.classList.remove('hidden');
            }
        }

        // Resend KYC OTP
        window.resendKycOtp = async function resendKycOtp() {
            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";

                // Call API to resend OTP
                const response = await fetch('/api/user/kyc/resend_otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    }
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    // Successfully resent
                    showToast(data.message || 'OTP resent successfully', 'success', 3000);

                    // Reset timer
                    clearKycOtpTimer();
                    startKycOtpTimer();
                } else {
                    throw new Error(data.message || 'Failed to resend OTP');
                }
            } catch (error) {
                hideLoading();
                console.error('Resend KYC OTP error:', error);
                showToast(error.message || 'Error resending OTP. Please try again.', 'error', 3000);
            }
        }

        // Open KYC Success Popup
        window.openKycSuccessPopup = function openKycSuccessPopup() {
            const kycSuccessPopup = document.getElementById('kycSuccessPopup');
            kycSuccessPopup.classList.remove('hidden');
            document.body.classList.add('modal-open');
        }

        // Timer functions for KYC OTP
        window.startKycOtpTimer = function startKycOtpTimer() {
            let timeLeft = 30;
            const timerElement = document.getElementById('kycOtpTimer');
            const resendBtn = document.getElementById('resendKycOtpBtn');

            // Reset UI state
            resendBtn.disabled = true;
            resendBtn.onclick = null;
            timerElement.textContent = `Resend OTP in ${timeLeft}s`;

            // Clear any existing timer
            if (kycOtpTimerInterval) {
                clearInterval(kycOtpTimerInterval);
            }

            // Start new timer
            kycOtpTimerInterval = setInterval(() => {
                timeLeft--;
                timerElement.textContent = `Resend OTP in ${timeLeft}s`;

                if (timeLeft <= 0) {
                    clearKycOtpTimer();
                    timerElement.textContent = 'You can resend OTP now';
                    resendBtn.disabled = false;
                    resendBtn.onclick = resendKycOtp;
                }
            }, 1000);
        }

        window.clearKycOtpTimer = function clearKycOtpTimer() {
            if (kycOtpTimerInterval) {
                clearInterval(kycOtpTimerInterval);
                kycOtpTimerInterval = null;
            }
        }

        // Reset KYC Form
        function resetKycForm() {
            document.getElementById('aadhaarNumber').value = '';
            document.getElementById('captureInput').value = '';
            document.getElementById('aadhaarError').classList.add('hidden');
            document.getElementById('captureError').classList.add('hidden');
        }

        // Reset KYC OTP Form
        function resetKycOtpForm() {
            document.getElementById('kycOtpInput').value = '';
            document.getElementById('kycOtpError').classList.add('hidden');

            const resendBtn = document.getElementById('resendKycOtpBtn');
            resendBtn.disabled = true;
            resendBtn.onclick = null;

            const timerElement = document.getElementById('kycOtpTimer');
            timerElement.textContent = 'Resend OTP in 30s';
        }

        // Show Loading Function
        function showLoading() {
            const loading = document.getElementById('loading');
            if (loading) {
                loading.classList.remove('hidden');
            }
        }

        // Hide Loading Function
        function hideLoading() {
            const loading = document.getElementById('loading');
            if (loading) {
                loading.classList.add('hidden');
            }
        }

        // Page unload par timer clear karein
        window.addEventListener('beforeunload', function () {
            clearKycOtpTimer();
        });
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        const profileDropdown = document.getElementById('profileDropdown');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const mobileHamburger = document.getElementById('mobileHamburger');
        const mobileSidebar = document.getElementById('mobileSidebar');
        const mobileSidebarClose = document.getElementById('mobileSidebarClose');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        let hoverEnabled = false;
        let isCollapsed = false;

        // Desktop sidebar toggle
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                isCollapsed = !isCollapsed;

                if (isCollapsed) {
                    sidebar.classList.add('collapsed');
                    sidebar.classList.remove('hover-enabled');

                    setTimeout(() => {
                        sidebar.classList.add('hover-enabled');
                        hoverEnabled = true;
                    }, 1000);

                } else {
                    sidebar.classList.remove('collapsed');
                    sidebar.classList.remove('hover-enabled');
                    hoverEnabled = false;
                }
            });
        }


        // Mobile sidebar toggle
        if (mobileHamburger) {
            mobileHamburger.addEventListener('click', function () {
                mobileSidebar.classList.add('active');
                sidebarOverlay.classList.add('active');
            });
        }

        // Close mobile sidebar
        if (mobileSidebarClose) {
            mobileSidebarClose.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking overlay
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Profile dropdown functionality
        if (profileDropdown && dropdownMenu) {
            profileDropdown.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            document.addEventListener('click', function () {
                dropdownMenu.classList.remove('show');
            });

            dropdownMenu.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        // Close mobile sidebar when clicking menu items
        const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        });


        // Last 10 Days Column Chart
        const columnChartOptions = {
            series: [{
                name: 'Received Amount',
                data: JSON.parse('<%- JSON.stringify(data.last10Statistics) %>')
            }],
            chart: {
                type: 'bar',
                height: 350,
                toolbar: {
                    show: false
                }
            },
            plotOptions: {
                bar: {
                    borderRadius: 4,
                    columnWidth: '35%',
                }
            },
            colors: ['#181a20'],
            dataLabels: {
                enabled: false
            },
            xaxis: {
                categories: JSON.parse('<%- JSON.stringify(data.categories) %>'),
                axisBorder: {
                    show: true,
                    color: '#e0e0e0'
                },
                axisTicks: {
                    show: true,
                    color: '#e0e0e0'
                }
            },
            yaxis: {
                labels: {
                    formatter: function (val) {
                        return val.toFixed(1);
                    }
                }
            },
            grid: {
                borderColor: '#e0e0e0',
                strokeDashArray: 0,
            }
        };

        const columnChart = new ApexCharts(document.querySelector("#column_chart"), columnChartOptions);
        columnChart.render();

        // QR Transactions Radial Chart
        const radialChartOptions = {
            series: JSON.parse('<%- JSON.stringify(data.usedPercent) %>'),
            chart: {
                height: 260,
                type: 'radialBar',
            },
            plotOptions: {
                radialBar: {
                    hollow: {
                        size: '70%',
                    },
                    dataLabels: {
                        name: {
                            show: false,
                        },
                        value: {
                            show: true,
                            fontSize: '24px',
                            fontWeight: 600,
                            formatter: function (val) {
                                return '<%= data.usedTxn %> / <%= data.totalTxn %>';
                            }
                        }
                    }
                },
            },
            colors: ['#3B82F6'],
            labels: ['Used'],
        };

        const radialChart = new ApexCharts(document.querySelector("#radial_chart"), radialChartOptions);
        radialChart.render();

        // Status badge styling helper functions
        function getStatusBadgeClass(status) {
            const statusMap = {
                'Pending': 'bg-yellow-100 text-yellow-800',
                'Success': 'bg-green-100 text-green-800',
                'Failed': 'bg-red-100 text-red-800',
                'Cancel': 'bg-red-100 text-red-800',
                'Expired': 'bg-orange-100 text-orange-800'
            };
            return statusMap[status] || 'bg-gray-100 text-gray-800';
        }

        function getWebhookBadgeClass(webhookStatus) {
            const webhookMap = {
                'Pending': 'bg-yellow-100 text-yellow-800',
                'Sent': 'bg-green-100 text-green-800',
                'Failed': 'bg-red-100 text-red-800'
            };
            return webhookMap[webhookStatus] || 'bg-gray-100 text-gray-800';
        }

