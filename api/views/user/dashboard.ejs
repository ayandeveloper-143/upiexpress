                const emptyMessage = `
                    <tr>
                        <td colspan="9" class="text-center">
                            <div class="flex flex-col items-center justify-center py-12 text-gray-500">
                                <svg class="mb-3 mx-auto" width="100" height="100" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M541.305 121.663H258.637C176.303 121.663 109.637 188.663 109.637 270.663V584.33C109.637 666.33 176.637 733.33 258.637 733.33H540.971C623.305 733.33 689.971 666.33 689.971 584.33V270.663C690.305 188.33 623.305 121.663 541.305 121.663Z" fill="#b7bdc6"></path><path d="M478.328 66.6667H321.66C286.993 66.6667 258.66 94.6668 258.66 129.333V160.667C258.66 195.333 286.66 223.333 321.327 223.333H478.328C512.994 223.333 540.994 195.333 540.994 160.667V129.333C541.328 94.6668 512.994 66.6667 478.328 66.6667Z" fill="#848e9c"></path><path d="M500.001 431.673H266.668C253.001 431.673 241.668 420.34 241.668 406.673C241.668 393.007 253.001 381.673 266.668 381.673H500.001C513.668 381.673 525.001 393.007 525.001 406.673C525.001 420.34 513.668 431.673 500.001 431.673Z" fill="#848e9c"></path><path d="M412.668 565.007H266.668C253.001 565.007 241.668 553.673 241.668 540.007C241.668 526.34 253.001 515.007 266.668 515.007H412.668C426.335 515.007 437.668 526.34 437.668 540.007C437.668 553.673 426.335 565.007 412.668 565.007Z" fill="#848e9c"></path><rect x="486" y="540" width="233.33" height="233.33" rx="61" fill="#848e9c"></rect><path d="M620.722 656.478L660.261 616.954C665.246 611.97 665.246 603.721 660.261 598.738C655.276 593.754 647.024 593.754 642.039 598.738L602.5 638.263L562.961 598.738C557.976 593.754 549.724 593.754 544.739 598.738C539.754 603.721 539.754 611.97 544.739 616.954L584.278 656.478L544.739 696.003C539.754 700.987 539.754 709.236 544.739 714.219C547.318 716.797 550.584 718 553.85 718C557.116 718 560.382 716.797 562.961 714.219L602.5 674.694L642.039 714.219C644.617 716.797 647.884 718 651.15 718C654.416 718 657.682 716.797 660.261 714.219C665.246 709.236 665.246 700.987 660.261 696.003L620.722 656.478Z" fill="white"></path></svg>
                                <p class="text-lg">No transactions today</p>
                            </div>
                        </td>
                    </tr>
                `;
                desktopTbody.innerHTML = emptyMessage;
                mobileContainer.innerHTML = `
                    <div class="text-center py-12 text-gray-500">
                         <svg class="mb-3 mx-auto mb-4 " width="100" height="100" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M541.305 121.663H258.637C176.303 121.663 109.637 188.663 109.637 270.663V584.33C109.637 666.33 176.637 733.33 258.637 733.33H540.971C623.305 733.33 689.971 666.33 689.971 584.33V270.663C690.305 188.33 623.305 121.663 541.305 121.663Z" fill="#b7bdc6"></path><path d="M478.328 66.6667H321.66C286.993 66.6667 258.66 94.6668 258.66 129.333V160.667C258.66 195.333 286.66 223.333 321.327 223.333H478.328C512.994 223.333 540.994 195.333 540.994 160.667V129.333C541.328 94.6668 512.994 66.6667 478.328 66.6667Z" fill="#848e9c"></path><path d="M500.001 431.673H266.668C253.001 431.673 241.668 420.34 241.668 406.673C241.668 393.007 253.001 381.673 266.668 381.673H500.001C513.668 381.673 525.001 393.007 525.001 406.673C525.001 420.34 513.668 431.673 500.001 431.673Z" fill="#848e9c"></path><path d="M412.668 565.007H266.668C253.001 565.007 241.668 553.673 241.668 540.007C241.668 526.34 253.001 515.007 266.668 515.007H412.668C426.335 515.007 437.668 526.34 437.668 540.007C437.668 553.673 426.335 565.007 412.668 565.007Z" fill="#848e9c"></path><rect x="486" y="540" width="233.33" height="233.33" rx="61" fill="#848e9c"></rect><path d="M620.722 656.478L660.261 616.954C665.246 611.97 665.246 603.721 660.261 598.738C655.276 593.754 647.024 593.754 642.039 598.738L602.5 638.263L562.961 598.738C557.976 593.754 549.724 593.754 544.739 598.738C539.754 603.721 539.754 611.97 544.739 616.954L584.278 656.478L544.739 696.003C539.754 700.987 539.754 709.236 544.739 714.219C547.318 716.797 550.584 718 553.85 718C557.116 718 560.382 716.797 562.961 714.219L602.5 674.694L642.039 714.219C644.617 716.797 647.884 718 651.15 718C654.416 718 657.682 716.797 660.261 714.219C665.246 709.236 665.246 700.987 660.261 696.003L620.722 656.478Z" fill="white"></path></svg>
                           
                        <p class="text-lg">No transactions today</p>
                    </div>
                `;
                return;
            }

            // Desktop table rows
            desktopTbody.innerHTML = data.map((item, index) => `
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                    <td class="text-center py-3 px-4 text-gray-600">${index + 1}</td>
                    <td class="py-3 px-4 text-gray-900">${item.customer_phone}</td>
