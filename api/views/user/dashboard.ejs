            class="bg-green-500 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow-md flex items-center space-x-3 max-w-md error-animate">
            <p id="successMessageText" class="truncate">Error message goes here</p>
            <button id="successClose" type="button" aria-label="Close" class="text-white opacity-90 hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2">
