                                    data-form-type="other">
                            </div>

                            <div class="flex flex-col search-filter w-full md:w-[400px] mt-4 mb-6">
                                <label class="block text-xs md:text-sm mb-1">Confirm Password</label>
                                <input class="px-3 md:px-4 py-2 text-sm border rounded-lg" type="password"
                                    autocomplete="new-password" data-lpignore="true" data-form-type="other"
                                    placeholder="Confirm password">
                            </div>

                            <button type="button" id="changePasswordBtn"
                                class="bg-black text-white px-4 md:px-6 py-2 text-sm md:text-base rounded-lg hover:bg-gray-800 w-full md:w-auto">
                                Change Password
                            </button>
                        </div>
                    </div>

                </div>
            </div>







        </div>
        <!-- Error Messages Toast -->
        <div id="errorMessages" role="alert" aria-live="assertive"
            class="fixed bottom-6 left-1/2 transform -translate-x-1/2 flex items-center hidden z-[10999]">
            <div
                class="bg-red-500 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow-md flex items-center space-x-3 max-w-md">
                <p id="errorMessageText">Error message goes here</p>
                <button type="button" id="errorClose"
                    onclick="document.getElementById('errorMessages').classList.add('hidden')" class="ml-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Success Messages Toast -->
        <div id="successMessage" role="alert" aria-live="assertive"
            class="fixed bottom-6 left-1/2 transform -translate-x-1/2 flex items-center hidden z-[10999]">
            <div
                class="bg-green-500 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow-md flex items-center space-x-3 max-w-md">
                <p id="successMessageText">Success message goes here</p>
                <button type="button" id="successClose"
                    onclick="document.getElementById('successMessage').classList.add('hidden')" class="ml-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>
        </div>
        <!-- Loading Spinner -->
        <div id="loadingSpinner"
            class="fixed inset-0 flex justify-center items-center hidden bg-white bg-opacity-75 z-[10000] min-h-screen">
            <div class="three-body">
                <div class="three-body__dot"></div>
                <div class="three-body__dot"></div>
                <div class="three-body__dot"></div>
            </div>
        </div>


        <!-- Footer -->
        <div class="footer">
            <div class="footer-content">
                <div class="footer-left">
                    <p class="text-gray-600">&copy; 2025 UPI Express. All rights reserved.</p>
                </div>
                <div class="footer-right">

                    <a href="/terms" class="footer-link text-[var(--primary)]">Terms of Service</a>
                    <a href="/privacy" class="footer-link text-[var(--primary)]">Privacy Policy</a>
                    <a href="/contact-us" class="footer-link text-[var(--primary)]">Contact Us</a>
                </div>
            </div>

        </div>


        <script>
            let currentSection = "profileSection";
            let uploadedFile = null;
            const csrfToken = "<%= csrfToken %>";

            // Initialize - set Profile button as active on page load
            document.addEventListener('DOMContentLoaded', function () {
                const btnProfile = document.getElementById("btnProfile");
                if (btnProfile) {
                    btnProfile.classList.add("active");
                }
            });

            // Show loading spinner
            function showLoading() {
                document.getElementById('loadingSpinner').classList.remove('hidden');
            }

            // Hide loading spinner
            function hideLoading() {
                document.getElementById('loadingSpinner').classList.add('hidden');
            }

            // Show error message
            function showError(message) {
                document.getElementById('errorMessageText').textContent = message;
                document.getElementById('errorMessages').classList.remove('hidden');
                setTimeout(() => {
                    document.getElementById('errorMessages').classList.add('hidden');
                }, 5000);
            }

            // Show success message
            function showSuccess(message) {
                document.getElementById('successMessageText').textContent = message;
                document.getElementById('successMessage').classList.remove('hidden');
                setTimeout(() => {
                    document.getElementById('successMessage').classList.add('hidden');
                }, 5000);
            }

            // Image upload preview
            document.getElementById('logoUpload').addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    // Validate file size (max 5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        showError('File size must be less than 5MB');
                        return;
                    }

                    // Validate file type
                    if (!file.type.startsWith('image/')) {
                        showError('Please select a valid image file');
                        return;
                    }

                    uploadedFile = file;
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        document.getElementById('logoPreview').src = event.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Update Profile Function
            document.getElementById('updateProfileBtn').addEventListener('click', async function () {
                showLoading();

                try {
                    const formData = new FormData();
                    formData.append('type', 'profile');

                    // Get all input values from profile section
                    const nameInput = document.querySelector('#profileSection input[placeholder="Name"]').value;
                    const businessNameInput = document.querySelector('#profileSection input[placeholder="Business Name"]').value;
                    const stateSelect = document.querySelector('#profileSection select').value;
                    const websiteUrlInput = document.querySelector('#profileSection input[placeholder="https://example.com"]').value;
                    const appUrlInput = document.querySelector('#profileSection input[placeholder="App URL"]').value;
                    const whatsappNoInput = document.querySelector('#profileSection input[placeholder="Whatsapp no."]').value;

                    formData.append('name', nameInput);
                    formData.append('business_name', businessNameInput);
                    formData.append('state', stateSelect);
                    formData.append('website_url', websiteUrlInput);
                    formData.append('app_url', appUrlInput);
                    formData.append('whatsapp_no', whatsappNoInput);

                    if (uploadedFile) {
                        formData.append('business_logo', uploadedFile);
                    }

                    const response = await fetch('/api/user/settings/update', {
                        method: 'POST',
                        headers: {
                            'CSRF-Token': csrfToken
                        },
                        body: formData
                    });

                    const data = await response.json();

                    if (data.status) {
                        showSuccess(data.message || 'Profile updated successfully!');
                        uploadedFile = null;
                    } else {
                        showError(data.message || 'Failed to update profile');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showError('An error occurred. Please try again.');
                } finally {
                    hideLoading();
                }
            });

            // Change Password Function
            document.getElementById('changePasswordBtn').addEventListener('click', async function () {
                const currentPassword = document.querySelector('#securitySection input[placeholder="Your current password"]').value;
                const newPassword = document.querySelector('#securitySection input[placeholder="New password"]').value;
                const confirmPassword = document.querySelector('#securitySection input[placeholder="Confirm password"]').value;

                if (!currentPassword || !newPassword || !confirmPassword) {
                    showError('Please fill in all password fields');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    showError('New password and confirm password do not match');
                    return;
                }

                showLoading();

                try {
                    const response = await fetch('/api/user/settings/update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            type: 'password',
                            current_password: currentPassword,
                            new_password: newPassword
                        })
                    });

                    const data = await response.json();

                    if (data.status) {
                        showSuccess(data.message || 'Password changed successfully!');
                        // Clear password fields
                        document.querySelector('#securitySection input[placeholder="Your current password"]').value = '';
                        document.querySelector('#securitySection input[placeholder="New password"]').value = '';
                        document.querySelector('#securitySection input[placeholder="Confirm password"]').value = '';
                    } else {
                        showError(data.message || 'Failed to change password');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showError('An error occurred. Please try again.');
                } finally {
                    hideLoading();
                }
            });

            function showSection(id) {
                // Don't animate if clicking same section
                if (currentSection === id) {
                    return;
                }

                const profileSection = document.getElementById("profileSection");
                const securitySection = document.getElementById("securitySection");
                const targetSection = id === "profileSection" ? profileSection : securitySection;
                const hideSection = id === "profileSection" ? securitySection : profileSection;

                // Hide current section
                hideSection.classList.add("hidden");

                // Show new section with fade animation
                targetSection.classList.remove("hidden");
                targetSection.classList.add("section-fade");

                setTimeout(() => {
                    targetSection.classList.remove("section-fade");
                }, 300);

                currentSection = id;

                // Update button styling
                const btnProfile = document.getElementById("btnProfile");
                const btnSecurity = document.getElementById("btnSecurity");

                // Desktop styling
                if (id === "profileSection") {
                    btnProfile.classList.add("text-black", "font-medium");
                    btnProfile.classList.remove("text-gray-700");
                    btnSecurity.classList.remove("text-black", "font-medium");
                    btnSecurity.classList.add("text-gray-700");
                } else {
                    btnSecurity.classList.add("text-black", "font-medium");
                    btnSecurity.classList.remove("text-gray-700");
                    btnProfile.classList.remove("text-black", "font-medium");
                    btnProfile.classList.add("text-gray-700");
                }

                // Mobile styling - add/remove active class
                if (id === "profileSection") {
                    btnProfile.classList.add("active");
                    btnSecurity.classList.remove("active");
                } else {
                    btnSecurity.classList.add("active");
                    btnProfile.classList.remove("active");
                }
            }


        </script>

        <script type="module">
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebar');
            const profileDropdown = document.getElementById('profileDropdown');
            const dropdownMenu = document.getElementById('dropdownMenu');
            const mobileHamburger = document.getElementById('mobileHamburger');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileSidebarClose = document.getElementById('mobileSidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            let hoverEnabled = false;
            let isCollapsed = false;

            // Desktop sidebar toggle
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }


            // Mobile sidebar toggle
            if (mobileHamburger) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            // Close mobile sidebar
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Profile dropdown functionality
            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            // Close mobile sidebar when clicking menu items
            const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });


        </script>

</body>

</html>