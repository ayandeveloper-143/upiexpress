            color: var(--light-1);
        }

        .btn-theme:active {
            background-color: var(--primary-dark);
        }

        .btn-outline-theme {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-outline-theme:hover {
            background-color: var(--primary-transparent);
            color: var(--primary-dark);
        }

        .link-theme {
            color: var(--primary);
        }

        .link-theme:hover {
            color: var(--primary-light);
            text-decoration: underline;
        }

        /* Error animation for toast and fields (bottom to up) */
        .error-animate {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.4s cubic-bezier(.4, 0, .2, 1), transform 0.4s cubic-bezier(.4, 0, .2, 1);
        }

        .error-animate.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* For error fields */
        .error-field {
            position: absolute;
            left: 0;
            bottom: -8px;
            width: 100%;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s cubic-bezier(.4, 0, .2, 1);
        }

        .error-field.show {
            opacity: 1;
            pointer-events: auto;
        }

        /* Only for password error, move further down */
        #errorPassword {
            bottom: -18px;
        }

        .field-group {
            position: relative;
            transition: background 0.3s cubic-bezier(.4, 0, .2, 1), min-height 0.3s cubic-bezier(.4, 0, .2, 1);
            min-height: 56px;
            /* Reserve space for error message */
        }
    </style>

</head>

