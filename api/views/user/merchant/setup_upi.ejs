    <script>


        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        const profileDropdown = document.getElementById('profileDropdown');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const mobileHamburger = document.getElementById('mobileHamburger');
        const mobileSidebar = document.getElementById('mobileSidebar');
        const mobileSidebarClose = document.getElementById('mobileSidebarClose');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const page1 = document.getElementById('page1');



        // Global variables for timer management
        let currentMerchant = null;
        let otpTimerInterval = null;

        // OTP Popup Functions
        function openOtpPopup(message) {
            const otpPopup = document.getElementById('otpPopup');
            const otpMessage = document.getElementById('otpMessage');

            // Pehle existing timer clear karein
            clearOtpTimer();


            otpMessage.innerHTML = message;

            otpPopup.classList.remove('hidden');
            document.body.classList.add('modal-open');

            // Start OTP timer
            startOtpTimer();

        }

        function closeOtpPopup() {
            const otpPopup = document.getElementById('otpPopup');
            otpPopup.classList.add('hidden');
            document.body.classList.remove('modal-open');
            resetOtpForm();
            clearOtpTimer(); // Timer clear karein
        }

        function verifyOtp() {
            const otpInput = document.getElementById('otpInput');
            const otpError = document.getElementById('otpError');


            // Call API to verify OTP
            verifyOtpWithAPI(otpInput.value);
        }

        async function verifyOtpWithAPI(otp) {
            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;

                // Collect form data
                const form = document.querySelector('form');
                const bodyData = {
                    merchantId: merchantId,
                    otp: otp
                };

                // Add form fields to body
                if (form) {
                    const formData = new FormData(form);
                    for (let [key, value] of formData.entries()) {
                        bodyData[key] = value;
                    }
                }

                const response = await fetch('/api/user/merchant/upi/verify_otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(bodyData)
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    closeOtpPopup();

                    // Store merchant_txnid and phone number for later use
                    if (data.merchant_txnid) {
                        window.merchantTxnId = data.merchant_txnid;
                    }
                    // Store phone number for default UPI ID
                    if (bodyData.phone) {
                        window.userPhoneNumber = bodyData.phone;
                    }

                    // Check merchant type and show appropriate popup
                    if (merchantId === 'freecharge') {
                        // For FreeCharge, show UPI ID input popup
                        openUpiIdPopup();
                    } else if (data.terminalInfo && typeof data.terminalInfo === 'object') {
                        // For merchants with terminal info (HDFC, etc), show store selection
                        window.terminalInfoData = data.terminalInfo;
                        openSelectStorePopup(data.terminalInfo);
                    } else {
                        // No terminal info, show success popup
                        openMerchantConnectPopup(currentMerchant.name);
                    }
                } else {
                    const otpError = document.getElementById('otpError');
                    otpError.textContent = data.message || 'Invalid OTP. Please try again.';
                    otpError.classList.remove('hidden');
                }
            } catch (error) {
                hideLoading();
                console.error('OTP verification error:', error);
                const otpError = document.getElementById('otpError');
                otpError.textContent = error.message || 'Error verifying OTP. Please try again.';
                otpError.classList.remove('hidden');
            }
        }

        // Select Store Popup Functions
        window.openSelectStorePopup = function openSelectStorePopup(terminalInfo) {
            const popup = document.getElementById('selectStorePopup');
            const storesList = document.getElementById('storesList');

            // Clear previous stores
            storesList.innerHTML = '';

            // Handle different terminalInfo structures
            let storesObject = terminalInfo;

            // If terminalInfo is an array with one object, extract the object
            if (Array.isArray(terminalInfo) && terminalInfo.length > 0) {
                storesObject = terminalInfo[0];
            }

            // Convert storesObject to array and create store items
            if (typeof storesObject === 'object' && storesObject !== null) {
                let storesHTML = '';
                Object.keys(storesObject).forEach((key, index) => {
                    const store = storesObject[key];
                    const storeHTML = `
                        <div class="store-item border border-gray-200 rounded-lg p-4 hover:border-[var(--primary)] hover:bg-blue-50 cursor-pointer transition-all" data-store-id="${key}" data-mid="${store.mid || ''}" data-location="${store.location || store.city || ''}">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-1">${store.companyName || store.dba || 'Store'}</h3>
                                    <p class="text-sm text-gray-600 mb-2">Terminal ID: <span class="font-medium">${store.mid || store.cid || 'N/A'}</span></p>
                                    <p class="text-sm text-gray-600">Location: <span class="font-medium">${store.location || store.city || 'N/A'}</span></p>
                                    ${store.address ? `<p class="text-xs text-gray-500 mt-1">${store.address}</p>` : ''}
                                </div>
                                <div class="flex-shrink-0 ml-4">
                                    <input type="radio" name="store_selection" value="${key}" class="store-radio w-5 h-5 text-[var(--primary)] cursor-pointer">
                                </div>
                            </div>
                        </div>
                    `;
                    storesHTML += storeHTML;
                });

                // Add all stores first
                storesList.innerHTML = storesHTML;

                // Add continue button
                storesList.innerHTML += `
                    <div class="mt-6 border-t pt-4">
                        <button onclick="handleStoreSelection()" class="w-full bg-[var(--primary)] hover:bg-[var(--primary-dark)] text-white font-semibold px-4 py-3 rounded-xl transition-colors">
                            Continue with Selected Store
                        </button>
                    </div>
                `;

                // Now add event listeners AFTER all HTML is added
                document.querySelectorAll('.store-item').forEach(item => {
                    const radio = item.querySelector('.store-radio');

                    // Store item click - select the radio and update styling
                    item.addEventListener('click', function (e) {
                        // Remove active styling from all items
                        document.querySelectorAll('.store-item').forEach(el => {
                            el.classList.remove('border-[var(--primary)]', 'bg-blue-50');
                            el.classList.add('border-gray-200');
                        });

                        // Check the radio
                        radio.checked = true;

                        // Add active styling to clicked item
                        this.classList.remove('border-gray-200');
                        this.classList.add('border-[var(--primary)]', 'bg-blue-50');
                    });
                });
            }

            popup.classList.remove('hidden');
            document.body.classList.add('modal-open');
        }

        window.closeSelectStorePopup = function closeSelectStorePopup() {
            const popup = document.getElementById('selectStorePopup');
            popup.classList.add('hidden');
            document.body.classList.remove('modal-open');
        }

        // UPI ID Popup Functions
        function openUpiIdPopup() {
            const popup = document.getElementById('upiIdPopup');
            const upiIdInput = document.getElementById('upiIdInput');
            const upiIdError = document.getElementById('upiIdError');

            // Set default value with phone number + @freecharge
            const userPhoneNumber = window.userPhoneNumber || '';
            upiIdInput.value = userPhoneNumber ? `${userPhoneNumber}@freecharge` : '';
            upiIdError.classList.add('hidden');

            popup.classList.remove('hidden');
            document.body.classList.add('modal-open');

            // Select all text so user can easily replace if needed
            upiIdInput.focus();
            upiIdInput.select();
        }

        function closeUpiIdPopup() {
            const popup = document.getElementById('upiIdPopup');
            popup.classList.add('hidden');
            document.body.classList.remove('modal-open');

            const upiIdInput = document.getElementById('upiIdInput');
            const upiIdError = document.getElementById('upiIdError');
            upiIdInput.value = '';
            upiIdError.classList.add('hidden');
        }

        async function submitUpiId() {
            const upiIdInput = document.getElementById('upiIdInput');
            const upiIdError = document.getElementById('upiIdError');
            const upiId = upiIdInput.value.trim();

            // Validate UPI ID format (example@freecharge)
            const upiRegex = /^[a-zA-Z0-9._-]+@freecharge$/i;

            if (!upiId || !upiRegex.test(upiId)) {
                upiIdError.textContent = 'Please enter a valid FreeCharge UPI ID (example@freecharge)';
                upiIdError.classList.remove('hidden');
                return;
            }

            try {
                showLoading();
                closeUpiIdPopup();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;
                const merchantTxnId = window.merchantTxnId || '';

                const response = await fetch('/api/user/merchant/freecharge/save_upi_id', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        merchantId: merchantId,
                        upiId: upiId,
                        merchant_txnid: merchantTxnId
                    })
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    // Show success popup
                    openMerchantConnectPopup(currentMerchant.name);
                } else {
                    upiIdError.textContent = data.message || 'Failed to save UPI ID. Please try again.';
                    upiIdError.classList.remove('hidden');
                    openUpiIdPopup();
                }
            } catch (error) {
                hideLoading();
                console.error('UPI ID submission error:', error);
                upiIdError.textContent = error.message || 'Error saving UPI ID. Please try again.';
                upiIdError.classList.remove('hidden');
                openUpiIdPopup();
            }
        }

        window.handleStoreSelection = async function handleStoreSelection() {
            const selectedStore = document.querySelector('input[name="store_selection"]:checked');

            if (!selectedStore) {

                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = 'Please select a store to continue';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);

                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
                return;
            }

            const storeId = selectedStore.value;
            const storeItem = document.querySelector(`.store-item[data-store-id="${storeId}"]`);
            const mid = storeItem.getAttribute('data-mid');
            const phoneNumber = window.userPhoneNumber || '';

            try {
                showLoading();
                closeSelectStorePopup();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;

                // Make API call with phone number and terminal id (mid)
                const response = await fetch('/api/user/merchant/upi/select_store', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        merchantId: merchantId,
                        storeId: storeId,
                        terminalId: mid,
                        merchant_txnid: window.merchantTxnId || ''
                    })
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    // Show success popup
                    openMerchantConnectPopup(currentMerchant.name);
                } else {
                    throw new Error(data.message || 'Failed to select store');
                }
            } catch (error) {
                hideLoading();

                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = error.message || 'Error. Please try again.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);

                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
                openSelectStorePopup(window.terminalInfoData);
            }
        }

        // Merchant Connect Success Popup
        window.openMerchantConnectPopup = function openMerchantConnectPopup(merchantName) {
            const popup = document.getElementById('merchantConnectPopup');
            const message = document.getElementById('merchantConnectMessage');

            message.textContent = `Your ${merchantName} account has been successfully connected with UPIExpress.`;
            popup.classList.remove('hidden');
            document.body.classList.add('modal-open');
        }

        // ...existing code...
        function closeMerchantConnectPopup() {
            const popup = document.getElementById('merchantConnectPopup');
            popup.classList.add('hidden');
            document.body.classList.remove('modal-open');

            // ---- NEW CODE START ----
            // Return to the first page (page1) after closing the success popup
            const page1 = document.getElementById('page1');
            const page2 = document.getElementById('page2');
            const page3 = document.getElementById('page3');

            // Hide any other pages that might be visible
            if (page2) page2.classList.add('hidden');
            if (page3) page3.classList.add('hidden');

            // Show page1
            if (page1) page1.classList.remove('hidden');
            // ---- NEW CODE END ----
        }
        // ...existing code...

        function resendOtp() {
            if (!currentMerchant) return;

            // Call API to resend OTP
            resendOtpWithAPI();
        }

        async function resendOtpWithAPI() {
            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;

                // Collect form data
                const form = document.querySelector('form');
                const bodyData = {
                    merchantId: merchantId,
                    type: 'sendotp'
                };

                // Add form fields to body
                if (form) {
                    const formData = new FormData(form);
                    for (let [key, value] of formData.entries()) {
                        bodyData[key] = value;
                    }
                }

                const response = await fetch('/api/user/merchant/upi/setup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(bodyData)
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    // Successfully resent
                    const successMessages = document.getElementById('successMessage');
                    const successMessageText = document.getElementById('successMessageText');
                    successMessageText.textContent = data.message || 'OTP resent successfully to your mobile number';
                    successMessages.classList.remove('hidden');
                    const toastBox = successMessages.querySelector('.error-animate');
                    setTimeout(() => toastBox.classList.add('show'), 100);

                    setTimeout(() => {
                        toastBox.classList.remove('show');
                        setTimeout(() => successMessages.classList.add('hidden'), 200);
                    }, 3000);

                    // Reset timer
                    clearOtpTimer();
                    startOtpTimer();
                } else {
                    throw new Error(data.message || 'Failed to resend OTP');
                }
            } catch (error) {
                hideLoading();
                console.error('Resend OTP error:', error);
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = error.message || 'Error resending OTP. Please try again.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);

                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
            }
        }

        function startOtpTimer() {
            let timeLeft = 30;
            const timerElement = document.getElementById('otpTimer');
            const resendBtn = document.getElementById('resendOtpBtn');

            // Reset UI state
            resendBtn.disabled = true;
            resendBtn.onclick = null;
            timerElement.textContent = `Resend OTP in ${timeLeft}s`;

            // Clear any existing timer
            if (otpTimerInterval) {
                clearInterval(otpTimerInterval);
            }

            // New timer start karein
            otpTimerInterval = setInterval(() => {
                timeLeft--;
                timerElement.textContent = `Resend OTP in ${timeLeft}s`;

                if (timeLeft <= 0) {
                    clearOtpTimer();
                    timerElement.textContent = 'You can resend OTP now';
                    resendBtn.disabled = false;
                    resendBtn.onclick = resendOtp;
                }
            }, 1000);
        }

        function clearOtpTimer() {
            if (otpTimerInterval) {
                clearInterval(otpTimerInterval);
                otpTimerInterval = null;
            }
        }

        function resetOtpForm() {
            document.getElementById('otpInput').value = '';
            document.getElementById('otpError').classList.add('hidden');

            const resendBtn = document.getElementById('resendOtpBtn');
            resendBtn.disabled = true;
            resendBtn.onclick = null;

            const timerElement = document.getElementById('otpTimer');
            timerElement.textContent = 'Resend OTP in 30s';
        }

        function retryOtp() {
            closeOtpFailedPopup();

            if (currentMerchant) {
                // Retry with same merchant
                setTimeout(() => {
                    openOtpPopup(currentMerchant.name);
                }, 500);
            }
        }

        // Page unload ya navigate hone par timer clear karein
        window.addEventListener('beforeunload', function () {
            clearOtpTimer();
        });
        let hoverEnabled = false;
        let isCollapsed = false;

        // Desktop sidebar toggle
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                isCollapsed = !isCollapsed;

                if (isCollapsed) {
                    sidebar.classList.add('collapsed');
                    sidebar.classList.remove('hover-enabled');

                    setTimeout(() => {
                        sidebar.classList.add('hover-enabled');
                        hoverEnabled = true;
                    }, 1000);

                } else {
                    sidebar.classList.remove('collapsed');
                    sidebar.classList.remove('hover-enabled');
                    hoverEnabled = false;
                }
            });
        }

        function toggleTab(tabId) {
            // Hide all tab panes
            document.querySelectorAll('.tab-pane').forEach(pane => {
                pane.classList.add('hidden');
            });

            // Show the selected tab pane
            document.getElementById(tabId).classList.remove('hidden');

            // Update active tab styling
            document.querySelectorAll('.tab-buttons button').forEach(button => {
                if (button.textContent.trim() === (tabId === 'english_info' ? 'English' : 'Hindi')) {
                    button.classList.add('border-b-2', 'border-[var(--primary)]', 'text-[var(--primary)]');
                    button.classList.remove('text-gray-600');
                } else {
                    button.classList.remove('border-b-2', 'border-[var(--primary)]', 'text-[var(--primary)]');
                    button.classList.add('text-gray-600');
                }
            });
        }


        // Loading functions
        function showLoading() {
            document.getElementById('loading').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loading').classList.add('hidden');
        }

        // Close success toast
        document.getElementById('successClose').addEventListener('click', () => {
            const successMessage = document.getElementById('successMessage');
            const toastBox = successMessage.querySelector('.error-animate');
            toastBox.classList.remove('show');
            setTimeout(() => successMessage.classList.add('hidden'), 400);
        });


        // Close error toast
        document.getElementById('errorClose').addEventListener('click', () => {
            const errorMessages = document.getElementById('errorMessages');
            const toastBox = errorMessages.querySelector('.error-animate');
            toastBox.classList.remove('show');
            setTimeout(() => errorMessages.classList.add('hidden'), 400);
        });


        function handleAgreement() {
            const checkbox = document.getElementById('accept_warn_tc_btn');
            if (checkbox.checked) {
                closeModal();
                // Hide Page 1 with animation
                let page2 = document.getElementById('page2');

                // If page2 doesn't exist, render it first
                if (!page2) {
                    renderPage('page2');
                    page2 = document.getElementById('page2');
                }

                // Double check if page2 exists after rendering
                if (!page2) {
                    console.error('page2 element could not be created');
                    return;
                }

                page1.classList.add('page-fade-out');

                setTimeout(() => {
                    // Hide Page 1
                    page1.classList.add('hidden');
                    page1.classList.remove('page-fade-out');

                    // Show Page 2
                    page2.classList.remove('hidden');
                }, 300);

            } else {
                // Show error toast
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText')
                errorMessageText.textContent = 'Please accept the terms and conditions to proceed.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);

                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
            }
        }

        function closeModal() {
            const modal = document.getElementById('warn_modal');
            modal.classList.add('hidden');

            // Wait for animation to complete before hiding
            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.classList.remove('modal-open');
            }, 300);
        }

        function openModal() {
            const modal = document.getElementById('warn_modal');
            modal.classList.remove('hidden');
            // Trigger animation by removing hidden class
            setTimeout(() => {
                modal.classList.remove('hidden');
            }, 10);
            document.body.classList.add('modal-open');
        }

        // Modal background click handler
        const warnModal = document.getElementById('warn_modal');
        if (warnModal) {
            warnModal.addEventListener('click', function (e) {
                if (e.target === this) {
                    closeModal();
                }
            });
        }
        // Mobile sidebar toggle
        if (mobileHamburger) {
            mobileHamburger.addEventListener('click', function () {
                mobileSidebar.classList.add('active');
                sidebarOverlay.classList.add('active');
            });
        }

        // Close mobile sidebar
        if (mobileSidebarClose) {
            mobileSidebarClose.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Close mobile sidebar when clicking overlay
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        }

        // Profile dropdown functionality
        if (profileDropdown && dropdownMenu) {
            profileDropdown.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            document.addEventListener('click', function () {
                dropdownMenu.classList.remove('show');
            });

            dropdownMenu.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        // Close mobile sidebar when clicking menu items
        const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', function () {
                mobileSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });
        });


    </script>

    <script id="upi-setup-data" type="application/json">
