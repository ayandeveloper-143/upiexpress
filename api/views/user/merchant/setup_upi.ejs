    <script>
        function getAppData() {
            return JSON.parse(document.getElementById('upi-setup-data').textContent);
        }

        // Make appData globally accessible
        window.appData = [];
    </script>
    <script type="module">
        // JSON Data Structure
        let appData = window.appData;

        // Render Functions - Make it globally accessible
        window.renderPage = function renderPage(pageId, merchantId = null) {
            let pageData;

            if (pageId === "page3" && merchantId) {
                // Render merchant-specific page 3
                const merchantData = window.appData.merchants[merchantId];
                if (!merchantData || !merchantData.page3) return;

                pageData = merchantData.page3;
                pageData.id = "page3";
                pageData.backButton = {
                    text: "Back to Select Merchant",
                    action: "backToPage2"
                };
                window.appData.selectedMerchant = merchantId;
            } else {
                // Render standard pages
                pageData = window.appData.pages[pageId];
                if (!pageData) return;
            }

            window.appData.currentPage = pageId;

            let html = `
                <div class="page-content hidden mx-[5px] lg:mx-[84px] min-h-[calc(100vh-180px)] lg:pt-[28px] mb-10" id="${pageData.id}">
                    <!-- Back Button -->
                    <a class="back-button inline-flex items-center text-gray-600 hover:text-gray-900 mb-4 transition-colors" data-action="${pageData.backButton.action}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        ${pageData.backButton.text}
                    </a>

                    <!-- Header -->
                    <div class="mb-6">
                        <h1 class="text-3xl font-bold text-gray-900 mb-2">${pageData.title}</h1>
                        <p class="text-gray-600">${pageData.description}</p>
                    </div>
            `;

            // Render sections for page2
            if (pageId === "page2" && pageData.sections) {
                pageData.sections.forEach(section => {
                    html += window.renderSection(section);
                });
            }

            // Render form if exists
            if (pageData.form) {
                html += window.renderForm(pageData.form, pageData.logo);
            }

            // Render howToCreate if exists
            if (pageData.howToCreate) {
                html += window.renderHowToCreate(pageData.howToCreate);
            }

            // Render next button if exists (for page2)
            if (pageData.nextButton) {
                html += `
                    <div class="flex justify-end mt-8">
                        <button class="bg-[var(--primary)] hover:bg-[var(--primary-dark)] text-white font-semibold px-6 py-3 rounded-xl flex items-center gap-2 transition-colors" data-action="${pageData.nextButton.action}">
                            ${pageData.nextButton.text}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>
                    </div>
                `;
            }

            html += `</div>`;

            // Update the content container
            document.getElementById('dynamic-content').innerHTML = html;

            // Add event listeners
            window.addEventListeners();
        };

        window.renderSection = function renderSection(section) {
            let html = '';

            switch (section.type) {
                case 'merchantGrid':
                    html = window.renderMerchantGrid(section);
                    break;
                case 'divider':
                    html = window.renderDivider(section);
                    break;
            }

            return html;
        };

        window.renderMerchantGrid = function renderMerchantGrid(section) {
            let html = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    `;

            section.merchants.forEach(merchant => {
                const isSelected = window.appData.selectedMerchant === merchant.id;
                const enabledClass = merchant.enabled
                    ? `bg-white rounded-xl p-4 flex items-center gap-4 transition-all duration-200 text-left group ${isSelected ? 'border-[var(--primary)] border-2' : 'border border-gray-200 hover:border-[var(--primary)]'
                    }`
                    : "bg-gray-50 border border-gray-200 rounded-xl p-4 flex items-center gap-4 text-left cursor-not-allowed opacity-60";

                html += `
            <button ${merchant.enabled ? '' : 'disabled'} class="${enabledClass} relative overflow-hidden" data-merchant="${merchant.id}">
                ${renderBadges(merchant.badges)}
                <div class="w-20 h-20 flex-shrink-0 ${merchant.enabled ? 'bg-gray-100' : 'bg-gray-200'} rounded-xl border border-gray-200 flex items-center justify-center overflow-hidden">
                    <img src="${merchant.logo}" alt="${merchant.name}" class="w-20 h-20 object-contain">
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-semibold ${merchant.enabled ? 'text-gray-900 group-hover:text-[var(--primary-dark)]' : 'text-gray-600'} transition-colors">
                        ${merchant.name}
                    </h3>
                    <p class="text-sm ${merchant.enabled ? 'text-gray-500' : 'text-gray-400'}">${merchant.type}</p>
                </div>
            </button>
        `;
            });

            html += `</div>`;

            return html;
        };
        window.renderBadges = function renderBadges(badges) {
            if (!badges || badges.length === 0) return '';

            let html = '';
            badges.forEach(badge => {
                const colorClass = badge.color === 'teal' ? 'bg-teal-600' :
                    badge.color === 'green' ? 'bg-green-600' : 'bg-blue-600';
                html += `
                    <div class="absolute top-0 right-0 ${colorClass} text-white text-xs font-semibold px-3 py-1 rounded-bl-lg">
                        ${badge.text}
                    </div>
                `;
            });

            return html;
        };

        window.renderDivider = function renderDivider(section) {
            return `
                <div class="flex items-center gap-4 my-8">
                    <div class="flex-1 border-t border-gray-300"></div>
                    <span class="text-sm text-gray-500 font-medium">${section.text}</span>
                    <div class="flex-1 border-t border-gray-300"></div>
                </div>
            `;
        }

        window.renderForm = function renderForm(formData, logo) {
            let html = `
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                    <div class="p-8">
                        <div class="flex flex-col xl:flex-row gap-8">
            `;

            // Render logo if exists
            if (logo) {
                html += `
                    <div class="xl:w-1/6 flex flex-col items-center justify-center">
                        <div class="">
                            <img src="${logo.src}" alt="${logo.alt}" class="h-auto w-auto" />
                        </div>
                    </div>
                `;
            }

            // Render form fields
            html += `
                <div class="${logo ? 'xl:w-2/5' : 'xl:w-full'} flex flex-col">
                    <form class="space-y-4">
            `;

            formData.fields.forEach(field => {
                html += window.renderFormField(field);
            });

            // Render form buttons
            html += `
                        <div class="flex flex-col sm:flex-row gap-3 pt-3">
            `;

            formData.buttons.forEach(button => {
                const buttonClass = button.type === 'submit'
                    ? 'bg-[var(--primary)] hover:bg-[var(--primary-dark)] text-white font-semibold px-4 py-2 rounded-xl transition-colors'
                    : 'border border-[var(--primary)] text-[var(--primary)] hover:bg-[var(--light-1)] font-semibold px-4 py-2 rounded-xl transition-colors';

                html += `
                    <button type="${button.type}" class="${buttonClass}" data-action="${button.action}">
                        ${button.text}
                    </button>
                `;
            });

            html += `
                        </div>
                    </form>
                </div>
            `;

            html += `
                    </div>
                </div>
            </div>`;

            return html;
        };

        window.renderFormField = function renderFormField(field) {
            let html = `
                <div>
                    <label for="${field.id}" class="block text-sm font-semibold text-gray-700 ${field.type === 'select' ? 'mb-2' : 'mb-1'}">
                        ${field.label}${field.required ? '<span class="text-red-500">*</span>' : ''}
                    </label>
            `;

            if (field.type === 'select') {
                html += `
                    <select id="${field.id}" name="${field.id}" ${field.required ? 'required' : ''} ${field.disabled ? 'disabled' : ''}
                        class="w-full px-3 py-2 border border-gray-300 rounded-xl ${field.disabled ? 'bg-gray-50' : 'bg-white'} text-gray-700 transition-all duration-200 appearance-none cursor-pointer"
                        style="background-image: url('data:image/svg+xml;charset=UTF-8,%3csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22rgb(55,65,81)%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3e%3cpolyline points=%226 9 12 15 18 9%22%3e%3c/polyline%3e%3c/svg%3e'); background-repeat: no-repeat; background-position: right 0.5rem center; background-size: 1em 1em; padding-right: 2.5rem;">
                `;

                field.options.forEach(option => {
                    html += `<option value="${option.value}" ${option.selected ? 'selected' : ''}>${option.text}</option>`;
                });

                html += `</select>`;
            } else {
                html += `
                    <input
                        class="w-full border rounded-xl px-3 py-2 mb-0 text-gray-800 placeholder-gray-500 focus:outline-none bg-white transition-all duration-200"
                        id="${field.id}" name="${field.id}" placeholder="${field.placeholder}" 
                        type="${field.type}" ${field.required ? 'required' : ''} />
                `;

                if (field.errorMessage) {
                    html += `<p id="error${field.id.charAt(0).toUpperCase() + field.id.slice(1)}" class="text-red-500 text-xs mt-1 error-field hidden">${field.errorMessage}</p>`;
                }
            }

            html += `</div>`;

            return html;
        };

        window.renderHowToCreate = function renderHowToCreate(howToCreateData) {
            let html = `
                <div class="mt-12">
                    <div class="mb-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">${howToCreateData.title}</h2>
                        <p class="text-gray-600">${howToCreateData.description}</p>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-xl p-8">
            `;

            // Render info alert if exists
            if (howToCreateData.infoAlert) {
                html += `
                    <div class="bg-white border border-gray-200 rounded-xl p-4 mb-8 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-${howToCreateData.infoAlert.icon} text-blue-900">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <p class="text-sm text-blue-900">${howToCreateData.infoAlert.text}</p>
                    </div>
                `;
            }

            // Render steps if exists
            if (howToCreateData.steps && howToCreateData.steps.length > 0) {
                html += `<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-8">`;

                howToCreateData.steps.forEach((step, index) => {
                    html += `
                        <div class="text-center">
                            <div class="rounded-xl mb-4 h-180 flex items-center justify-center">
                                <div class="">
                                    <img src="${step.image}" alt="Step ${index + 1}" class="h-auto w-auto" />
                                </div>
                            </div>
                            <p class="text-sm text-gray-600">${index + 1}. ${step.text}</p>
                        </div>
                    `;
                });

                html += `</div>`;
            }

            // Render success alert if exists
            if (howToCreateData.successAlert) {
                html += `
                    <div class="bg-green-50 border border-green-200 rounded-xl p-4 mt-8 flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-green-600 flex-shrink-0">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <p class="text-sm text-green-900">${howToCreateData.successAlert.text}</p>
                    </div>
                `;
            }

            html += `
                    </div>
                </div>
            `;

            return html;
        };

        // Event Handlers
        window.addEventListeners = function addEventListeners() {
            // Back button
            const backButton = document.querySelector('.back-button');
            if (backButton) {
                backButton.addEventListener('click', function () {
                    const action = this.getAttribute('data-action');
                    window.handleAction(action);
                });
            }

            // Next button
            const nextButton = document.querySelector('[data-action="goToPage3"]');
            if (nextButton) {
                nextButton.addEventListener('click', function () {
                    handleAction('goToPage3');
                });
            }

            // Merchant selection
            const merchantButtons = document.querySelectorAll('[data-merchant]');
            merchantButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const merchantId = this.getAttribute('data-merchant');

                    // Sabhi merchants ke borders reset karein
                    merchantButtons.forEach(btn => {
                        if (!btn.disabled) {
                            btn.classList.remove('border-[var(--primary)]', 'border-1');
                            btn.classList.add('border-gray-200');
                        }
                    });

                    // Selected merchant ka border highlight karein
                    if (merchantId && window.appData.merchants[merchantId]) {
                        this.classList.remove('border-gray-200');
                        this.classList.add('border-[var(--primary)]', 'border-1');
                        window.appData.selectedMerchant = merchantId;
                    }
                });
            });

            // Form buttons
            const formButtons = document.querySelectorAll('form button[data-action]');
            formButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    if (this.type === 'submit') {
                        e.preventDefault();
                    }
                    const action = this.getAttribute('data-action');
                    handleAction(action);
                });
            });
        }

        window.handleSendOTP = async function handleSendOTP() {
            if (!window.appData.selectedMerchant) {
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = 'Please select a merchant first.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);
                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
                return;
            }

            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;

                // Collect form data
                const form = document.querySelector('form');
                const bodyData = {
                    merchantId: merchantId,
                    type: 'sendotp'
                };

                // Add form fields to body
                if (form) {
                    const formData = new FormData(form);
                    for (let [key, value] of formData.entries()) {
                        bodyData[key] = value;
                    }
                }

                const response = await fetch('/api/user/merchant/upi/setup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(bodyData)
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    currentMerchant = window.appData.merchants[merchantId];
                    const message = data.message || 'OTP sent successfully';
                    openOtpPopup(message);
                } else {
                    throw new Error(data.message || 'Failed to send OTP');
                }
            } catch (error) {
                hideLoading();
                console.error('Send OTP error:', error);
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = error.message || 'Error sending OTP. Please try again.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);
                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
            }
        };

        window.handleConnect = async function handleConnect() {
            if (!window.appData.selectedMerchant) {
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = 'Please select a merchant first.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);
                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
                return;
            }

            try {
                showLoading();

                const csrfToken = "<%= csrfToken %>";
                const merchantId = window.appData.selectedMerchant;

                // Collect form data
                const form = document.querySelector('form');
                const bodyData = {
                    merchantId: merchantId,
                    type: 'connect'
                };

                // Add form fields to body
                if (form) {
                    const formData = new FormData(form);
                    for (let [key, value] of formData.entries()) {
                        bodyData[key] = value;
                    }
                }

                const response = await fetch('/api/user/merchant/upi/setup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(bodyData)
                });

                const data = await response.json();
                hideLoading();

                if (data.success) {
                    currentMerchant = window.appData.merchants[merchantId];
                    // Show success message and go back to page 1
                    const successMessages = document.getElementById('successMessage');
                    const successMessageText = document.getElementById('successMessageText');
                    successMessageText.textContent = data.message || 'Merchant connected successfully!';
                    successMessages.classList.remove('hidden');
                    const toastBox = successMessages.querySelector('.error-animate');
                    setTimeout(() => toastBox.classList.add('show'), 100);
                    openMerchantConnectPopup(currentMerchant.name);
                    setTimeout(() => {
                        successMessages.classList.add('hidden');

                    }, 200);
                    setTimeout(() => {
                        toastBox.classList.remove('show');

                    }, 3000);
                } else {
                    throw new Error(data.message || 'Failed to connect merchant');
                }
            } catch (error) {
                hideLoading();
                console.error('Connect error:', error);
                const errorMessages = document.getElementById('errorMessages');
                const errorMessageText = document.getElementById('errorMessageText');
                errorMessageText.textContent = error.message || 'Error connecting merchant. Please try again.';
                errorMessages.classList.remove('hidden');
                const toastBox = errorMessages.querySelector('.error-animate');
                setTimeout(() => toastBox.classList.add('show'), 100);
                setTimeout(() => {
                    toastBox.classList.remove('show');
                    setTimeout(() => errorMessages.classList.add('hidden'), 200);
                }, 3000);
            }
        };

        window.handleAction = function handleAction(action) {
            switch (action) {
                case 'backToPage1':
                    // Navigate to page 1 (not implemented in this example)
                    // Hide Page 2 with animation
                    const page2 = document.getElementById('page2');
                    page2.classList.add('page-fade-out');

                    setTimeout(() => {
                        // Hide Page 2
                        page2.classList.add('hidden');
                        page2.classList.remove('page-fade-out');

                        // Show Page 1
                        page1.classList.remove('hidden');
                    }, 300);
                    break;
                case 'backToPage2':
                    const page3 = document.getElementById('page3');

                    if (page3) {
                        page3.classList.add('page-fade-out');

                        setTimeout(() => {
                            page3.classList.add('hidden');
                            page3.classList.remove('page-fade-out');

                            // Ensure page2 exists and show it
                            let page2Back = document.getElementById('page2');
                            if (!page2Back) {
                                renderPage('page2');
                                page2Back = document.getElementById('page2');
                            }

                            if (page2Back) {
                                page2Back.classList.remove('hidden');
                            }
                        }, 300);
                    } else {
                        // If page3 doesn't exist, just ensure page2 is visible
                        let page2Back = document.getElementById('page2');
                        if (!page2Back) {
                            renderPage('page2');
                            page2Back = document.getElementById('page2');
                        }

                        if (page2Back) {
                            page2Back.classList.remove('hidden');
                        }
                    }
                    break;
                case 'goToPage3':
                    if (window.appData.selectedMerchant) {
                        const page2 = document.getElementById('page2');

                        // Hide page2 with animation
                        if (page2) {
                            page2.classList.add('page-fade-out');

                            setTimeout(() => {
                                page2.classList.add('hidden');
                                page2.classList.remove('page-fade-out');

                                // Render and show page3
                                window.renderPage('page3', window.appData.selectedMerchant);
                                const page3 = document.getElementById('page3');
                                if (page3) {
                                    page3.classList.remove('hidden');
                                }
                            }, 300);
                        } else {
                            window.renderPage('page3', window.appData.selectedMerchant);
                            const page3 = document.getElementById('page3');
                            if (page3) {
                                page3.classList.remove('hidden');
                            }
                        }
                    } else {
                        // Show error toast
                        const errorMessages = document.getElementById('errorMessages');
                        const errorMessageText = document.getElementById('errorMessageText')
                        errorMessageText.textContent = 'Please select a merchant first.';
                        errorMessages.classList.remove('hidden');
                        const toastBox = errorMessages.querySelector('.error-animate');
                        setTimeout(() => toastBox.classList.add('show'), 100);

                        setTimeout(() => {
                            toastBox.classList.remove('show');
                            setTimeout(() => errorMessages.classList.add('hidden'), 200);
                        }, 3000);
                    }
                    break;
                case 'sendOTP':
                    handleSendOTP();
                    break;
                case 'login':
                    handleSendOTP();
                    break;
                case 'connect':
                    handleConnect();
                    break;
            }
        }

        // Initialize the app
        document.addEventListener('DOMContentLoaded', function () {
            window.appData = getAppData();
            window.renderPage('page2');
        });
    </script>
</body>

</html>