<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connect UPI Merchant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/images/icon.png" type="image/png">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #181a20;
            --primary-light: #1e2329;
            --primary-dark: #2b3139;
            --primary-transparent: rgba(0, 0, 0, 0.1);
            --dark-1: #181a20;
            --dark-2: #1e2329;
            --dark-3: #2b3139;
            --light-1: #eaecef;
            --light-2: #b7bdc6;
            --light-3: #848e9c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: sans-serif;
            background-color: white;
            overflow-x: hidden;
            user-select: auto;

        }

        /* Hide scrollbar while keeping scroll functionality */
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            /* temporarily hides scroll */
        }

        body {
            overflow: auto;
            /* allow scroll inside body */

            /* Firefox */
            scrollbar-width: none;
            /* IE, Edge */
            -ms-overflow-style: none;
        }

        /* Chrome, Safari, Opera */
        body::-webkit-scrollbar {
            display: none;
        }


        body.modal-open {
            overflow: hidden;
        }

        /* Desktop Sidebar Styles */
        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: white;
            border-right: 1px solid rgb(234 236 239 / var(--tw-border-opacity, 1));
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-x: hidden;
        }

        /* Hide desktop sidebar on mobile */
        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0 !important;
            }
        }

        .sidebar.collapsed {
            width: 70px;
        }

        /* Hide text when collapsed */
        .sidebar.collapsed .sidebar-text,
        .sidebar.collapsed .sidebar-section,
        .sidebar.collapsed .nav-header {
            display: none !important;
        }

        /* Center logo when collapsed */
        .sidebar.collapsed .sidebar-top {
            justify-content: center;
            padding: 1rem 0;
        }

        /* Hide toggle button when collapsed */
        .sidebar.collapsed .sidebar-toggle {
            display: none;
        }

        /* Remove extra space for labels when collapsed */
        .sidebar.collapsed .nav-link-text {
            width: 0;
            opacity: 0;
            visibility: hidden;
        }

        /* Remove top/bottom padding from menu items when collapsed */
        .sidebar.collapsed .menu-item {
            padding: 6px 0 !important;
            justify-content: center;
            height: 48px;
            display: flex;
            align-items: center;
        }

        /* Remove menu gaps when collapsed */
        .sidebar.collapsed .menu-gap {
            height: 0;
        }

        /* Hover effects when collapsed AND hover-enabled */
        .sidebar.collapsed.hover-enabled:hover {
            width: 280px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-text,
        .sidebar.collapsed.hover-enabled:hover .sidebar-section,
        .sidebar.collapsed.hover-enabled:hover .nav-header {
            display: block !important;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-top {
            justify-content: space-between;
            padding: 1rem 1.5rem;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-item {
            justify-content: flex-start;
            padding: 12px 24px !important;
            height: 48px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-toggle {
            display: block;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-link-text {
            width: auto;
            opacity: 1;
            visibility: visible;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-gap {
            height: 1rem;
        }

        /* Main content adjustment */
        .main-content {
            margin-left: 280px;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
            padding: 20px;
            padding-bottom: 0px;
        }

        .sidebar.collapsed~.main-content {
            margin-left: 70px;
        }

        .sidebar.collapsed.hover-enabled:hover~.main-content {
            margin-left: 280px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            border-radius: 16px;
            margin-left: 8px;
            margin-bottom: 2px;
            margin-right: 8px;
            color: var(--primary-dark);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .menu-item:hover {
            background-color: #f3f4f6;
        }

        .menu-item.active {
            background-color: var(--primary-transparent);
            color: var(--primary);
        }

        .nav-icon-wrap {
            width: 24px;
            text-align: center;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar.collapsed .nav-icon-wrap {
            margin-right: 0;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-icon-wrap {
            margin-right: 12px;
        }

        .nav-link-text {
            transition: all 0.3s ease;
        }

        /* SVG icon styles */
        .svg-icon {
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .icon {
            width: 100%;
            height: 100%;
        }

        /* Toggle icon rotation */
        .sidebar-toggle .toggle-icon {
            transition: transform 0.2s ease;
        }

        .sidebar.collapsed .sidebar-toggle .toggle-icon {
            transform: scaleX(-1);
        }

        /* Menu groups */
        .menu-gap {
            height: 1rem;
            transition: height 0.2s ease;
        }

        .sidebar.collapsed .menu-gap {
            height: 0;
        }

        .nav-header {
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            color: #6b7280;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* Mobile Sidebar Styles */
        .mobile-sidebar {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100vh;
            background: white;
            border-right: 1px solid #eaecef;
            transition: all 0.3s ease;
            z-index: 1001;

            overflow-y: auto;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .mobile-sidebar.active {
            left: 0;
        }

        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s ease;
            animation: feedFadeIn 0.4s ease forwards;
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
            animation: feedFadeIn 0.4s ease forwards;
        }

        .sidebar-overlay.hidden {
            animation: feedFadeOut 0.3s ease forwards;
        }

        @keyframes feedFadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @keyframes feedFadeOut {
            from {
                opacity: 1;
            }

            to {
                opacity: 0;
            }
        }

        /* Header Styles */
        .content-header {
