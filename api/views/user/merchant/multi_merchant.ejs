                    </button>
                </div>
            </div>
        </div>
        <script type="module">
            // Merchant data
            const merchantsData = JSON.parse('<%- JSON.stringify(merchants) %>');

            const merchantTypeConfig = {
                bharatpe: {
                    name: 'BharatPe For Merchants',
                    logo: '/images/setup_upi/logo/bharatpe_merchants.png',
                    icon: 'fa-mobile-alt',
                    fields: ['phone', 'businessName'],
                    displayName: (m) => m.businessName || 'BharatPe Account'
                },
                freecharge: {
                    name: 'Freecharge',
                    logo: '/images/setup_upi/logo/freecharge.png',
                    icon: 'fa-mobile-alt',
                    fields: ['phone', 'vpa'],
                    displayName: (m) => 'Freecharge'
                },
                hdfc: {
                    name: 'HDFC Bank SmartHub Vyapar',
                    logo: '/images/setup_upi/logo/hdfc_hub.png',
                    icon: 'fa-mobile-alt',
                    fields: ['phone', 'vpa'],
                    displayName: (m) => 'HDFC Bank SmartHub Vyapar'
                },
                paytm: {
                    name: 'Paytm For Business',
                    logo: '/images/setup_upi/logo/paytm_business.png',
                    icon: 'fa-mobile-alt',
                    fields: ['phone'],
                    displayName: (m) => 'Paytm For Business'
                },
                phonepe: {
                    name: 'PhonePe Business',
                    logo: '/images/setup_upi/logo/phonepe_business.png',
                    icon: 'fa-mobile-alt',
                    fields: ['phone', 'vpa'],
                    displayName: (m) => m.store_name || 'PhonePe Business'
                },
                quintuspay: {
                    name: 'QuintusPay',
                    logo: '/images/setup_upi/logo/quintuspay_business.webp',
                    icon: 'fa-mobile-alt',
                    fields: ['phone', 'vpa'],
                    displayName: (m) => m.business_name || 'QuintusPay'
                },
                yono_sbi: {
                    name: 'YONO SBI Merchant',
                    logo: '/images/setup_upi/logo/yono_sbi.png',
                    icon: 'fa-id-card',
                    fields: ['mid', 'vpa'],
                    displayName: (m) => 'YONO SBI Merchant'
                }
            };

            // Function to copy Merchant ID
            window.copyMerchantId = function copyMerchantId(merchantId, button) {
                navigator.clipboard.writeText(merchantId).then(() => {
                    // Store original content
                    const originalHTML = button.innerHTML;
                    const originalText = button.textContent;

                    // Show success
                    button.style.backgroundColor = '#10b981';
                    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

                    showToast('Merchant ID copied successfully!', 'success');

                    // Reset after 2 seconds
                    setTimeout(() => {
                        button.style.backgroundColor = '';
                        button.innerHTML = originalHTML;
                    }, 2000);
                }).catch(err => {
                    console.error('Failed to copy:', err);
                    showToast('Failed to copy Merchant ID', 'error');
                });
            }

            function getPhoneForMerchant(merchant, merchantType) {
                if (merchantType === 'paytm') return merchant.paytm_phone;
                if (merchantType === 'bharatpe') return merchant.mobile ? merchant.mobile.replace('91', '') : merchant.bharatpe_number;
                if (merchantType === 'yono_sbi') return '';
                return merchant.phone_number || '';
            }

            function getMidForMerchant(merchant, merchantType) {
                if (merchantType === 'yono_sbi') return merchant.mid || '';
                return '';
            }

            function groupPaytmByPhone() {
                const grouped = {};
                merchantsData.merchants_paytm.forEach(m => {
                    const phone = m.paytm_phone;
                    if (!grouped[phone]) {
                        grouped[phone] = { ...m, allVpas: [] };
                    }
                    grouped[phone].allVpas.push(m.vpa);
                });
                return Object.values(grouped);
            }

            function renderMerchantCards() {
                const grid = document.getElementById('merchantGrid');
                grid.innerHTML = '';

                let totalCards = 0;

                // Render all merchant types
                Object.entries(merchantsData).forEach(([key, merchants]) => {
                    if (key === 'userid' || !Array.isArray(merchants)) return;

                    const merchantType = key.replace('merchants_', '');
                    const config = merchantTypeConfig[merchantType];
                    if (!config) return;

                    let cardsToRender = merchants;

                    // Group Paytm by phone
                    if (merchantType === 'paytm') {
                        cardsToRender = groupPaytmByPhone();
                    }

                    cardsToRender.forEach(merchant => {
                        const isActive = (merchant.status === 'active' || merchant.status === '1');
                        const displayName = config.displayName(merchant);
                        const phone = getPhoneForMerchant(merchant, merchantType);
                        const mid = getMidForMerchant(merchant, merchantType);
                        const vpa = merchant.vpa || '';
                        const allVpas = merchant.allVpas || [];

                        const card = document.createElement('div');
                        card.className = 'merchant-card bg-white rounded-xl border border-gray-200 p-6 relative overflow-hidden';
                        card.setAttribute('data-merchant-id', merchant.merchant_txnid);
                        card.setAttribute('data-merchant-type', merchantType);
                        card.setAttribute('data-merchant-object', JSON.stringify(merchant));

                        let detailsHtml = '';
                        if (merchantType === 'paytm' && allVpas.length > 0) {
                            detailsHtml = `
                            <div class="flex items-center">
                                <i class="fas fa-mobile-alt text-gray-400 mr-2 w-4"></i>
                                <span>${phone}</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-qrcode text-gray-400 mr-2 w-4"></i>
                                <span class="truncate">${allVpas[0]}</span>
                            </div>
                        `;
                        } else if (merchantType === 'yono_sbi') {
                            detailsHtml = `
                            <div class="flex items-center">
                                <i class="fas fa-id-card text-gray-400 mr-2 w-4"></i>
                                <span>MID: ${mid}</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-qrcode text-gray-400 mr-2 w-4"></i>
                                <span class="truncate">${vpa}</span>
                            </div>
                        `;
                        } else if (merchantType === 'bharatpe') {
                            detailsHtml = `
                            <div class="flex items-center">
                                <i class="fas fa-mobile-alt text-gray-400 mr-2 w-4"></i>
                                <span>${phone}</span>
                            </div>
                            ${merchant.vpa ? `<div class="flex items-center">
                                <i class="fas fa-qrcode text-gray-400 mr-2 w-4"></i>
                                <span class="truncate">${merchant.vpa}</span>
                            </div>` : ''}
                        `;
                        } else {
                            detailsHtml = `
                            <div class="flex items-center">
                                <i class="fas fa-mobile-alt text-gray-400 mr-2 w-4"></i>
                                <span>${phone}</span>
                            </div>
                            ${vpa ? `<div class="flex items-center">
                                <i class="fas fa-qrcode text-gray-400 mr-2 w-4"></i>
                                <span class="truncate">${vpa}</span>
                            </div>` : ''}
                        `;
                        }

                        card.innerHTML = `
                        <div class="flex items-start space-x-4">
                            <div class="w-16 h-16 bg-gray-100 rounded-xl border border-gray-200 flex items-center justify-center overflow-hidden flex-shrink-0">
                                <img src="${config.logo}" alt="${displayName}" class="w-16 h-16 object-contain">
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-semibold text-gray-900 truncate">${config.name}</h3>
                                <p class="text-sm text-gray-500 mb-2">General Merchant</p>
                                <div class="space-y-1 text-sm text-gray-600">
                                    ${detailsHtml}
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                            <div class="flex items-center">
                                <div class="w-2 h-2 ${isActive ? 'bg-green-500' : 'bg-red-500'} rounded-full mr-2"></div>
                                <span class="text-sm ${isActive ? 'text-green-600' : 'text-red-600'} font-medium">${isActive ? 'Active' : 'Inactive'}</span>
                            </div>
                            <div class="flex space-x-2">
                                <button class="text-blue-600 hover:text-blue-800 p-2 rounded-lg hover:bg-blue-50 transition-colors edit-merchant-btn" data-merchant-phone="${phone}" data-merchant-vpa="${vpa}" data-merchant-mid="${mid}" data-merchant-all-vpas='${JSON.stringify(allVpas)}' data-merchant-status="${isActive ? 'active' : 'inactive'}" title="Edit Details">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition-colors delete-merchant-btn" data-merchant-name="${config.name}" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    `;

                        grid.appendChild(card);
                        totalCards++;
                    });
                });

                if (totalCards === 0) {
                    document.getElementById('emptyState').classList.remove('hidden');
                } else {
                    document.getElementById('emptyState').classList.add('hidden');
                }

                attachEventListeners();
            }

            function generateModalFields(merchantType, merchant, merchantId) {
                const container = document.getElementById('dynamicFieldsContainer');
                container.innerHTML = '';

                // Add Merchant ID at the top
                container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Merchant ID</label>
                        <div class="flex items-center gap-2">
                            <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchantId || ''}" readonly id="merchantIdField">
                            <button type="button" onclick="copyMerchantId('${merchantId}', this)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors font-medium text-sm text-white whitespace-nowrap flex items-center justify-center" title="Copy Merchant ID" style="min-width: 44px; height: 40px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                </svg>
                            </button>
                        </div>
                    </div>
                `;

                if (merchantType === 'bharatpe') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Business Name</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.businessName || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.mobile ? merchant.mobile.replace('91', '') : merchant.bharatpe_number || ''}" readonly>
                    </div>
                    ${merchant.vpa ? `<div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Address</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.vpa}" readonly>
                    </div>` : ''}
                  
                `;
                } else if (merchantType === 'freecharge') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.phone_number || ''}" readonly>
                    </div>
                    ${merchant.vpa ? `<div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">UPI ID (VPA Address)</label>
                        <input type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2" id="upiIdEditField" value="${merchant.vpa}" placeholder="username@freecharge">
                        <p class="text-xs text-gray-500 mt-1">Must be in format: username@freecharge</p>
                    </div>` : ''}
                   
                `;
                } else if (merchantType === 'hdfc') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Name</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.name || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.phone_number || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Address</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.vpa || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">CompanyName</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.companyName || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Terminal Id</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.terminal_id || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.role || ''}" readonly>
                    </div>
                `;
                } else if (merchantType === 'paytm') {
                    const allVpas = merchant.allVpas || [];
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.paytm_phone || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Addresses</label>
                        <div class="space-y-2">
                            ${allVpas.map((vpa) => `
                                <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" value="${vpa}" readonly>
                            `).join('')}
                        </div>
                    </div>
                `;
                } else if (merchantType === 'phonepe') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.phone_number || ''}" readonly>
                    </div>
                    ${merchant.store_name ? `<div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Store Name</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.store_name}" readonly>
                    </div>` : ''}
                    ${merchant.vpa ? `<div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Address</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.vpa}" readonly>
                    </div>` : ''}
                `;
                } else if (merchantType === 'quintuspay') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Business Name</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.business_name || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.phone_number || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Address</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.vpa || ''}" readonly>
                    </div>
                `;
                } else if (merchantType === 'yono_sbi') {
                    container.innerHTML += `
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">MID</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.mid || ''}" readonly>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">VPA Address</label>
                        <input type="text" class="readonly-field w-full border border-gray-300 rounded-lg px-3 py-2" value="${merchant.vpa || ''}" readonly>
                    </div>
                `;
                }

                container.innerHTML += `
                <div class="flex items-center justify-between pt-2 border-t border-gray-200">
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <label class="switch">
                        <input type="checkbox" id="editMerchantStatus">
                        <span class="slider"></span>
                    </label>
                </div>
            `;
            }

            function attachEventListeners() {
                document.querySelectorAll('.edit-merchant-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        const card = this.closest('.merchant-card');
                        const merchantId = card.getAttribute('data-merchant-id');
                        const merchantType = card.getAttribute('data-merchant-type');
                        const merchantDataStr = card.getAttribute('data-merchant-object');

                        let merchant;
                        try {
                            merchant = merchantDataStr ? JSON.parse(merchantDataStr) : null;
                        } catch (e) {
                            console.error('Failed to parse merchant data:', e);
                            merchant = null;
                        }

                        if (!merchant) {
                            showToast('Error: Could not load merchant data', 'error');
                            return;
                        }

                        document.getElementById('editMerchantId').value = merchantId;
                        document.getElementById('editMerchantType').value = merchantType;

                        generateModalFields(merchantType, merchant, merchantId);

                        const statusCheckbox = document.getElementById('editMerchantStatus');
                        statusCheckbox.checked = this.getAttribute('data-merchant-status') === 'active';

                        document.getElementById('editMerchantModal').classList.remove('hidden');
                        document.body.style.overflow = 'hidden';
                    });
                });

                document.querySelectorAll('.delete-merchant-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        const merchantName = this.getAttribute('data-merchant-name');
                        document.getElementById('deleteMerchantMessage').textContent = `Are you sure you want to delete ${merchantName}? This action cannot be undone.`;
                        document.getElementById('deleteMerchantModal').classList.remove('hidden');
                        document.body.style.overflow = 'hidden';

                        const card = this.closest('.merchant-card');
                        document.getElementById('deleteMerchantModal').merchantCardToDelete = card;
                    });
                });
            }

            document.getElementById('cancelEditBtn').addEventListener('click', function () {
                document.getElementById('editMerchantModal').classList.add('hidden');
                document.body.style.overflow = 'auto';
            });

            document.getElementById('saveMerchantBtn').addEventListener('click', async function () {
                const merchantId = document.getElementById('editMerchantId').value;
                const merchantType = document.getElementById('editMerchantType').value;
                const newStatus = document.getElementById('editMerchantStatus').checked;
                const csrfToken = "<%= csrfToken %>";

                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Saving...';

                try {
                    const bodyData = {
                        merchantTXNID: merchantId,
                        status: newStatus
                    };

                    // If FreeCharge and UPI ID field exists, add it to the request
                    if (merchantType === 'freecharge') {
                        const upiIdField = document.getElementById('upiIdEditField');
                        if (upiIdField) {
                            const upiId = upiIdField.value.trim();

                            // Validate UPI ID format
                            const upiRegex = /^[a-zA-Z0-9._-]+@freecharge$/i;
                            if (upiId && !upiRegex.test(upiId)) {
                                showToast('UPI ID must be in format: username@freecharge', 'error');
                                this.disabled = false;
                                this.textContent = 'Save Changes';
                                return;
                            }

                            if (upiId) {
                                bodyData.upiId = upiId;
                            }
                        }
                    }

                    const response = await fetch('/api/user/multi/merchant/status', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify(bodyData)
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        const card = document.querySelector(`[data-merchant-id="${merchantId}"]`);
                        const statusContainer = card.querySelector('.mt-4.pt-4');
                        const statusDot = statusContainer.querySelector('.w-2.h-2');
                        const statusText = statusContainer.querySelector('.font-medium');
                        const editBtn = card.querySelector('.edit-merchant-btn');

                        if (newStatus === true) {
                            statusText.textContent = 'Active';
                            statusText.className = 'text-sm text-green-600 font-medium';
                            statusDot.className = 'w-2 h-2 bg-green-500 rounded-full mr-2';
                        } else {
                            statusText.textContent = 'Inactive';
                            statusText.className = 'text-sm text-red-600 font-medium';
                            statusDot.className = 'w-2 h-2 bg-red-500 rounded-full mr-2';
                        }

                        editBtn.setAttribute('data-merchant-status', newStatus ? 'active' : 'inactive');

                        document.getElementById('editMerchantModal').classList.add('hidden');
                        document.body.style.overflow = 'auto';

                        this.disabled = false;
                        this.textContent = 'Save Changes';

                        showToast('Merchant updated successfully!', 'success');
                    } else {
                        showToast(data.message || 'Failed to update merchant', 'error');
                        this.disabled = false;
                        this.textContent = 'Save Changes';
                    }
                } catch (error) {
                    console.error('Error updating merchant:', error);
                    showToast('An error occurred while updating merchant', 'error');
                    this.disabled = false;
                    this.textContent = 'Save Changes';
                }
            });

            document.getElementById('cancelDeleteBtn').addEventListener('click', function () {
                document.getElementById('deleteMerchantModal').classList.add('hidden');
                document.body.style.overflow = 'auto';
            });

            document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
                const modal = document.getElementById('deleteMerchantModal');
                const card = modal.merchantCardToDelete;
                const merchantId = card.getAttribute('data-merchant-id');
                const merchantType = card.getAttribute('data-merchant-type');
                const csrfToken = "<%= csrfToken %>";

                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Deleting...';

                try {
                    const response = await fetch('/api/user/multi/merchant/delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            merchantTxnId: merchantId,
                            merchantType: merchantType
                        })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        card.remove();

                        if (document.querySelectorAll('.merchant-card').length === 0) {
                            document.getElementById('emptyState').classList.remove('hidden');
                        }

                        modal.classList.add('hidden');
                        document.body.style.overflow = 'auto';

                        showToast('Merchant deleted successfully!', 'success');
                        this.disabled = false;
                        this.textContent = 'Delete';
                    } else {
                        showToast(data.message || 'Failed to delete merchant', 'error');
                        this.disabled = false;
                        this.textContent = 'Delete';
                    }
                } catch (error) {
                    console.error('Error deleting merchant:', error);
                    showToast('An error occurred while deleting merchant', 'error');
                    this.disabled = false;
                    this.textContent = 'Delete';
                }
            });

            [document.getElementById('editMerchantModal'), document.getElementById('deleteMerchantModal')].forEach(modal => {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) {
                        modal.classList.add('hidden');
                        document.body.style.overflow = 'auto';
                    }
                });
            });

            function showToast(message, type = 'info') {
                const toast = document.createElement('div');
                toast.className = `fixed bottom-4 left-1/2 transform -translate-x-1/2 px-6 py-3 rounded-lg shadow-lg z-[10000] transition-all duration-300 ${type === 'success' ? 'bg-green-500 text-white' :
                    type === 'error' ? 'bg-red-500 text-white' :
                        'bg-blue-500 text-white'
                    }`;
                toast.textContent = message;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.remove();
                }, 3000);
            }

            document.addEventListener('DOMContentLoaded', renderMerchantCards);
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebar');
            const profileDropdown = document.getElementById('profileDropdown');
            const dropdownMenu = document.getElementById('dropdownMenu');
            const mobileHamburger = document.getElementById('mobileHamburger');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileSidebarClose = document.getElementById('mobileSidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            let hoverEnabled = false;
            let isCollapsed = false;

            // Desktop sidebar toggle
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }


            // Mobile sidebar toggle
            if (mobileHamburger) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            // Close mobile sidebar
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Profile dropdown functionality
            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            // Close mobile sidebar when clicking menu items
            const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });


        </script>
</body>

</html>