        <script type="text/javascript">
            // Set the cursor ASAP to "Wait"
            document.body.style.cursor = 'wait';

            // When the window has finished loading, set it back to default...
            window.onload = function () { document.body.style.cursor = 'default'; }
        </script>

        <script type="module">

            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebar');
            const profileDropdown = document.getElementById('profileDropdown');
            const dropdownMenu = document.getElementById('dropdownMenu');
            const mobileHamburger = document.getElementById('mobileHamburger');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileSidebarClose = document.getElementById('mobileSidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            let hoverEnabled = false;
            let isCollapsed = false;

            // Desktop sidebar toggle
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }


            // Mobile sidebar toggle
            if (mobileHamburger) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            // Close mobile sidebar
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Profile dropdown functionality
            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            // Close mobile sidebar when clicking menu items
            const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });

            // Plan data from server
            const plansData = JSON.parse('<%- JSON.stringify(plansData) %>');

            // Function to get icon SVG based on icon_type
            function getPlanIcon(iconType) {
                const icons = {
                    'shield': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] icon-border">
                                <circle cx="12" cy="8" r="7"></circle>
                                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                            </svg>`,
                    'star': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] icon-border">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>`,
                    'building': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] icon-border">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>`,
                    'creditcard': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] icon-border">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>`
                };
                return icons[iconType] || icons['shield'];
            }

            // Function to generate plan card HTML
            function generatePlanCard(plan) {
                const badgeHtml = plan.badge_text ?
                    `<div class="absolute  top-0 right-0 bg-[var(--primary)] text-white text-xs font-semibold px-3 py-1 rounded-bl-lg shadow">${plan.badge_text}</div>` :
                    '';

                const featuresHtml = plan.features.map(feature => {
                    const checkIcon = feature.included ?
                        `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] mr-2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>` :
                        `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>`;

                    const textClass = feature.included ? 'text-gray-700' : 'text-red-500';

                    return `<li class="flex items-center ${textClass}">
                        ${checkIcon}
                        ${feature.name}
                    </li>`;
                }).join('');

                return `
                    <div class="plan-card" data-plan-id="${plan.plan_id}">
                        <div class="border border-gray-200 rounded-xl p-6 bg-white shadow-sm transition relative overflow-hidden">
                        ${badgeHtml}
                        ${plan.is_recommended ? `<div class="absolute top-0 right-0 bg-[var(--primary)] text-white text-xs font-semibold px-3 py-1 rounded-bl-lg shadow">Recommended</div>` : ''}
                        
                        <h4 class="text-center mt-3 mb-4 font-semibold text-gray-800">${plan.plan_name}</h4>

                        <div class="flex justify-center mb-4">
                            ${getPlanIcon(plan.icon_type)}
                        </div>

                        <h1 class="text-center" style="font-size: 28px;">₹${plan.price}</h1>
                        <p class="text-gray-600 text-center mb-4">per ${plan.plan_cycle_days} Days</p>

                        <h5 class="text-[var(--primary)] text-center mb-4">${plan.qr_code_requests_limit.toLocaleString()} QR Code Request</h5>

                        <ul class="space-y-2 text-gray-700 text-sm">
                            ${featuresHtml}
                        </ul>

                        <div class="flex justify-center items-center gap-3 mt-5">
                            <button type="button" class="border px-3 rounded decrease-qty" data-price="${plan.price}" style="cursor: pointer;">-</button>
                            <span class="qty-display" style="min-width: 30px; text-align: center;">1</span>
                            <button type="button" class="border px-3 rounded increase-qty" data-price="${plan.price}" style="cursor: pointer;">+</button>
                        </div>

                        <button type="button"
                            class="w-full bg-[var(--primary)] hover:bg-[var(--primary-light)] text-white py-2 rounded-lg mt-4 font-medium transition buy-plan-btn"
                            data-plan-id="${plan.plan_id}"
                            data-price="${plan.price}"
                            style="cursor: pointer;">
                            Buy Now ₹${plan.price}
                        </button>
                    </div>
                    </div>
                `;
            }

            // Function to render plans by type
            function renderPlans() {
                const monthlyContainer = document.getElementById('monthly-plans-container');
                const quarterlyContainer = document.getElementById('quarterly-plans-container');

                // Clear existing content
                monthlyContainer.innerHTML = '';
                quarterlyContainer.innerHTML = '';

                // Filter and render monthly plans
                const monthlyPlans = plansData.filter(plan => plan.plan_type === 'monthly');
                monthlyPlans.forEach(plan => {
                    monthlyContainer.innerHTML += generatePlanCard(plan);
                });

                // Filter and render quarterly plans
                const quarterlyPlans = plansData.filter(plan => plan.plan_type === 'quarterly');
                quarterlyPlans.forEach(plan => {
                    quarterlyContainer.innerHTML += generatePlanCard(plan);
                });

                // Attach event listeners after rendering
                attachQuantityListeners();
            }

            // Function to attach quantity button listeners
            async function attachQuantityListeners() {
                // Decrease quantity buttons
                document.querySelectorAll('.decrease-qty').forEach(btn => {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        const card = this.closest('.plan-card');
                        const qtyDisplay = card.querySelector('.qty-display');
                        const buyBtn = card.querySelector('.buy-plan-btn');

                        if (qtyDisplay && buyBtn) {
                            let qty = parseInt(qtyDisplay.textContent) || 1;

                            if (qty > 1) {
                                qty--;
                                qtyDisplay.textContent = qty;
                                updateBuyButtonPrice(buyBtn, qty);
                            }
                        }
                    });
                });

                // Increase quantity buttons
                document.querySelectorAll('.increase-qty').forEach(btn => {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        const card = this.closest('.plan-card');
                        const qtyDisplay = card.querySelector('.qty-display');
                        const buyBtn = card.querySelector('.buy-plan-btn');

                        if (qtyDisplay && buyBtn) {
                            let qty = parseInt(qtyDisplay.textContent) || 1;

                            qty++;
                            qtyDisplay.textContent = qty;
                            updateBuyButtonPrice(buyBtn, qty);
                        }
                    });
                });

                // Buy plan buttons
                document.querySelectorAll('.buy-plan-btn').forEach(btn => {
                    btn.addEventListener('click', async function (e) {
                        e.preventDefault();
                        const planId = this.dataset.planId;
                        const price = parseFloat(this.dataset.price);
                        const card = this.closest('.plan-card');
                        const qtyDisplay = card.querySelector('.qty-display');

                        if (qtyDisplay) {
                            const qty = parseInt(qtyDisplay.textContent) || 1;
                            const totalPrice = price * qty;

                            console.log({
                                plan_id: planId,
                                quantity: qty,
                                unit_price: price,
                                total_price: totalPrice
                            });


                            // show loading 
                            document.getElementById('loading').classList.remove('hidden');
                            try {

                                const csrfToken = "<%= csrfToken %>";

                                // Call API to verify OTP
                                const response = await fetch('/api/user/plan/buy', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'CSRF-Token': csrfToken
                                    },
                                    body: JSON.stringify({
                                        plan_id: planId,
                                        quantity: qty
                                    })
                                });

                                // Hide loading
                                document.getElementById('loading').classList.add('hidden');

                                const data = await response.json();

                                if (data.status) {

                                    gtag('event', 'conversion', {
                                        'send_to': 'AW-777328699/bC4-COaV_90ZELuw1PIC',
                                        'value': totalPrice,
                                        'currency': 'INR'
                                    });
                                    // Redirect to payment page
                                    window.location.href = data.data.payment_link;

                                }
                            } catch (error) {
                                console.error('Error verifying OTP:', error);
                            }
                        }
                    });
                });
            }

            // Function to update buy button price
            function updateBuyButtonPrice(buyBtn, qty) {
                const price = parseFloat(buyBtn.dataset.price);
                const totalPrice = Number(price * qty).toFixed(2);
                buyBtn.textContent = `Buy Now ₹${totalPrice}`;
            }

            // Initialize plans when DOM is loaded
            document.addEventListener('DOMContentLoaded', renderPlans);

        </script>
</body>

</html>