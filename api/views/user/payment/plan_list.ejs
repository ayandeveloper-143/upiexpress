    <style>
        :root {
            --primary: #181a20;
            --primary-light: #1e2329;
            --primary-dark: #2b3139;
            --primary-transparent: rgba(0, 0, 0, 0.1);
            --dark-1: #181a20;
            --dark-2: #1e2329;
            --dark-3: #2b3139;
            --light-1: #eaecef;
            --light-2: #b7bdc6;
            --light-3: #848e9c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: sans-serif;
            background-color: white;
            overflow-x: hidden;
            user-select: auto;

        }


        /* Hide scrollbar while keeping scroll functionality */
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            /* temporarily hides scroll */
        }

        body {
            overflow: auto;
            /* allow scroll inside body */

            /* Firefox */
            scrollbar-width: none;
            /* IE, Edge */
            -ms-overflow-style: none;
        }

        /* Page Animation Styles */
        .page-content {
            animation: feedPageFadeIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .page-content.page-fade-out {
            animation: feedPageFadeOut 0.3s ease forwards;
        }


        @keyframes feedPageFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes feedPageFadeOut {
            from {
                opacity: 1;
                transform: translateY(0);
            }

            to {
                opacity: 0;
                transform: translateY(-20px);
            }
        }

        /* Desktop Sidebar Styles */
        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: white;
            border-right: 1px solid rgb(234 236 239 / var(--tw-border-opacity, 1));
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-x: hidden;
        }

        /* Hide desktop sidebar on mobile */
        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0 !important;
            }
        }

        .sidebar.collapsed {
            width: 70px;
        }

        /* Hide text when collapsed */
        .sidebar.collapsed .sidebar-text,
        .sidebar.collapsed .sidebar-section,
        .sidebar.collapsed .nav-header {
            display: none !important;
        }

        /* Center logo when collapsed */
        .sidebar.collapsed .sidebar-top {
            justify-content: center;
            padding: 1rem 0;
        }

        /* Hide toggle button when collapsed */
        .sidebar.collapsed .sidebar-toggle {
            display: none;
        }

        /* Remove extra space for labels when collapsed */
        .sidebar.collapsed .nav-link-text {
            width: 0;
            opacity: 0;
            visibility: hidden;
        }

        /* Remove top/bottom padding from menu items when collapsed */
        .sidebar.collapsed .menu-item {
            padding: 6px 0 !important;
            justify-content: center;
            height: 48px;
            display: flex;
            align-items: center;
        }

        /* Remove menu gaps when collapsed */
        .sidebar.collapsed .menu-gap {
            height: 0;
        }

        /* Hover effects when collapsed AND hover-enabled */
        .sidebar.collapsed.hover-enabled:hover {
            width: 280px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-text,
        .sidebar.collapsed.hover-enabled:hover .sidebar-section,
        .sidebar.collapsed.hover-enabled:hover .nav-header {
            display: block !important;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-top {
            justify-content: space-between;
            padding: 1rem 1.5rem;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-item {
            justify-content: flex-start;
            padding: 12px 24px !important;
            height: 48px;
        }

        .sidebar.collapsed.hover-enabled:hover .sidebar-toggle {
            display: block;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-link-text {
            width: auto;
            opacity: 1;
            visibility: visible;
        }

        .sidebar.collapsed.hover-enabled:hover .menu-gap {
            height: 1rem;
        }

        /* Main content adjustment */
        .main-content {
            margin-left: 280px;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
            padding: 20px;
            padding-bottom: 0px;
        }

        .sidebar.collapsed~.main-content {
            margin-left: 70px;
        }

        .sidebar.collapsed.hover-enabled:hover~.main-content {
            margin-left: 280px;
        }

        /* Menu item styles */
        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            border-radius: 16px;
            margin-left: 8px;
            margin-bottom: 2px;
            margin-right: 8px;
            color: var(--primary-dark);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .menu-item:hover {
            background-color: #f3f4f6;
        }

        .menu-item.active {
            background-color: var(--primary-transparent);
            color: var(--primary);
        }

        .nav-icon-wrap {
            width: 24px;
            text-align: center;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar.collapsed .nav-icon-wrap {
            margin-right: 0;
        }

        .sidebar.collapsed.hover-enabled:hover .nav-icon-wrap {
            margin-right: 12px;
        }

        .nav-link-text {
            transition: all 0.3s ease;
        }

        /* SVG icon styles */
        .svg-icon {
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .icon {
            width: 100%;
            height: 100%;
        }

        /* Toggle icon rotation */
        .sidebar-toggle .toggle-icon {
            transition: transform 0.2s ease;
        }

        .sidebar.collapsed .sidebar-toggle .toggle-icon {
            transform: scaleX(-1);
        }

        /* Menu groups */
        .menu-gap {
            height: 1rem;
            transition: height 0.2s ease;
        }

        .sidebar.collapsed .menu-gap {
            height: 0;
        }

        .nav-header {
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            color: #6b7280;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* Mobile Sidebar Styles */
        .mobile-sidebar {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100vh;
            background: white;
            border-right: 1px solid #eaecef;
            transition: all 0.3s ease;
            z-index: 1001;
            overflow-y: auto;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .mobile-sidebar.active {
            left: 0;
        }

        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* Header Styles */
        .content-header {
            background: white;
            border-bottom: 1px solid #eaecef;
            margin: -20px -20px 20px -20px;
            padding: 0 20px;
            height: 70px;
            display: flex;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .footer {
            background: white;
            border-top: 1px solid #eaecef;
            margin: 20px -20px 0px -20px;
            /* keep for border cropping */
            padding: 20px;
            /* enough height to center content visually */
            font-size: 14px;
            display: flex;
            justify-content: center;
            /* centers footer-content horizontally */

        }

        .footer-content {
            display: flex;
            align-items: center;
            /* vertical center content */
            justify-content: space-between;
            width: 100%;

            /* optional, keeps content aligned on large screens */
        }

        .footer-left,
        .footer-right {
            display: flex;
            align-items: center;
            /* vertical center children */
            gap: 15px;
        }

        .footer p,
        .footer a {
            margin: 0;
            /* remove default margins that break centering */
        }

        /* Responsive tweaks */
        @media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                gap: 10px;
                align-items: center;
                /* centers content on mobile */
            }

            .footer-left,
            .footer-right {
                justify-content: center;
            }
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 600;
            color: #181a20;
        }

        .brand-subtext {
            font-size: 14px;
            color: #6b7280;
        }

        .brand-logo {
            height: 20px;
            margin-left: 5px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(24, 26, 32, 0.05);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .header-item:hover {
            background: rgba(24, 26, 32, 0.1);
        }

        .header-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-text {
            font-size: 14px;
            font-weight: 500;
            color: #181a20;
        }

        .profile-dropdown {
            position: relative;
        }

        .profile-btn {
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .avatar {
            width: 36px;
            height: 36px;
            background: #181a20;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            width: auto;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            padding: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.3s ease;
            z-index: 101;
        }

        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-header {
            padding: 16px;
        }

        .user-info {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .user-details {
            flex: 1;
        }

        .user-name {
            font-weight: 600;
            color: #181a20;
            margin-bottom: 1px;
        }

        .user-email {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 2px;
        }

        .logout-link {
            font-size: 14px;
            color: #ef4444;
            text-decoration: underline;
        }

        .dropdown-divider {
            height: 1px;
            background: #e5e7eb;
            margin: 0;
        }

        .dropdown-item {
            display: block;
            padding: 8px 16px;
            color: #374151;
            text-decoration: none;
            transition: background-color 0.3s ease;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .animate-spin {
            animation: spin 2s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Mobile Hamburger */
        .mobile-hamburger {
            display: none;
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            color: #374151;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .mobile-hamburger:hover {
            background-color: #f3f4f6;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .mobile-hamburger {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .header-item {
                display: flex;
                /* ✅ Yeh line change karein */
                padding: 6px;
                /* ✅ Mobile ke liye padding adjust karein */
            }

            .header-item .header-text {
                display: none;
                /* ✅ Text hide karein, sirf icon dikhe */
            }

            .header-brand {
                display: none;
            }

            .brand-subtext {
                display: none;
            }

            .dropdown-menu {
                width: auto;
                right: -10px;
            }

            .header-left {
                gap: 0;
            }
        }

        @media (min-width: 769px) {

            .mobile-sidebar,
            .sidebar-overlay {
                display: none !important;
            }
        }

        /* Header Right Section - Responsive Behavior */
        @media (max-width: 1024px) {
            .header-item .header-text {
                display: none;
            }

            .header-item {
                padding: 8px;
            }
        }

        @media (max-width: 480px) {
            .header-right {
                gap: 8px;
            }
        }

        .card.card-border {
            border: 1px solid #eaeaea;
            box-shadow: none;
        }

        .card {
            border-color: #eaeaea;
            border-radius: .5rem;
            box-shadow: 0 2px 2px rgba(0, 0, 0, .1);
            margin-bottom: .875rem;
        }

        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 1px solid rgba(0, 0, 0, .125);
            border-radius: .25rem;
        }

        @media (max-width: 768px) {
            .mobile-card {
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                margin-bottom: 0.75rem;
                padding: 1rem;
                background: white;
            }

            .mobile-row {
                display: flex;
                justify-content: space-between;
                margin-bottom: 0.5rem;
                padding-bottom: 0.5rem;
                border-bottom: 1px solid #f3f4f6;
            }

            .mobile-row:last-child {
                border-bottom: none;
                margin-bottom: 0;
            }

            .mobile-label {
                font-weight: 600;
                color: #4b5563;
                min-width: 100px;
            }

            .mobile-value {
                text-align: right;
                flex: 1;
            }
        }

        /* --- Search filter / form styles added --- */
        .field-group {
            position: relative;
            transition: background 0.3s cubic-bezier(.4, 0, .2, 1), min-height 0.3s cubic-bezier(.4, 0, .2, 1);
            min-height: 56px;
        }

        .search-filter input[type="text"],
        .search-filter input[type="password"],
        .search-filter input[type="email"],
        .search-filter input[type="tel"],
        .search-filter input[type="number"],
        .search-filter select,
        .search-filter textarea {
            width: 100%;
            border-width: 1px;
            border-style: solid;
            border-color: var(--primary-transparent);
            border-radius: 12px;
            /* rounded-md */
            padding: .5rem .75rem;
            /* px-3 py-2 approx */
            margin-bottom: .5rem;
            color: #1f2937;
            /* text-gray-800 */
            background: white;
            transition: border-color 0.2s, box-shadow 0.2s, all 0.2s;
        }

        .search-filter ::placeholder {
            color: #6b7280;
            /* placeholder-gray-500 */
        }

        .search-filter input[type="text"]:focus,
        .search-filter input[type="password"]:focus,
        .search-filter input[type="email"]:focus,
        .search-filter input[type="tel"]:focus,
        .search-filter input[type="number"]:focus,
        .search-filter select:focus,
        .search-filter textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 6px rgba(24, 26, 32, 0.06);
        }

        /* Make date inputs and select boxes match the height of other inputs */
        .search-filter input[type="date"],
        .search-filter select {
            height: 44px;
            /* align with other inputs' visual height */
            padding: .5rem .75rem;
            line-height: 1.2;
            display: block;
            box-sizing: border-box;
        }

        /* remove native select arrow styling differences on some browsers */
        .search-filter select {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
            background-position: calc(100% - 14px) calc(1em + 2px), calc(100% - 10px) calc(1em + 2px);
            background-size: 6px 6px, 6px 6px;
            background-repeat: no-repeat;
            background-color: white;
            padding-right: 2.25rem;
            /* room for arrow */
        }

        .btn-theme {
            background-color: var(--primary);
            color: var(--light-1);
            border: 1px solid var(--primary-dark);
            padding: .5rem .75rem;
            border-radius: 12px;
            cursor: pointer;
        }

        .btn-theme:hover {
            background-color: var(--primary-light);
            color: var(--light-1);
        }

        .btn-theme:active {
            background-color: var(--primary-dark);
        }

        .btn-outline-theme {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
            padding: .5rem .75rem;
            border-radius: 12px;
            cursor: pointer;
        }

        .btn-outline-theme:hover {
            background-color: rgba(24, 26, 32, 0.06);
            color: var(--primary-dark);
        }


        /* From Uiverse.io by dovatgabriel */
        .three-body {
            --uib-size: 35px;
            --uib-speed: 0.8s;
            --uib-color: var(--dark-2);
            position: relative;
            display: inline-block;
            height: var(--uib-size);
            width: var(--uib-size);
            animation: spin78236 calc(var(--uib-speed) * 2.5) infinite linear;
        }

        .three-body__dot {
            position: absolute;
            height: 100%;
            width: 30%;
        }

        .three-body__dot:after {
            content: '';
            position: absolute;
            height: 0%;
            width: 100%;
            padding-bottom: 100%;
            background-color: var(--uib-color);
            border-radius: 50%;
        }

        .three-body__dot:nth-child(1) {
            bottom: 5%;
            left: 0;
            transform: rotate(60deg);
            transform-origin: 50% 85%;
        }

        .three-body__dot:nth-child(1)::after {
            bottom: 0;
            left: 0;
            animation: wobble1 var(--uib-speed) infinite ease-in-out;
            animation-delay: calc(var(--uib-speed) * -0.3);
        }

        .three-body__dot:nth-child(2) {
            bottom: 5%;
            right: 0;
            transform: rotate(-60deg);
            transform-origin: 50% 85%;
        }

        .three-body__dot:nth-child(2)::after {
            bottom: 0;
            left: 0;
            animation: wobble1 var(--uib-speed) infinite calc(var(--uib-speed) * -0.15) ease-in-out;
        }

        .three-body__dot:nth-child(3) {
            bottom: -5%;
            left: 0;
            transform: translateX(116.666%);
        }

        .three-body__dot:nth-child(3)::after {
            top: 0;
            left: 0;
            animation: wobble2 var(--uib-speed) infinite ease-in-out;
        }

        @keyframes spin78236 {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @keyframes wobble1 {

            0%,
            100% {
                transform: translateY(0%) scale(1);
                opacity: 1;
            }

            50% {
                transform: translateY(-66%) scale(0.65);
                opacity: 0.8;
            }
        }

        @keyframes wobble2 {

            0%,
            100% {
                transform: translateY(0%) scale(1);
                opacity: 1;
            }

            50% {
                transform: translateY(66%) scale(0.65);
                opacity: 0.8;
            }
        }
    </style>

</head>

<body>
    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Mobile Sidebar -->
