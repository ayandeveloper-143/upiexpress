            function loadWalletHistory(list) {
                const desktop = document.getElementById("walletHistoryTable");
                const mobile = document.getElementById("walletHistoryMobile");
                const noHistory = document.getElementById("noHistoryBox");

                if (!list || list.length === 0) {
                    desktop.innerHTML = "";
                    mobile.innerHTML = "";
                    noHistory.classList.remove("hidden");
                    return;
                }

                noHistory.classList.add("hidden");

                // DESKTOP RENDER
                desktop.innerHTML = list.map(item => `
            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="py-3 px-4 pl-6 text-gray-900 font-medium">${item.id}</td>
                <td class="py-3 px-4">
