                    </span>
                </div>
                <div class="mobile-row">
                    <span class="mobile-label">Date</span>
                    <span class="mobile-value text-gray-600 text-sm">${item.date}</span>
                </div>
                <div class="mobile-row">
                    <span class="mobile-label">Description</span>
                    <span class="mobile-value text-gray-700">${item.description}</span>
                </div>
            </div>
        `).join('');
            }

            document.addEventListener('DOMContentLoaded', function () {
                loadWalletHistory(walletHistoryData);
            });
