        <!-- Deposit section behaviour (no popup) -->
        <script type="module">
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebar');
            const profileDropdown = document.getElementById('profileDropdown');
            const dropdownMenu = document.getElementById('dropdownMenu');
            const mobileHamburger = document.getElementById('mobileHamburger');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileSidebarClose = document.getElementById('mobileSidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            let hoverEnabled = false;
            let isCollapsed = false;

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }

            if (mobileHamburger && mobileSidebar && sidebarOverlay) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            if (mobileSidebarClose && mobileSidebar && sidebarOverlay) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            if (sidebarOverlay && mobileSidebar) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            const mobileMenuItems = document.querySelectorAll('.mobile-sidebar .menu-item');
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });

            // Wallet deposit behaviour
            const openDepositBtn = document.getElementById('openDepositSection');
            const depositSection = document.getElementById('depositSection');
            const closeDepositBtn = document.getElementById('closeDepositSection');
            const amountInput = document.getElementById('depositAmount');
            const payBtn = document.getElementById('depositPayButton');
            const payAmountLabel = document.getElementById('payAmountLabel');
            const termsAgreement = document.getElementById('termsAgreement');

            function updatePayState() {
                if (!amountInput || !payBtn || !termsAgreement || !payAmountLabel) return;

                const amount = parseFloat(amountInput.value || '0');
                const isValidAmount = !isNaN(amount) && amount >= 50;
                const isAgreed = termsAgreement.checked;

                const enabled = isValidAmount && isAgreed;

                payBtn.disabled = !enabled;
                payBtn.classList.toggle('opacity-60', !enabled);
                payBtn.classList.toggle('cursor-not-allowed', !enabled);

                payAmountLabel.textContent = isValidAmount ? amount.toFixed(2) : '0.00';
            }

            if (openDepositBtn && depositSection) {
                openDepositBtn.addEventListener('click', () => {
                    depositSection.classList.remove('hidden');
                    if (amountInput) {
                        amountInput.focus();
                    }
                    depositSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }

            if (closeDepositBtn && depositSection && amountInput && termsAgreement) {
                closeDepositBtn.addEventListener('click', () => {
                    depositSection.classList.add('hidden');
                    amountInput.value = '';
                    termsAgreement.checked = false;
                    updatePayState();
                });
            }

            if (amountInput) {
                amountInput.addEventListener('input', updatePayState);
            }
            if (termsAgreement) {
                termsAgreement.addEventListener('change', updatePayState);
            }

            // Deposit payment button click handler
            if (payBtn) {
                payBtn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    const amount = parseFloat(amountInput.value);

                    if (isNaN(amount) || amount < 50) {
                        alert('Please enter a valid amount (minimum ₹50)');
                        return;
                    }

                    if (!termsAgreement.checked) {
                        alert('Please agree to the terms and conditions');
                        return;
                    }

                    try {
                        // Show loading
                        if (document.getElementById('loading')) {
                            document.getElementById('loading').classList.remove('hidden');
                        }

                        const csrfToken = "<%= csrfToken %>";

                        // Call wallet deposit API
                        const response = await fetch('/api/user/wallet/deposit', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'CSRF-Token': csrfToken
                            },
                            body: JSON.stringify({
                                amount: amount
                            })
                        });

                        // Hide loading
                        if (document.getElementById('loading')) {
                            document.getElementById('loading').classList.add('hidden');
                        }

                        const data = await response.json();

                        if (data.status || data.data?.payment_link) {
                            // Redirect to payment page
                            window.location.href = data.data.payment_link;
                        } else {
                            alert('Error: ' + (data.message || 'Failed to create payment link'));
                        }
                    } catch (error) {
                        console.error('Error processing deposit:', error);
                        alert('Error: ' + error.message);

                        // Hide loading
                        if (document.getElementById('loading')) {
                            document.getElementById('loading').classList.add('hidden');
                        }
                    }
                });
            }

            updatePayState();
        </script>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-content">
                <div class="footer-left">
                    <p class="text-gray-600">&copy; 2025 UPI Express. All rights reserved.</p>
                </div>
                <div class="footer-right">

                    <a href="/terms" class="footer-link text-[var(--primary)]">Terms of Service</a>
                    <a href="/privacy" class="footer-link text-[var(--primary)]">Privacy Policy</a>
                    <a href="/contact-us" class="footer-link text-[var(--primary)]">Contact Us</a>
                </div>
            </div>

        </div>
        <script type="module">


            // Desktop sidebar toggle
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    isCollapsed = !isCollapsed;

                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        sidebar.classList.remove('hover-enabled');

                        setTimeout(() => {
                            sidebar.classList.add('hover-enabled');
                            hoverEnabled = true;
                        }, 1000);

                    } else {
                        sidebar.classList.remove('collapsed');
                        sidebar.classList.remove('hover-enabled');
                        hoverEnabled = false;
                    }
                });
            }


            // Mobile sidebar toggle
            if (mobileHamburger) {
                mobileHamburger.addEventListener('click', function () {
                    mobileSidebar.classList.add('active');
                    sidebarOverlay.classList.add('active');
                });
            }

            // Close mobile sidebar
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Profile dropdown functionality
            if (profileDropdown && dropdownMenu) {
                profileDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                });

                document.addEventListener('click', function () {
                    dropdownMenu.classList.remove('show');
                });

                dropdownMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }

            // Close mobile sidebar when clicking menu items

            mobileMenuItems.forEach(item => {
                item.addEventListener('click', function () {
                    mobileSidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            });


        </script>
</body>

</html>