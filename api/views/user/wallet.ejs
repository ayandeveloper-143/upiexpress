                        </span>
                    </span>
                </div>
                <div class="mobile-row">
                    <span class="mobile-label">Amount</span>
                    <span class="mobile-value font-medium text-black">
                        ${item.amount}
                    </span>
                </div>
                <div class="mobile-row">
