<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - UPIExpress</title>
</head>

<body
    style="margin: 0; padding: 20px 0; font-family: Arial, sans-serif; line-height: 1.6; color: #333333; background-color: #f9fafb;">
    <!-- Email Container -->
    <div
        style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);">

        <!-- Header -->
        <div
            style="background-color: #f8fafc; border-bottom: 1px solid #e5e7eb; padding: 24px 20px; text-align: center;">
            <img src="https://upiexpress.com/assets/images/icon.png" alt="UPIExpress"
                style="max-width: 160px; height: auto;">
        </div>

        <!-- Body -->
        <div style="padding: 32px 24px;">
            <h1 style="font-size: 24px; font-weight: 700; color: #181a20; margin-bottom: 16px; text-align: center;">
                Reset Your Password</h1>
            <p style="font-size: 16px; color: #6b7280; margin-bottom: 24px; text-align: center;">Click the button below
                to reset your password</p>

            <!-- Reset Button Container -->
            <div
                style="background-color: #f8fafc; border-radius: 8px; padding: 20px; margin: 24px 0; text-align: center; border: 1px solid #e5e7eb;">
                <p style="margin: 0 0 16px 0;">Click the button below to reset your password:</p>
                <a href="<%= resetLink %>"
                    style="display: inline-block; background-color: #181a20; color: #ffffff; padding: 12px 24px; font-size: 16px; font-weight: 600; text-decoration: none; border-radius: 6px; margin: 16px 0;">
                    Reset Password
                </a>
                <p style="color: #ef4444; font-weight: 500; margin-top: 16px; margin-bottom: 0;">This link will expire
                    in 15 minutes</p>
            </div>

            <!-- Security Notice -->
            <div
                style="background-color: #f0f9ff; border-left: 4px solid #0ea5e9; padding: 16px; margin: 24px 0; border-radius: 0 4px 4px 0;">
                <p style="font-weight: 600; margin-bottom: 8px; color: #0369a1; margin-top: 0;">Security Notice</p>
                <p style="margin-bottom: 0;">For your security, please do not share this link with anyone. UPIExpress
                    will never ask for your password or reset link via phone, email, or SMS.</p>
            </div>

            <p style="margin-bottom: 0;">If you did not request a password reset, please ignore this email or contact
                our support team immediately.</p>
        </div>

        <!-- Footer -->
        <div
            style="background-color: #f9fafb; padding: 24px; text-align: center; border-top: 1px solid #e5e7eb; font-size: 14px; color: #6b7280;">
            <p style="margin: 0 0 16px 0;">© UPIExpress 2020–25, All Rights Reserved.</p>

            <div style="margin-top: 16px;">
                <a href="https://upiexpress.com/help"
                    style="color: #6b7280; text-decoration: none; margin: 0 8px;">Help</a>
                <a href="https://upiexpress.com/privacy"
                    style="color: #6b7280; text-decoration: none; margin: 0 8px;">Privacy Policy</a>
                <a href="https://upiexpress.com/terms"
                    style="color: #6b7280; text-decoration: none; margin: 0 8px;">Terms of Service</a>
            </div>

            <div style="margin-top: 16px;">
                <p style="margin: 0;">Need help? <a href="mailto:support@upiexpress.com"
                        style="color: #181a20; font-weight: 500; text-decoration: none;">Contact our support team</a>
                </p>
            </div>
        </div>
    </div>
</body>

</html>