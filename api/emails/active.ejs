<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Plan is Active - UPI Express</title>
</head>

<body
    style="margin:0; padding:20px 0; font-family:Arial, sans-serif; line-height:1.6; color:#333; background-color:#f9fafb;">
    <div
        style="max-width:600px; margin:0 auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 4px 6px rgba(0,0,0,0.05);">
        <!-- Header -->
        <div style="background:#f8fafc; border-bottom:1px solid #e5e7eb; padding:24px 20px; text-align:center;">
            <img src="https://upiexpress.com/assets/images/icon.png" alt="UPI Express"
                style="max-width:160px; height:auto;">
        </div>

        <!-- Body -->
        <div style="padding:32px 24px;">
            <h1 style="font-size:22px; font-weight:700; color:#181a20; margin:0 0 12px; text-align:center;">Plan
                Activated Successfully</h1>
            <p style="font-size:15px; color:#6b7280; margin:0 0 20px; text-align:center;">Your UPI Express plan is now
                active. Below are your plan details.</p>

            <div style="background:#f8fafc; border-radius:8px; padding:18px; margin:16px 0; border:1px solid #e5e7eb;">
                <p style="margin:0 0 8px; font-weight:600; color:#111;">Hello, <span style="font-weight:700;">
                        <%= UserName %>
                    </span></p>
                <p style="margin:6px 0;"><strong>Plan:</strong>
                    <%= PlanName %>
                </p>
                <p style="margin:6px 0;"><strong>Validity:</strong>
                    <%= StartDate %> — <%= EndDate %>
                </p>
                <p style="margin:6px 0;"><strong>QR Request Limit:</strong>
                    <%= QRLimit %>
                </p>
            </div>

            <div style="text-align:center; margin-top:12px;">
                <a href="{DashboardURL}"
                    style="display:inline-block; background:#007bff; color:#fff; padding:12px 22px; text-decoration:none; border-radius:6px; font-weight:600;">Go
                    to Dashboard</a>
            </div>

            <p style="margin:20px 0 0; color:#6b7280; font-size:14px; text-align:center;">Thank you for choosing
                <strong>UPI Express</strong>. Our support is available 24/7 on WhatsApp.
            </p>
        </div>

        <!-- Footer -->
        <div
            style="background:#f9fafb; padding:20px; text-align:center; border-top:1px solid #e5e7eb; font-size:13px; color:#6b7280;">
            <p style="margin:0 0 8px;">© UPI Express 2020–25, All Rights Reserved.</p>
            <div style="margin-top:6px;">
                <a href="https://upiexpress.com/help"
                    style="color:#6b7280; text-decoration:none; margin:0 8px;">Help</a>
                <a href="https://upiexpress.com/privacy"
                    style="color:#6b7280; text-decoration:none; margin:0 8px;">Privacy Policy</a>
                <a href="https://upiexpress.com/terms"
                    style="color:#6b7280; text-decoration:none; margin:0 8px;">Terms</a>
            </div>
            <p style="margin:12px 0 0;">Need help? <a href="mailto:support@upiexpress.com"
                    style="color:#181a20; font-weight:600; text-decoration:none;">Contact Support</a></p>
        </div>
    </div>
</body>

</html>